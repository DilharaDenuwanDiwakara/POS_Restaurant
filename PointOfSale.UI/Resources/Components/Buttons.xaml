        TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource BrandBrush}" />
        <Setter Property="ToolTip" Value="Edit" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Path Data="{StaticResource Icon.Action.Edit}" Style="{StaticResource DataGridActionIconStyle}" />
                </DataTemplate>
            </Setter.Value>
