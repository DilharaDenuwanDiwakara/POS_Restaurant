        <Setter Property="Content" Value=" " />
    </Style>

    <Style
        x:Key="DeleteButtonStyle"
        BasedOn="{StaticResource DataGridFlatActionButtonStyle}"
        TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        <Setter Property="ToolTip" Value="Delete" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Path Data="{StaticResource Icon.Action.Delete}" Style="{StaticResource DataGridActionIconStyle}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Content" Value=" " />
    </Style>

    <Style
        x:Key="DataGridPrintButtonStyle"
        BasedOn="{StaticResource DataGridFlatActionButtonStyle}"
        TargetType="Button">
        <Setter Property="ToolTip" Value="Print" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Path Data="{StaticResource Icon.Action.Print}" Style="{StaticResource DataGridActionIconStyle}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Content" Value=" " />
    </Style>

    <Style
        x:Key="PriceButtonStyle"
        BasedOn="{StaticResource DataGridFlatActionButtonStyle}"
        TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
        <Setter Property="ToolTip" Value="Update price" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Path Data="{StaticResource Icon.Action.Price}" Style="{StaticResource DataGridActionIconStyle}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Content" Value=" " />
    </Style>

    <Style
        x:Key="SearchButtonStyle"
        BasedOn="{StaticResource IconOnlyButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrandBrush}" />
        <Setter Property="ToolTip" Value="Search" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Path Data="{StaticResource Icon.Action.Search}" Style="{StaticResource Style.Icon.Base}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Content" Value=" " />
    </Style>

    <Style
        x:Key="ExportExcelButtonStyle"
        BasedOn="{StaticResource BaseButtonStyle}"
        TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
        <Setter Property="Width" Value="140" />
        <Setter Property="ToolTip" Value="Export data to Excel (.xlsx)" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Path
                            Width="16"
                            Height="16"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Data="{StaticResource Icon.Action.Excel}"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Stretch="Uniform" />

                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="Medium"
                            Text="{TemplateBinding Content}" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
