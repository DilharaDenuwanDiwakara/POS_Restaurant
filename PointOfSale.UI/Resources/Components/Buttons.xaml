<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="BaseButtonStyle" TargetType="Button">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.OnDark}"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" 
                                             Path="Background" 
                                             Converter="{StaticResource ColorShadeConverter}" 
                                             ConverterParameter="0.3"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background">
                                <Setter.Value>
                                    <Binding RelativeSource="{RelativeSource TemplatedParent}" 
                                             Path="Background" 
                                             Converter="{StaticResource ColorShadeConverter}" 
                                             ConverterParameter="-0.3"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                        
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary Button -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="{StaticResource BrandBrush}"/>
        <Setter Property="Width" Value="120"/>
    </Style>

    <!-- Secondary Button -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
        <Setter Property="Width" Value="120"/>
    </Style>

    <!-- Success Button -->
    <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
        <Setter Property="Width" Value="120"/>
    </Style>

    <!-- Danger Button -->
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        <Setter Property="Width" Value="120"/>
    </Style>


    <!-- ============================================================ -->
    <!-- SPECIFIC ACTION BUTTONS -->
    <!-- ============================================================ -->
    
    <Style x:Key="IconOnlyButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="{StaticResource BrandBrush}"/>
    </Style>

    <Style x:Key="RefreshButtonStyle" TargetType="Button" BasedOn="{StaticResource IconOnlyButtonStyle}">
        <Setter Property="Background" Value="{StaticResource BrandBrush}"/>
        <Setter Property="ToolTip" Value="Refresh"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Path Data="{StaticResource Icon.Action.Refresh}" 
                          Style="{StaticResource Style.Icon.Base}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Content" Value=" "/>
    </Style>

    <Style x:Key="AddButtonStyle" TargetType="Button" BasedOn="{StaticResource IconOnlyButtonStyle}">
        <Setter Property="Background" Value="{StaticResource BrandBrush}"/>
        <Setter Property="ToolTip" Value="Refresh"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Path Data="{StaticResource Icon.Action.Add}" 
                      Style="{StaticResource Style.Icon.Base}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Content" Value=" "/>
    </Style>

    <Style x:Key="EditButtonStyle" TargetType="Button" BasedOn="{StaticResource IconOnlyButtonStyle}">
        <Setter Property="Background" Value="{StaticResource SecondaryBrush}"/>
        <Setter Property="ToolTip" Value="Edit"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Path Data="{StaticResource Icon.Action.Edit}"
                          Style="{StaticResource Style.Icon.Base}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Content" Value=" "/>
    </Style>

    <Style x:Key="DeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource IconOnlyButtonStyle}">
        <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        <Setter Property="ToolTip" Value="Delete"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Path Data="{StaticResource Icon.Action.Delete}" 
                      Style="{StaticResource Style.Icon.Base}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Content" Value=" "/>
    </Style>

    <Style x:Key="PriceButtonStyle" TargetType="Button" BasedOn="{StaticResource IconOnlyButtonStyle}">
        <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
        <Setter Property="ToolTip" Value="Update price"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Path Data="{StaticResource Icon.Action.Price}"
                          Style="{StaticResource Style.Icon.Base}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Content" Value=" "/>
    </Style>

    <Style x:Key="SearchButtonStyle" TargetType="Button" BasedOn="{StaticResource IconOnlyButtonStyle}">
        <Setter Property="Background" Value="{StaticResource BrandBrush}"/>
        <Setter Property="ToolTip" Value="Search"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Path Data="{StaticResource Icon.Action.Search}" 
                          Style="{StaticResource Style.Icon.Base}"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Content" Value=" "/>
    </Style>

    <Style x:Key="ExportExcelButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
        <Setter Property="Width" Value="140"/>
        <Setter Property="ToolTip" Value="Export data to Excel (.xlsx)"/>
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Path Data="{StaticResource Icon.Action.Excel}" 
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                          Width="16" Height="16" 
                          Stretch="Uniform" 
                          Margin="0,0,8,0"
                          VerticalAlignment="Center"/>

                        <TextBlock Text="{TemplateBinding Content}" 
                               VerticalAlignment="Center" 
                               FontSize="14" 
                               FontWeight="Medium"/>
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
