    <!-- Sales/SalesReturnView.xaml -->
    <Style x:Key="TouchDataGridRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource Style.DataGrid.Row}">
        <Setter Property="Height" Value="64"/>
        <Setter Property="MinHeight" Value="64"/>
    </Style>

    <!-- Sales/SalesReturnView.xaml -->
    <Style x:Key="ReadOnlyCellTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <!-- Sales/SalesReturnView.xaml -->
    <Style x:Key="TouchComboBoxItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItemStyle}">
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="MinHeight" Value="44"/>
    </Style>

    <!-- Sales/SalesView.xaml -->
    <Style x:Key="BottomActionButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="58" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        Background="{TemplateBinding Background}"
                        CornerRadius="8"
                        SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.92" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.84" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Security/Dialogs/DeviceRegistrationWindow.xaml -->
    <Style x:Key="LinkButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource BrandBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Accounts/AccountInquiryView.xaml -->
    <Style x:Key="Style.View.AccountInquiryView.WrapPanel.01" TargetType="WrapPanel">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                <Setter Property="IsEnabled" Value="False" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsLoadingAccounts}" Value="True">
                <Setter Property="IsEnabled" Value="False" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Accounts/AccountInquiryView.xaml -->
    <Style x:Key="Style.View.AccountInquiryView.TextBlock.01" TargetType="TextBlock">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedAccount}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Accounts/AccountInquiryView.xaml -->
    <Style x:Key="Style.View.AccountInquiryView.Button.01" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding ElementName=FromDateInput, Path=(Validation.HasError)}" Value="True">
                <Setter Property="IsEnabled" Value="False" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ElementName=ToDateInput, Path=(Validation.HasError)}" Value="True">
                <Setter Property="IsEnabled" Value="False" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ElementName=FromDateInput, Path=SelectedDate}" Value="{x:Null}">
                <Setter Property="IsEnabled" Value="False" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ElementName=ToDateInput, Path=SelectedDate}" Value="{x:Null}">
                <Setter Property="IsEnabled" Value="False" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Accounts/AccountInquiryView.xaml -->
    <Style x:Key="Style.View.AccountInquiryView.Border.01" TargetType="Border">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding TransactionLines.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            <DataTrigger Binding="{Binding IsLoading}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Accounts/AccountInquiryView.xaml -->
    <Style x:Key="Style.View.AccountInquiryView.TextBlock.02" TargetType="TextBlock" BasedOn="{StaticResource SubHeaderTextStyle}">
        <Setter Property="Text" Value="Generate an account inquiry" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasReport}" Value="True"><Setter Property="Text" Value="No transactions in this period" /></DataTrigger>
            <DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Text" Value="Report unavailable" /></DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Accounts/AccountInquiryView.xaml -->
    <Style x:Key="Style.View.AccountInquiryView.TextBlock.03" TargetType="TextBlock" BasedOn="{StaticResource Inquiry.Caption}">
        <Setter Property="Text" Value="Select an account, choose a date range, and select Generate report to view ledger activity." />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasReport}" Value="True"><Setter Property="Text" Value="There are no ledger entries for these dates. Opening and closing balances are shown above." /></DataTrigger>
            <DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Text" Value="Review the message above, check your filters, and generate the report again." /></DataTrigger>
        </Style.Triggers>
    </Style>

