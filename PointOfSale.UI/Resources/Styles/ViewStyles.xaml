<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:enums="clr-namespace:PointOfSale.Core.Enums;assembly=PointOfSale.Core">

    <!-- Accounts/AccountInquiryView.xaml -->
    <Style x:Key="Inquiry.Caption" TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
        <Setter Property="FontStyle" Value="Normal" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Accounts/AccountInquiryView.xaml -->
    <Style x:Key="Inquiry.BalanceCard" TargetType="Border" BasedOn="{StaticResource PanelCardStyle}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="16,12" />
    </Style>

    <!-- Accounts/AccountInquiryView.xaml -->
    <Style x:Key="Inquiry.Amount" TargetType="TextBlock" BasedOn="{StaticResource HeaderTextStyle}">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
    </Style>

    <!-- Accounts/AccountInquiryView.xaml -->
    <Style x:Key="Inquiry.Header" TargetType="DataGridColumnHeader" BasedOn="{StaticResource Style.DataGrid.ColumnHeader}">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <!-- Accounts/AccountInquiryView.xaml -->
    <Style x:Key="Inquiry.Cell" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
    </Style>

    <!-- Accounts/AccountInquiryView.xaml -->
    <Style x:Key="Inquiry.Number" TargetType="TextBlock" BasedOn="{StaticResource Inquiry.Cell}">
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- Accounts/AccountInquiryView.xaml -->
    <Style x:Key="Inquiry.AccountItem" TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItemStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Margin" Value="{Binding Depth, Converter={StaticResource LevelToMarginConverter}}" />
        <Setter Property="ToolTip" Value="{Binding ToolTip}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsGroupHeading}" Value="True">
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{StaticResource BrandBrush}" />
                <Setter Property="Background" Value="{StaticResource Brush.App.Background}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Inventory/InternalIssueView.xaml -->
    <Style x:Key="ItemCategoryRadioStyle" TargetType="RadioButton">
        <Setter Property="MinWidth" Value="132"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Foreground" Value="#334155"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="SegmentBorder"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SegmentBorder" Property="Background" Value="#EEF2F7"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SegmentBorder" Property="Background" Value="#FFFFFF"/>
                            <Setter TargetName="SegmentBorder" Property="BorderBrush" Value="#C9D8E8"/>
                            <Setter Property="Foreground" Value="#0F4C81"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inventory/ProductView.xaml -->
    <Style x:Key="UnitConversionPanelStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="#D8DEE8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Background" Value="#F8FAFC"/>
        <Setter Property="Margin" Value="0,4,0,14"/>
    </Style>

    <!-- Inventory/ProductView.xaml -->
    <Style x:Key="UnitConversionCardStyle" TargetType="Border">
        <Setter Property="Background" Value="#E9EEF6"/>
        <Setter Property="BorderBrush" Value="#C7D4EA"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- Inventory/ProductView.xaml -->
    <Style x:Key="UnitConversionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Purchasing/GoodsPurchaseNoteView.xaml -->
    <Style x:Key="PurchaseOrderHistoryFullTextCellStyle" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="TextTrimming" Value="None"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Purchasing/GoodsPurchaseNoteView.xaml -->
    <Style x:Key="PurchaseOrderHistoryRightAlignedCellStyle" TargetType="TextBlock" BasedOn="{StaticResource PurchaseOrderHistoryFullTextCellStyle}">
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <!-- Purchasing/GoodsReceiveNoteApprovalView.xaml -->
    <Style x:Key="DiscrepancyAwareDataGridRowStyle"
           TargetType="{x:Type DataGridRow}"
           BasedOn="{StaticResource Style.DataGrid.Row}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasQuantityDiscrepancy}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource StatusPartiallyReceivedForegroundBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Purchasing/GoodsReceiveNoteView.xaml -->
    <Style x:Key="GrnHistoryFullTextCellStyle" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="TextTrimming" Value="None"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Purchasing/GoodsReceiveNoteView.xaml -->
    <Style x:Key="GrnHistoryRightAlignedCellStyle" TargetType="TextBlock" BasedOn="{StaticResource GrnHistoryFullTextCellStyle}">
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <!-- Purchasing/SupplierReturnView.xaml -->
    <Style x:Key="SupplierReturnHistoryFullTextCellStyle" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="TextTrimming" Value="None"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Purchasing/SupplierReturnView.xaml -->
    <Style x:Key="SupplierReturnHistoryRightAlignedCellStyle" TargetType="TextBlock" BasedOn="{StaticResource SupplierReturnHistoryFullTextCellStyle}">
        <Setter Property="HorizontalAlignment" Value="Right"/>
