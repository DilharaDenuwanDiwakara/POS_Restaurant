<UserControl
    x:Class="PointOfSale.UI.Views.Sales.SalesListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PointOfSale.UI.Views.Sales"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource HeaderTextStyle}" Text="Sales History" />

        <Border
            Grid.Row="1"
            Margin="0"
            Style="{StaticResource PanelCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Padding="12,8" Background="#F1F2F6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            Margin="0,0,12,8"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource LabelStyle}"
                                Text="From:" />
                            <DatePicker
                                Width="150"
                                Margin="0,0,12,0"
                                SelectedDate="{Binding FromDate}"
                                Style="{StaticResource DatePickerStyle}" />

                            <TextBlock
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource LabelStyle}"
                                Text="To:" />
                            <DatePicker
                                Width="150"
                                Margin="0"
                                SelectedDate="{Binding ToDate}"
                                Style="{StaticResource DatePickerStyle}" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            Margin="0,0,8,8"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource LabelStyle}"
                                Text="Type:" />
                            <ComboBox
                                Width="100"
                                Margin="0"
                                ItemsSource="{Binding PaymentTypes}"
                                SelectedItem="{Binding SelectedPaymentType}"
                                Style="{StaticResource ComboBoxStyle}" />
                        </StackPanel>

                        <Button
                            Grid.Column="2"
                            Margin="12,0,0,8"
                            VerticalAlignment="Center"
                            Command="{Binding SearchCommand}"
                            Style="{StaticResource SearchButtonStyle}"
                            ToolTip="Search Sales" />
                    </Grid>
                </Border>

                <DataGrid
                    x:Name="InvoicesDataGrid"
                    Grid.Row="1"
                    Margin="0,4"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    HorizontalScrollBarVisibility="Auto"
                    IsReadOnly="True"
                    ItemsSource="{Binding SalesList}"
                    RowDetailsVisibilityMode="Visible"
                    SelectionMode="Single"
                    Style="{StaticResource DataGridStyle}"
                    VerticalScrollBarVisibility="Auto">

                    <DataGrid.RowStyle>
                        <StaticResource ResourceKey="Style.View.Shared.DataGridRow.01" />
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="44">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ToggleButton
                                        Width="28"
                                        Height="28"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding IsExpanded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="Expand invoice">
                                        <ToggleButton.Style>
                                            <StaticResource ResourceKey="Style.View.SalesListView.ToggleButton.01" />
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn
                            Width="140"
                            Binding="{Binding Date, StringFormat='dd/MM/yyyy HH:mm'}"
                            Header="Date" />
                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding InvoiceNo}"
                            Header="Invoice No" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding CustomerName}"
                            Header="Customer" />

                        <DataGridTextColumn
                            Width="110"
                            Binding="{Binding SubTotal, StringFormat='Rs. {0:N2}'}"
                            ElementStyle="{StaticResource RightAlignedTextStyle}"
                            FontWeight="Bold"
                            Header="Sub Total"
                            HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}" />
                        <DataGridTextColumn
                            Width="110"
                            Binding="{Binding Discount, StringFormat='Rs. {0:N2}'}"
                            ElementStyle="{StaticResource RightAlignedTextStyle}"
                            FontWeight="Bold"
                            Header="Discount"
                            HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}" />
                        <DataGridTextColumn
                            Width="110"
                            Binding="{Binding TaxAmount, StringFormat='Rs. {0:N2}'}"
                            ElementStyle="{StaticResource RightAlignedTextStyle}"
                            FontWeight="Bold"
                            Header="Tax Amount"
                            HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}" />
                        <DataGridTextColumn
                            Width="110"
                            Binding="{Binding NetAmount, StringFormat='Rs. {0:N2}'}"
                            ElementStyle="{StaticResource RightAlignedTextStyle}"
                            FontWeight="Bold"
                            Header="Net Amount"
                            HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}" />

                        <DataGridTextColumn
                            Width="130"
                            Binding="{Binding PaymentMethod}"
                            Header="Payment Method" />

                        <DataGridTemplateColumn Width="56" Header="Action">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button
                                        Command="{Binding DataContext.ReprintInvoiceCommand, ElementName=InvoicesDataGrid}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource DataGridPrintButtonStyle}"
                                        ToolTip="Reprint bill" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <Border
                                Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                Margin="0,12,0,12"
                                Padding="40,0,12,0"
                                HorizontalAlignment="Stretch"
                                Background="#F4F6F8"
                                BorderBrush="#D8DEE6"
                                BorderThickness="0,1,0,1"
                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <TextBlock
                                        Margin="4,0,0,8"
                                        Foreground="#64748B"
                                        Text="Loading invoice items...">
                                        <TextBlock.Style>
                                            <StaticResource ResourceKey="Style.View.Shared.TextBlock.03" />
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Border Margin="0,22,0,0" HorizontalAlignment="Stretch">
                                        <DataGrid
                                            MinHeight="78"
                                            HorizontalAlignment="Stretch"
                                            AutoGenerateColumns="False"
                                            CanUserAddRows="False"
                                            HeadersVisibility="Column"
                                            HorizontalScrollBarVisibility="Disabled"
                                            IsReadOnly="True"
                                            ItemsSource="{Binding LineItems}"
                                            Style="{StaticResource DataGridStyle}"
                                            VerticalScrollBarVisibility="Disabled">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn
                                                    Width="*"
                                                    Binding="{Binding ItemName}"
                                                    Header="Item Name" />

                                                <DataGridTextColumn
                                                    Width="80"
                                                    Binding="{Binding Qty, StringFormat=N2}"
                                                    ElementStyle="{StaticResource RightAlignedTextStyle}"
                                                    Header="Qty" />
                                                <DataGridTextColumn
                                                    Width="80"
                                                    Binding="{Binding Discount, StringFormat=N2}"
                                                    ElementStyle="{StaticResource RightAlignedTextStyle}"
                                                    Header="Discount" />
                                                <DataGridTextColumn
                                                    Width="80"
                                                    Binding="{Binding TaxAmount, StringFormat=N2}"
                                                    ElementStyle="{StaticResource RightAlignedTextStyle}"
                                                    Header="Tax Amount" />

                                                <DataGridTextColumn
                                                    Width="120"
                                                    Binding="{Binding UnitPrice, StringFormat='Rs. {0:N2}'}"
                                                    ElementStyle="{StaticResource RightAlignedTextStyle}"
                                                    Header="Unit Price"
                                                    HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}" />

                                                <DataGridTextColumn
                                                    Width="120"
                                                    Binding="{Binding Total, StringFormat='Rs. {0:N2}'}"
                                                    ElementStyle="{StaticResource RightAlignedTextStyle}"
                                                    Header="Total"
                                                    HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                </DataGrid>

                <Border
                    Grid.Row="2"
                    Margin="0"
                    Style="{StaticResource PanelCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Total Invoices: " />
                            <TextBlock
                                Margin="4,0,0,0"
                                FontWeight="Bold"
                                Style="{StaticResource LabelStyle}"
                                Text="{Binding SalesList.Count}" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Total Revenue: " />
                            <TextBlock
                                Margin="4,0,10,0"
                                FontWeight="Bold"
                                Foreground="{StaticResource BrandBrush}"
                                Style="{StaticResource LabelStyle}"
                                Text="{Binding TotalRevenue, StringFormat='{} {0:N2}'}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>

</UserControl>
