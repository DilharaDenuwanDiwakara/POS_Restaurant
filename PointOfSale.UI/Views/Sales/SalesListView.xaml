<UserControl x:Class="PointOfSale.UI.Views.Sales.SalesListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PointOfSale.UI.Views.Sales"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Sales History" Style="{StaticResource HeaderTextStyle}"/>

        <Border Grid.Row="1" Style="{StaticResource PanelCardStyle}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Background="#F1F2F6" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,8">
                            <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource LabelStyle}"/>
                            <DatePicker SelectedDate="{Binding FromDate}" Style="{StaticResource DatePickerStyle}" Margin="0 0 12 0" Width="150"  />

                            <TextBlock Text="To:" VerticalAlignment="Center" Margin="0,0,5,0" Style="{StaticResource LabelStyle}" />
                            <DatePicker SelectedDate="{Binding ToDate}" Style="{StaticResource DatePickerStyle}" Margin="0" Width="150"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0 0 8 8">
                            <TextBlock Text="Type:" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding PaymentTypes}"
                                      SelectedItem="{Binding SelectedPaymentType}"
                                      Width="100"
                                      Style="{StaticResource ComboBoxStyle}"
                                      Margin="0"/>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Command="{Binding SearchCommand}" 
                                Style="{StaticResource SearchButtonStyle}" 
                                ToolTip="Search Sales"
                                VerticalAlignment="Center"
                                Margin="12,0,0,8">
                        </Button>
                    </Grid>
                </Border>

                <DataGrid x:Name="InvoicesDataGrid"
                          Grid.Row="1" 
                          ItemsSource="{Binding SalesList}" 
                          Style="{StaticResource DataGridStyle}"
                          Margin="0 4"
                          AutoGenerateColumns="False"
                          RowDetailsVisibilityMode="Visible"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource Style.DataGrid.Row}">
                            <Setter Property="Height" Value="Auto"/>
                            <Setter Property="MinHeight" Value="42"/>
                            <Setter Property="DetailsVisibility" Value="Visible"/>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="44">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Width="28"
                                                  Height="28"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  ToolTip="Expand invoice">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Setter Property="Content" Value="&gt;"/>
                                                <Setter Property="FontFamily" Value="Segoe UI"/>
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="#334155"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Focusable" Value="False"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                <ContentPresenter HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter Property="Content" Value="v"/>
                                                        <Setter Property="ToolTip" Value="Collapse invoice"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#E5E7EB"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='dd/MM/yyyy HH:mm'}" Width="140"/>
                        <DataGridTextColumn Header="Invoice No" Binding="{Binding InvoiceNo}" Width="120" />
                        <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*" />

                        <DataGridTextColumn Header="Net Amount"
                                            Binding="{Binding NetAmount, StringFormat='Rs. {0:N2}'}"
                                            Width="110"
                                            FontWeight="Bold"
                                            ElementStyle="{StaticResource RightAlignedTextStyle}" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}"/>

                        <DataGridTextColumn Header="Payment Method" Binding="{Binding PaymentMethod}" Width="130" />

                        <DataGridTemplateColumn Header="Action" Width="56">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.ReprintInvoiceCommand, ElementName=InvoicesDataGrid}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource DataGridPrintButtonStyle}"
                                            ToolTip="Reprint bill"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <Border Background="#F4F6F8"
                                    BorderBrush="#D8DEE6"
                                    BorderThickness="0,1,0,1"
                                    Margin="0,12,0,12"
                                    Padding="40,0,12,0"
                                    Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    HorizontalAlignment="Stretch"
                                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <TextBlock Text="Loading invoice items..."
                                               Foreground="#64748B"
                                               Margin="4,0,0,8">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLoadingLineItems}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Border Margin="0,22,0,0"
                                            HorizontalAlignment="Stretch">
                                        <DataGrid ItemsSource="{Binding LineItems}"
                                                  Style="{StaticResource DataGridStyle}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  IsReadOnly="True"
                                                  HeadersVisibility="Column"
                                                  HorizontalAlignment="Stretch"
                                                  MinHeight="78"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Disabled">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Item Name" Binding="{Binding ItemName}" Width="*"/>

                                                <DataGridTextColumn Header="Qty"
                                                                    Binding="{Binding Qty, StringFormat=N2}"
                                                                    Width="80"
                                                                    ElementStyle="{StaticResource RightAlignedTextStyle}"/>

                                                <DataGridTextColumn Header="Unit Price"
                                                                    Binding="{Binding UnitPrice, StringFormat='Rs. {0:N2}'}"
                                                                    Width="120"
                                                                    ElementStyle="{StaticResource RightAlignedTextStyle}" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}"/>

                                                <DataGridTextColumn Header="Total"
                                                                    Binding="{Binding Total, StringFormat='Rs. {0:N2}'}"
                                                                    Width="120"
                                                                    ElementStyle="{StaticResource RightAlignedTextStyle}" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                </DataGrid>

                <Border Grid.Row="2" Style="{StaticResource PanelCardStyle}" Margin="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Total Invoices: " Style="{StaticResource LabelStyle}"/>
                            <TextBlock Text="{Binding SalesList.Count}" Style="{StaticResource LabelStyle}" FontWeight="Bold" Margin="4,0,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Total Revenue: " Style="{StaticResource LabelStyle}"/>
                            <TextBlock Text="{Binding TotalRevenue, StringFormat='{} {0:N2}'}" 
                                       Style="{StaticResource LabelStyle}" 
                                       Foreground="{StaticResource BrandBrush}" 
                                       FontWeight="Bold" 
                                       Margin="4,0,10,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>

</UserControl>
