<Window x:Class="PointOfSale.UI.Views.Sales.Dialogs.SalesReturnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:viewsales="clr-namespace:PointOfSale.UI.Views.Sales"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Height="700" Width="1000">

    <Border Style="{StaticResource WindowBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Background="{StaticResource Brush.Structure.Sidebar}"
                    CornerRadius="8,8,0,0"
                    Padding="20,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Sales Return"
                               Foreground="{StaticResource Brush.Text.OnDark}"
                               Style="{StaticResource HeaderTextStyle}"
                               VerticalAlignment="Center"/>

                    <!-- Prominent, touch-friendly close button -->
                    <Button Grid.Column="1"
                            x:Name="CloseButton"
                            Click="CloseButton_Click"
                            Width="44"
                            Height="44"
                            Background="Transparent"
                            ToolTip="Close and return to POS"
                            Style="{StaticResource IconOnlyButtonStyle}">
                        <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                              Fill="{StaticResource Brush.Text.OnDark}"
                              Width="18" Height="18" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Hosts the same Sales Return screen used from the admin dashboard -->
            <viewsales:SalesReturnView Grid.Row="1"/>

        </Grid>
    </Border>
</Window>
