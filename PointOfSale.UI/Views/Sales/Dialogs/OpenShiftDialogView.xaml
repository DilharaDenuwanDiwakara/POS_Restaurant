<Window x:Class="PointOfSale.UI.Views.Sales.Dialogs.OpenShiftDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Height="300"
        Width="460"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border Style="{StaticResource WindowBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource Brush.Structure.Sidebar}"
                    CornerRadius="8,8,0,0"
                    Padding="10,0">
                <Grid>
                    <TextBlock Text="Open Shift"
                               Foreground="{StaticResource Brush.Text.OnDark}"
                               Style="{StaticResource HeaderTextStyle}"
                               VerticalAlignment="Center"
                               Margin="0"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource PanelCardStyle}" Margin="10">
                <StackPanel>
                    <Border Background="{StaticResource Brush.App.Background}"
                            BorderBrush="{StaticResource Brush.Card.Border}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Assigned POS Terminal" Style="{StaticResource LabelStyle}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding RegisterDisplayName}"
                                       Style="{StaticResource SubHeaderTextStyle}"
                                       Margin="0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Starting Float" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding StartingFloat, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                             Style="{StaticResource TextBoxStyle}"
                             HorizontalContentAlignment="Right"
                             PreviewKeyDown="MoveFocusOnEnter"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Open Shift"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Left"
                                Margin="0,8,8,0"/>

                        <Button Content="Close"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Left"
                                Margin="0,8,0,0"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                    
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
