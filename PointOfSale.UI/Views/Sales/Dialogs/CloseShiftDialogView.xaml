<Window x:Class="PointOfSale.UI.Views.Sales.Dialogs.CloseShiftDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Height="240"
        Width="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border Style="{StaticResource WindowBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource Brush.Structure.Sidebar}"
                    CornerRadius="8,8,0,0"
                    Padding="10,0">
                <TextBlock Text="Close Shift"
                           Foreground="{StaticResource Brush.Text.OnDark}"
                           Style="{StaticResource HeaderTextStyle}"
                           VerticalAlignment="Center"
                           Margin="0"/>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource PanelCardStyle}" Margin="10">
                <StackPanel>
                    <TextBlock Text="Physical Cash" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding PhysicalCash, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                             Style="{StaticResource TextBoxStyle}"
                             HorizontalContentAlignment="Right"
                             InputScope="Number"
                             PreviewTextInput="DecimalOnly_PreviewTextInput"
                             DataObject.Pasting="DecimalOnly_Pasting"
                             PreviewKeyDown="MoveFocusOnEnter"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Confirm"
                                Command="{Binding ConfirmCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,12,8,0"/>

                        <Button Content="Cancel"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,12,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
