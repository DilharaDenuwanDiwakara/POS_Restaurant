<Window x:Class="PointOfSale.UI.Views.Sales.Dialogs.CashInOutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PointOfSale.UI.Views.Sales.Dialogs"
        mc:Ignorable="d"
        Height="450" Width="800"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Style="{StaticResource WindowBorderStyle}">
        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource Brush.Structure.Sidebar}"
                    CornerRadius="8,8,0,0"
                    Padding="10,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center">
                    <TextBlock Text="Cash-In &amp; Cash-Out" 
                               Foreground="{StaticResource Brush.Text.OnDark}" 
                               Style="{StaticResource HeaderTextStyle}" 
                               Margin="0"/>
                </TextBlock>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Background="Transparent"
                            Style="{StaticResource IconOnlyButtonStyle}"
                            Click="CloseButton_Click"
                            ToolTip="Close">

                        <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                              Fill="{StaticResource Brush.Text.OnDark}"
                              Width="12" Height="12" Stretch="Uniform"/>

                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="285"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Cash-In &amp; Cash-Out Form" Style="{StaticResource SubHeaderTextStyle}"/>


                        <!-- Transaction type -->
                        <TextBlock Text="Cash-In or Out" Style="{StaticResource LabelStyle}"/>
                        
                        <ComboBox ItemsSource="{Binding TransactionTypes}"
                                   SelectedItem="{Binding TransactionType, UpdateSourceTrigger=PropertyChanged}"  
                                   Style="{StaticResource ComboBoxStyle}"
                                   ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                   PreviewKeyDown="MoveFocusOnEnter"/>  

                        <!-- Amount -->
                        <TextBlock Text="Amount" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 HorizontalContentAlignment="Right"
                                 MaxLength="18"
                                 Style="{StaticResource TextBoxStyle}"
                                 GotFocus="SelectAllText_GotFocus"
                                 PreviewKeyDown="MoveFocusOnEnter"/>

                        <!-- Description -->
                        <TextBlock Text="Description" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                  MaxLength="50"
                                  Style="{StaticResource TextBoxStyle}"
                                  PreviewKeyDown="MoveFocusOnEnter"/>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Center">
                            <Button Name="SubmitButton"
                                    Content="Save"
                                    Command="{Binding SaveCashCommand, UpdateSourceTrigger=PropertyChanged}" 
                                    Style="{StaticResource PrimaryButtonStyle}"/>

                            <Button Content="Clear"
                                    Command="{Binding ClearCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="10,0,0,0"/>
                            
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Data Grid Header - Fixed Alignment -->
                        <Border Background="#F1F2F6" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" 
                                           Text="Cash-In or Out List" 
                                           Style="{StaticResource SubHeaderTextStyle}" 
                                           VerticalAlignment="Center"
                                           Margin="0"/>

                                <Button Grid.Column="1"
                                        Command="{Binding LoadCashCommand}" 
                                        Style="{StaticResource RefreshButtonStyle}" 
                                        ToolTip="Refresh UnitMeasure List"
                                        Margin="10,0,0,0">

                                </Button>

                                <Button Grid.Column="3" Visibility="Hidden"
                                        Command="{Binding DeleteUnitMeasureCommand}" 
                                        Style="{StaticResource DeleteButtonStyle}" 
                                        ToolTip="Delete Unit Measure">

                                </Button>
                            </Grid>
                        </Border>

                        <!-- Data Grid -->
                        <DataGrid Grid.Row="1" 
                                  ItemsSource="{Binding Transactions}" 
                                  SelectedItem="{Binding SelectedUnitMeasure, UpdateSourceTrigger=PropertyChanged}" 
                                  AutoGenerateColumns="False"
                                  SelectionMode="Single"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  Style="{StaticResource DataGridStyle}"
                                  Margin="0,12,0,0">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id" Binding="{Binding TransactionId}" Width="Auto"  Visibility="Hidden"/>
                                <DataGridTextColumn Header="User" Binding="{Binding CreatedBy}" Width="Auto" Visibility="Hidden"/>
                                <DataGridTextColumn Header="Cash-In or Out" Binding="{Binding TransactionType}" Width="Auto" />
                                <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='Rs. {0:N2}'}" Width="150"  HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}" ElementStyle="{StaticResource RightAlignedTextStyle}"/>
                                <DataGridTextColumn Header="Description" Binding="{Binding Reason}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                    </Grid>
                </Border>

            </Grid>

        </Grid>
    </Border>
</Window>
