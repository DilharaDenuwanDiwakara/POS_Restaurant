<Window x:Class="PointOfSale.UI.Views.Sales.Dialogs.PromoCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Apply Promo Code"
        Height="240" Width="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Border Style="{StaticResource WindowBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Background="{StaticResource Brush.Structure.Sidebar}"
                    CornerRadius="8,8,0,0"
                    Padding="10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Apply Promo / Coupon Code"
                               Foreground="{StaticResource Brush.Text.OnDark}"
                               Style="{StaticResource HeaderTextStyle}"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            Background="Transparent"
                            Style="{StaticResource IconOnlyButtonStyle}"
                            Click="CloseButton_Click"
                            ToolTip="Close">
                        <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                              Fill="{StaticResource Brush.Text.OnDark}"
                              Width="12" Height="12" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Grid Grid.Row="1" Margin="20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Applied status row -->
                <Border Background="#1522334A" BorderBrush="{StaticResource Brush.Card.Border}" BorderThickness="1"
                        CornerRadius="6" Padding="10,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="APPLIED DISCOUNT:"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Text.Muted}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding AppliedDiscountDisplay}"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="LightGreen"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding BillDiscount, StringFormat='- Rs. {0:N2}'}"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="LightGreen"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Code input + action buttons -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtPromoCode"
                             Grid.Column="0"
                             Height="42"
                             FontSize="18"
                             CharacterCasing="Upper"
                             FontWeight="SemiBold"
                             Text="{Binding DiscountCodeInput, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding HasAppliedDiscountCode, Converter={StaticResource InverseBooleanConverter}}"
                             VerticalContentAlignment="Center"
                             Padding="10,0"
                             Style="{StaticResource TextBoxStyle}"
                             ToolTip="Enter promo / coupon code"/>

                    <Button Grid.Column="2"
                            Content="APPLY"
                            Height="42"
                            Width="80"
                            FontSize="14" FontWeight="Bold"
                            Command="{Binding ApplyDiscountCodeCommand}"
                            IsEnabled="{Binding HasAppliedDiscountCode, Converter={StaticResource InverseBooleanConverter}}"
                            Style="{StaticResource SuccessButtonStyle}"/>

                    <Button Grid.Column="4"
                            Content="REMOVE"
                            Height="42"
                            Width="100"
                            FontSize="14" FontWeight="Bold"
                            Command="{Binding RemoveAppliedDiscountCommand}"
                            IsEnabled="{Binding HasAppliedDiscountCode}"
                            Style="{StaticResource DangerButtonStyle}"/>
                </Grid>

                <!-- Close button -->
                <Button Grid.Row="4"
                        Content="CLOSE"
                        HorizontalAlignment="Right"
                        Height="34" Width="100"
                        FontSize="13"
                        Click="CloseButton_Click"
                        Style="{StaticResource SecondaryButtonStyle}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
