<UserControl
    x:Class="PointOfSale.UI.Views.Sales.SalesReportsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="720"
    d:DesignWidth="1180"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="250" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.RowSpan="2"
            Margin="0,0,8,0"
            Style="{StaticResource PanelCardStyle}">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,20"
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubHeaderTextStyle}"
                    Text="Sales Reports" />

                <TextBlock Style="{StaticResource LabelStyle}" Text="Select Branch:" />
                <ComboBox
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding Branches}"
                    SelectedItem="{Binding SelectedBranch}"
                    Style="{StaticResource ComboBoxStyle}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Style="{StaticResource LabelStyle}" Text="Start Date:" />
                        <DatePicker SelectedDate="{Binding StartDate}" Style="{StaticResource DatePickerStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource LabelStyle}" Text="End Date:" />
                        <DatePicker SelectedDate="{Binding EndDate}" Style="{StaticResource DatePickerStyle}" />
                    </StackPanel>
                </Grid>

                <TextBlock Style="{StaticResource LabelStyle}" Text="Select Report Type:" />
                <ComboBox
                    DisplayMemberPath="DisplayName"
                    ItemsSource="{Binding ReportTypes}"
                    SelectedItem="{Binding SelectedReportType}"
                    Style="{StaticResource ComboBoxStyle}" />

                <Button
                    Width="200"
                    Height="45"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Right"
                    Command="{Binding GenerateReportCommand}"
                    Style="{StaticResource PrimaryButtonStyle}">
                    <TextBlock Margin="5,0" Text="GENERATE REPORT" />
                </Button>

                <Border
                    Margin="0,16,0,0"
                    Style="{StaticResource PanelErrorStyle}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Foreground="{StaticResource DangerBrush}"
                        Text="{Binding ErrorMessage}"
                        TextWrapping="Wrap" />
                </Border>

                <Separator Margin="0,20,0,16" />

                <TextBlock Style="{StaticResource LabelStyle}" Text="Records" />
                <TextBlock
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource BrandBrush}"
                    Text="{Binding RecordCount}" />

                <TextBlock
                    Margin="0,12,0,0"
                    Style="{StaticResource LabelStyle}"
                    Text="Total Amount" />
                <TextBlock
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource BrandBrush}"
                    Text="{Binding TotalSalesAmount, StringFormat=N2}" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Margin="0,0,8,0" Style="{StaticResource PanelCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Margin="0,0,0,12"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubHeaderTextStyle}"
                        Text="Daily Sales Trend" />

                    <lvc:CartesianChart
                        Grid.Row="1"
                        Series="{Binding DailySalesSeries}"
                        XAxes="{Binding DailySalesXAxes}" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Margin="0,0,0,12"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubHeaderTextStyle}"
                        Text="Payment Method Breakdown" />

                    <lvc:PieChart
                        Grid.Row="1"
                        InitialRotation="-90"
                        LegendPosition="Right"
                        Series="{Binding PaymentBreakdownSeries}" />
                </Grid>
            </Border>
        </Grid>

        <Border
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,8,0,0"
            Style="{StaticResource PanelCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource SubHeaderTextStyle}"
                        Text="{Binding ReportTitle}" />

                    <Button
                        Grid.Column="1"
                        Width="110"
                        Height="36"
                        Command="{Binding PrintReportCommand}"
                        Style="{StaticResource SecondaryButtonStyle}">
                        <TextBlock Margin="5,0" Text="PRINT" />
                    </Button>
                </Grid>

                <DataGrid
                    Grid.Row="1"
                    AutoGenerateColumns="True"
                    AutoGeneratingColumn="ReportGrid_AutoGeneratingColumn"
                    EnableColumnVirtualization="True"
                    EnableRowVirtualization="True"
                    IsReadOnly="True"
                    ItemsSource="{Binding ReportRows}"
                    Style="{StaticResource DataGridStyle}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
