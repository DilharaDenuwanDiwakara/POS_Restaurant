<UserControl x:Class="PointOfSale.UI.Views.Sales.SalesReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1180">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="250"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,8,0" Grid.RowSpan="2">
            <StackPanel>
                <TextBlock Text="Sales Reports"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"
                           Style="{StaticResource SubHeaderTextStyle}"/>

                <TextBlock Text="Select Branch:" Style="{StaticResource LabelStyle}"/>
                <ComboBox ItemsSource="{Binding Branches}"
                          SelectedItem="{Binding SelectedBranch}"
                          DisplayMemberPath="Name"
                          Style="{StaticResource ComboBoxStyle}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Start Date:" Style="{StaticResource LabelStyle}"/>
                        <DatePicker SelectedDate="{Binding StartDate}"
                                    Style="{StaticResource DatePickerStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="End Date:" Style="{StaticResource LabelStyle}"/>
                        <DatePicker SelectedDate="{Binding EndDate}"
                                    Style="{StaticResource DatePickerStyle}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Select Report Type:" Style="{StaticResource LabelStyle}"/>
                <ComboBox ItemsSource="{Binding ReportTypes}"
                          SelectedItem="{Binding SelectedReportType}"
                          DisplayMemberPath="DisplayName"
                          Style="{StaticResource ComboBoxStyle}"/>

                <Button Command="{Binding GenerateReportCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="45"
                        Width="200"
                        HorizontalAlignment="Right"
                        Margin="0,8,0,0">
                    <TextBlock Text="GENERATE REPORT" Margin="5,0"/>
                </Button>

                <Border Style="{StaticResource PanelErrorStyle}"
                        Margin="0,16,0,0"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap"/>
                </Border>

                <Separator Margin="0,20,0,16"/>

                <TextBlock Text="Records" Style="{StaticResource LabelStyle}"/>
                <TextBlock Text="{Binding RecordCount}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource BrandBrush}"/>

                <TextBlock Text="Total Amount" Style="{StaticResource LabelStyle}" Margin="0,12,0,0"/>
                <TextBlock Text="{Binding TotalSalesAmount, StringFormat=N2}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource BrandBrush}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Daily Sales Trend"
                               HorizontalAlignment="Center"
                               Style="{StaticResource SubHeaderTextStyle}"
                               Margin="0,0,0,12"/>

                    <lvc:CartesianChart Grid.Row="1"
                                        Series="{Binding DailySalesSeries}"
                                        XAxes="{Binding DailySalesXAxes}"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Payment Method Breakdown"
                               HorizontalAlignment="Center"
                               Style="{StaticResource SubHeaderTextStyle}"
                               Margin="0,0,0,12"/>

                    <lvc:PieChart Grid.Row="1"
                                  Series="{Binding PaymentBreakdownSeries}"
                                  InitialRotation="-90"
                                  LegendPosition="Right"/>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Grid.Column="1"
                Style="{StaticResource PanelCardStyle}"
                Margin="0,8,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding ReportTitle}"
                               Style="{StaticResource SubHeaderTextStyle}"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            Command="{Binding PrintReportCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="36"
                            Width="110">
                        <TextBlock Text="PRINT" Margin="5,0"/>
                    </Button>
                </Grid>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding ReportRows}"
                          Style="{StaticResource DataGridStyle}"
                          AutoGenerateColumns="True"
                          AutoGeneratingColumn="ReportGrid_AutoGeneratingColumn"
                          IsReadOnly="True"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
