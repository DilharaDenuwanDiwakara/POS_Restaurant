<UserControl x:Class="PointOfSale.UI.Views.Sales.PromotionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="540" d:DesignWidth="1180">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Auto Promotions" Style="{StaticResource HeaderTextStyle}" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="285"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Promotion Rule Form" Style="{StaticResource SubHeaderTextStyle}" />

                    <TextBlock Text="Rule Name" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding RuleName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" 
                             CharacterCasing="Upper"
                             Style="{StaticResource TextBoxStyle}"
                             PreviewKeyDown="MoveFocusOnEnter"/>

                    <TextBlock Text="Promotion Type" Style="{StaticResource LabelStyle}"/>
                    <ComboBox ItemsSource="{Binding PromotionTypes}"
                              SelectedItem="{Binding SelectedPromotionType, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                              Style="{StaticResource ComboBoxStyle}"
                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                              PreviewKeyDown="MoveFocusOnEnter"/>

                    <TextBlock Text="Buy Product" Style="{StaticResource LabelStyle}"/>
                    <ComboBox ItemsSource="{Binding ProductList}"
                              SelectedValue="{Binding BuyProductId, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                              SelectedValuePath="VariantId"
                              DisplayMemberPath="DisplayName"
                              Style="{StaticResource ComboBoxStyle}"
                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                              PreviewKeyDown="MoveFocusOnEnter"/>

                    <TextBlock Text="Get Product (for cross-item)" Style="{StaticResource LabelStyle}"
                               Visibility="{Binding IsGetProductVisible, Converter={StaticResource BoolToVisibility}}"/>
                    <ComboBox ItemsSource="{Binding ProductList}"
                              SelectedValue="{Binding GetProductId, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                              SelectedValuePath="VariantId"
                              DisplayMemberPath="DisplayName"
                              Style="{StaticResource ComboBoxStyle}"
                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                              Visibility="{Binding IsGetProductVisible, Converter={StaticResource BoolToVisibility}}"
                              PreviewKeyDown="MoveFocusOnEnter"/>

                    <Grid Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Buy Qty" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding BuyQuantity, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                     Style="{StaticResource TextBoxStyle}"
                                     PreviewKeyDown="MoveFocusOnEnter"
                                     GotFocus="SelectAllText_GotFocus"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Get Qty" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding GetQuantity, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                     Style="{StaticResource TextBoxStyle}"
                                     PreviewKeyDown="MoveFocusOnEnter"
                                     GotFocus="SelectAllText_GotFocus"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Discount Percent" Style="{StaticResource LabelStyle}" />
                    <TextBox Text="{Binding DiscountPercent, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                             Style="{StaticResource TextBoxStyle}"
                             IsEnabled="{Binding IsPercentEditable}"
                             PreviewKeyDown="MoveFocusOnEnter"
                             GotFocus="SelectAllText_GotFocus"/>

                    <TextBlock Text="Day Filter" Style="{StaticResource LabelStyle}" />
                    <ComboBox ItemsSource="{Binding DayOptions}"
                              SelectedItem="{Binding SelectedDayOption, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                              DisplayMemberPath="Name"
                              Style="{StaticResource ComboBoxStyle}"
                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                              PreviewKeyDown="MoveFocusOnEnter"/>

                    <TextBlock Text="Valid From" Style="{StaticResource LabelStyle}" />
                    <DatePicker SelectedDate="{Binding ValidFrom, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                Style="{StaticResource DatePickerStyle}"
                                PreviewKeyDown="MoveFocusOnEnter"/>
                    
                    <TextBlock Text="Valid To" Style="{StaticResource LabelStyle}" Margin="0" />
                    <DatePicker SelectedDate="{Binding ValidTo, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                Style="{StaticResource DatePickerStyle}"
                                PreviewKeyDown="MoveFocusOnEnter"/>

                    <CheckBox IsChecked="{Binding IsActive}" 
                              Content="Active"
                              Style="{StaticResource CheckBoxStyle}" 
                              VerticalAlignment="Center"
                              PreviewKeyDown="MoveFocusOnEnter"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                        <Button Content="{Binding SaveButtonText}" 
                                Command="{Binding SaveCommand}" 
                                Style="{StaticResource PrimaryButtonStyle}" 
                                Margin="0,0,8,0"/>
                        
                        <Button Content="Edit" 
                                Command="{Binding EditCommand}" 
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                    
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="#F1F2F6" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Promotion Rules" Style="{StaticResource SubHeaderTextStyle}" VerticalAlignment="Center" Margin="0"/>

                            <Button Grid.Column="1"
                                    Command="{Binding LoadCommand}"
                                    Style="{StaticResource RefreshButtonStyle}"
                                    ToolTip="Refresh"
                                    Margin="10,0,0,0"/>

                            <Button Grid.Column="3"
                                    Command="{Binding ToggleActiveCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Toggle Active"/>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1"
                              Margin="0,4,0,0"
                              ItemsSource="{Binding PromotionList}"
                              SelectedItem="{Binding SelectedRule, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource DataGridStyle}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Rule" Binding="{Binding RuleName}" Width="*"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding PromotionType}" Width="150"/>
                            <DataGridTextColumn Header="Buy Menu Item" Binding="{Binding BuyProductName}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Get Menu Item" Binding="{Binding GetProductName}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="BuyQty" Binding="{Binding BuyQuantity}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="GetQty" Binding="{Binding GetQuantity}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            
                            <DataGridTextColumn Header="%" Binding="{Binding DiscountPercent, StringFormat=N2}" Width="60"/>
                            <DataGridTextColumn Header="DayMask" Binding="{Binding DayOfWeekMask}" Width="80"/>
                            <DataGridTextColumn Header="Active" Binding="{Binding IsActive}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
