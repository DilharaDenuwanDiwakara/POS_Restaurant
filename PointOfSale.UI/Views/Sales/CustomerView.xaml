<UserControl x:Class="PointOfSale.UI.Views.Sales.CustomerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PointOfSale.UI.Views.Sales"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Customer Management" Style="{StaticResource HeaderTextStyle}"/>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="285"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Form -->
            <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Customer Form" Style="{StaticResource SubHeaderTextStyle}"/>

                    <!-- Customer Name -->
                    <TextBlock Text="Customer Name:" Style="{StaticResource LabelStyle}"/>
                    <TextBox Name="CustomerNameTextBox"
                             Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                             MaxLength="100"
                             Style="{StaticResource TextBoxStyle}" 
                             PreviewKeyDown="MoveFocusOnEnter"/>

                    <!-- Contact Number -->
                    <TextBlock Text="Contact Number:" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding ContactNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                             MaxLength="10"
                             Style="{StaticResource TextBoxStyle}"
                             PreviewKeyDown="MoveFocusOnEnter"/>

                    <!-- Tax Registration -->
                    <CheckBox Content="Is Tax Registered (B2B)"
                              IsChecked="{Binding IsTaxRegistered, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource CheckBoxStyle}"
                              Focusable="False"
                              Margin="0,0,0,12"
                              PreviewKeyDown="MoveFocusOnEnter"/>

                    <TextBlock Text="Tax Registration Number / TIN:"
                               Style="{StaticResource LabelStyle}"
                               Visibility="{Binding IsTaxRegistered, Converter={StaticResource BoolToVis}}"/>
                    <TextBox Text="{Binding TaxRegistrationNumber, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="50"
                             CharacterCasing="Upper"
                             Style="{StaticResource TextBoxStyle}"
                             Visibility="{Binding IsTaxRegistered, Converter={StaticResource BoolToVis}}"
                             PreviewKeyDown="MoveFocusOnEnter"/>

                    <!-- Is Active -->
                    <CheckBox Content="Is Active"
                              IsChecked="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource CheckBoxStyle}"
                              Focusable="False"
                              PreviewKeyDown="MoveFocusOnEnter"/>   

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,24,0,0" HorizontalAlignment="Center">
                        <Button Name="SubmitButton"
                                Content="{Binding SaveButtonText}"
                                Command="{Binding SaveCustomerCommand}" 
                                Style="{StaticResource PrimaryButtonStyle}" 
                                Click="SubmitButton_Click"
                                Margin="0,0,12,0"/>

                        <Button Content="Edit" 
                                Command="{Binding EditCustomerCommand}" 
                                Style="{StaticResource SecondaryButtonStyle}"/>
                        
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Right Panel - Data Grid -->
            <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="#F1F2F6" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" 
                                       Text="Customer List" 
                                       Style="{StaticResource SubHeaderTextStyle}" 
                                       VerticalAlignment="Center"
                                       Margin="0"/>

                            <Button Grid.Column="1"
                                    Command="{Binding LoadCustomerCommand}" 
                                    Style="{StaticResource RefreshButtonStyle}" 
                                    ToolTip="Refresh Customer List"
                                    Margin="10,0,0,0" />    

                            <TextBox Grid.Column="2"
                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SearchTextBoxStyle}"
                                     Tag="Search by Name or Phone..."
                                     Width="240"
                                     Height="32"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Right"
                                     Margin="8,0"/>

                            <Button Grid.Column="3"
                                    Command="{Binding DeleteCustomerCommand}" 
                                    Style="{StaticResource DeleteButtonStyle}" 
                                    ToolTip="Delete Customer"/>
                            
                        </Grid>
                    </Border>

                    <!-- Data Grid -->
                    <DataGrid Grid.Row="1" 
                              ItemsSource="{Binding CustomerList}" 
                              SelectedItem="{Binding SelectedCustomer, UpdateSourceTrigger=PropertyChanged}" 
                              AutoGenerateColumns="False"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              Style="{StaticResource DataGridStyle}"
                              Margin="0,4,0,0">
                        
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding CustomerId}" Width="Auto" Visibility="Hidden"/>
                            <DataGridTextColumn Header="Customer Name" Binding="{Binding CustomerName}" Width="*" />
                            <DataGridTextColumn Header="Contact Number" Binding="{Binding ContactNumber}" Width="150"/>
                            <DataGridTextColumn Header="Balance Amount" Binding="{Binding Balance, StringFormat='Rs. {0:N2}'}" Width="150" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="Auto"/>
                        </DataGrid.Columns>
                        
                    </DataGrid>
                    
                </Grid>
            </Border>
            
        </Grid>
        
    </Grid>
</UserControl>
