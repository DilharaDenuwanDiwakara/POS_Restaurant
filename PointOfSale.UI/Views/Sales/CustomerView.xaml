<UserControl
    x:Class="PointOfSale.UI.Views.Sales.CustomerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PointOfSale.UI.Views.Sales"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource HeaderTextStyle}" Text="Customer Management" />

        <!--  Main Content  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="285" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Left Panel - Form  -->
            <Border Margin="0,0,8,0" Style="{StaticResource PanelCardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SubHeaderTextStyle}" Text="Customer Form" />

                    <!--  Customer Name  -->
                    <TextBlock Style="{StaticResource LabelStyle}" Text="Customer Name:" />
                    <TextBox
                        Name="CustomerNameTextBox"
                        MaxLength="100"
                        PreviewKeyDown="MoveFocusOnEnter"
                        Style="{StaticResource TextBoxStyle}"
                        Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                    <!--  Contact Number  -->
                    <TextBlock Style="{StaticResource LabelStyle}" Text="Contact Number:" />
                    <TextBox
                        MaxLength="10"
                        PreviewKeyDown="MoveFocusOnEnter"
                        Style="{StaticResource TextBoxStyle}"
                        Text="{Binding ContactNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                    <!--  Address  -->
                    <TextBlock Style="{StaticResource LabelStyle}" Text="Address:" />
                    <TextBox
                        MinHeight="64"
                        AcceptsReturn="True"
                        MaxLength="500"
                        Style="{StaticResource TextBoxStyle}"
                        Text="{Binding BillingAddress, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />

                    <!--  Tax Registration  -->
                    <CheckBox
                        Margin="0,0,0,12"
                        Content="Is Tax Registered (B2B)"
                        Focusable="False"
                        IsChecked="{Binding IsTaxRegistered, UpdateSourceTrigger=PropertyChanged}"
                        PreviewKeyDown="MoveFocusOnEnter"
                        Style="{StaticResource CheckBoxStyle}" />

                    <TextBlock
                        Style="{StaticResource LabelStyle}"
                        Text="Tax Registration Number / TIN:"
                        Visibility="{Binding IsTaxRegistered, Converter={StaticResource BoolToVis}}" />
                    <TextBox
                        CharacterCasing="Upper"
                        MaxLength="50"
                        PreviewKeyDown="MoveFocusOnEnter"
                        Style="{StaticResource TextBoxStyle}"
                        Text="{Binding TaxRegistrationNumber, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{Binding IsTaxRegistered, Converter={StaticResource BoolToVis}}" />

                    <!--  Is Active  -->
                    <CheckBox
                        Content="Is Active"
                        Focusable="False"
                        IsChecked="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}"
                        PreviewKeyDown="MoveFocusOnEnter"
                        Style="{StaticResource CheckBoxStyle}" />

                    <!--  Action Buttons  -->
                    <StackPanel
                        Margin="0,24,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Name="SubmitButton"
                            Margin="0,0,12,0"
                            Click="SubmitButton_Click"
                            Command="{Binding SaveCustomerCommand}"
                            Content="{Binding SaveButtonText}"
                            Style="{StaticResource PrimaryButtonStyle}" />

                        <Button
                            Command="{Binding EditCustomerCommand}"
                            Content="Edit"
                            Style="{StaticResource SecondaryButtonStyle}" />

                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  Right Panel - Data Grid  -->
            <Border
                Grid.Column="1"
                Margin="0"
                Style="{StaticResource PanelCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Padding="12,8" Background="#F1F2F6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Margin="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource SubHeaderTextStyle}"
                                Text="Customer List" />

                            <Button
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Command="{Binding LoadCustomerCommand}"
                                Style="{StaticResource RefreshButtonStyle}"
                                ToolTip="Refresh Customer List" />

                            <TextBox
                                Grid.Column="2"
                                Width="240"
                                Height="32"
                                Margin="8,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource SearchTextBoxStyle}"
                                Tag="Search by Name or Phone..."
                                Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />

                            <Button
                                Grid.Column="3"
                                Command="{Binding DeleteCustomerCommand}"
                                Style="{StaticResource DeleteButtonStyle}"
                                ToolTip="Delete Customer" />

                        </Grid>
                    </Border>

                    <!--  Data Grid  -->
                    <DataGrid
                        Grid.Row="1"
                        Margin="0,4,0,0"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsReadOnly="True"
                        ItemsSource="{Binding CustomerList}"
                        SelectedItem="{Binding SelectedCustomer, UpdateSourceTrigger=PropertyChanged}"
                        SelectionMode="Single"
                        Style="{StaticResource DataGridStyle}">

                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="Auto"
                                Binding="{Binding CustomerId}"
                                Header="ID"
                                Visibility="Hidden" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding CustomerName}"
                                Header="Customer Name" />
                            <DataGridTextColumn
                                Width="150"
                                Binding="{Binding ContactNumber}"
                                Header="Contact Number" />
                            <DataGridTextColumn
                                Width="220"
                                Binding="{Binding BillingAddress}"
                                Header="Address">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn
                                Width="150"
                                Binding="{Binding Balance, StringFormat='Rs. {0:N2}'}"
                                Header="Balance Amount"
                                HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridCheckBoxColumn
                                Width="Auto"
                                Binding="{Binding IsActive}"
                                Header="Active" />
                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>
            </Border>

        </Grid>

    </Grid>
</UserControl>
