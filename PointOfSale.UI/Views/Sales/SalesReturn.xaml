<UserControl
    x:Class="PointOfSale.UI.Views.Sales.SalesReturn"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PointOfSale.UI.Views.Sales"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource HeaderTextStyle}" Text="Sales Return" />

        <Border
            Grid.Row="1"
            Margin="0"
            Style="{StaticResource PanelCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Padding="12,8" Background="#F1F2F6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            Margin="0,0,12,8"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource LabelStyle}"
                                Text="From:" />
                            <DatePicker
                                Width="150"
                                Margin="0,0,12,0"
                                SelectedDate="{Binding FromDate}"
                                Style="{StaticResource DatePickerStyle}" />

                            <TextBlock
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource LabelStyle}"
                                Text="To:" />
                            <DatePicker
                                Width="150"
                                Margin="0"
                                SelectedDate="{Binding ToDate}"
                                Style="{StaticResource DatePickerStyle}" />
                        </StackPanel>

                        <Button
                            Grid.Column="2"
                            Margin="12,0,0,8"
                            VerticalAlignment="Center"
                            Command="{Binding SearchCommand}"
                            Style="{StaticResource SearchButtonStyle}"
                            ToolTip="Search Sales" />
                    </Grid>
                </Border>

                <DataGrid
                    x:Name="ReturnsDataGrid"
                    Grid.Row="1"
                    Margin="0,4"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    HorizontalScrollBarVisibility="Disabled"
                    IsReadOnly="True"
                    ItemsSource="{Binding SalesReturnList}"
                    SelectionMode="Single"
                    Style="{StaticResource DataGridStyle}"
                    VerticalScrollBarVisibility="Auto">
                    <!--  RowDetailsVisibilityMode ඉවත් කර ඇත  -->

                    <DataGrid.RowStyle>
                        <Style BasedOn="{StaticResource Style.DataGrid.Row}" TargetType="DataGridRow">
                            <Setter Property="Height" Value="Auto" />
                            <Setter Property="MinHeight" Value="42" />
                            <!--  මෙතනින් තමයි click කරද්දී විතරක් open වෙන්න හැදුවේ  -->
                            <Setter Property="DetailsVisibility" Value="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}" />
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <!--  Expand / Collapse Button  -->
                        <DataGridTemplateColumn Width="44">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ToggleButton
                                        Width="28"
                                        Height="28"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding IsExpanded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="Expand return details">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Setter Property="Content" Value="&gt;" />
                                                <Setter Property="FontFamily" Value="Segoe UI" />
                                                <Setter Property="FontSize" Value="12" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="Foreground" Value="#334155" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="Focusable" Value="False" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter Property="Content" Value="v" />
                                                        <Setter Property="ToolTip" Value="Collapse return details" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#E5E7EB" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!--  Parent Row Columns  -->
                        <DataGridTextColumn
                            Width="140"
                            Binding="{Binding CreateDate, StringFormat='dd/MM/yyyy HH:mm'}"
                            Header="Date" />
                        <DataGridTextColumn
                            Width="140"
                            Binding="{Binding ReturnNo}"
                            Header="Return No" />
                        <DataGridTextColumn
                            Width="140"
                            Binding="{Binding InvoiceNo}"
                            Header="Invoice No" />

                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding TotalRefundAmount, StringFormat='Rs. {0:N2}'}"
                            ElementStyle="{StaticResource RightAlignedTextStyle}"
                            FontWeight="Bold"
                            Header="Total Refund"
                            HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}" />
                    </DataGrid.Columns>

                    <!--  Child Row Details (Expanded Area)  -->
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <Border
                                Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                Margin="0,12,0,12"
                                Padding="40,0,12,0"
                                HorizontalAlignment="Stretch"
                                Background="#F4F6F8"
                                BorderBrush="#D8DEE6"
                                BorderThickness="0,1,0,1"
                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Border Margin="0,10,0,10" HorizontalAlignment="Stretch">

                                        <!--  Child DataGrid  -->
                                        <DataGrid
                                            MinHeight="50"
                                            HorizontalAlignment="Stretch"
                                            AutoGenerateColumns="False"
                                            CanUserAddRows="False"
                                            HeadersVisibility="Column"
                                            HorizontalScrollBarVisibility="Disabled"
                                            IsReadOnly="True"
                                            ItemsSource="{Binding ReturnLines}"
                                            Style="{StaticResource DataGridStyle}"
                                            VerticalScrollBarVisibility="Disabled">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn
                                                    Width="*"
                                                    Binding="{Binding ProductName}"
                                                    Header="Product Name" />

                                                <DataGridTextColumn
                                                    Width="100"
                                                    Binding="{Binding QtyReturn, StringFormat=N2}"
                                                    ElementStyle="{StaticResource RightAlignedTextStyle}"
                                                    Header="Return Qty"
                                                    HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}" />

                                                <DataGridTextColumn
                                                    Width="150"
                                                    Binding="{Binding ReturnReason}"
                                                    Header="Reason" />

                                                <!--  Checkbox column for Boolean value  -->
                                                <DataGridCheckBoxColumn
                                                    Width="80"
                                                    Binding="{Binding IsWastage}"
                                                    Header="Wastage" />

                                                <DataGridTextColumn
                                                    Width="140"
                                                    Binding="{Binding RefundAmount, StringFormat='Rs. {0:N2}'}"
                                                    ElementStyle="{StaticResource RightAlignedTextStyle}"
                                                    Header="Refund Amount"
                                                    HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}" />
                                            </DataGrid.Columns>
                                        </DataGrid>

                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                </DataGrid>

                <Border
                    Grid.Row="2"
                    Margin="0"
                    Style="{StaticResource PanelCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>


                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Total Refund Amount: " />
                            <TextBlock
                                Margin="4,0,10,0"
                                FontWeight="Bold"
                                Foreground="{StaticResource BrandBrush}"
                                Style="{StaticResource LabelStyle}"
                                Text="{Binding TotalRefundAmount, StringFormat='{} {0:N2}'}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
