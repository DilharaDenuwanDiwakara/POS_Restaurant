<UserControl x:Class="PointOfSale.UI.Views.Sales.SalesReturnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1000">

    <UserControl.Resources>
        <Style x:Key="TouchDataGridRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource Style.DataGrid.Row}">
            <Setter Property="Height" Value="64"/>
            <Setter Property="MinHeight" Value="64"/>
        </Style>

        <Style x:Key="ReadOnlyCellTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="TouchComboBoxItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItemStyle}">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="MinHeight" Value="44"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Sales Return" Style="{StaticResource HeaderTextStyle}"/>

        <!-- Search Bar -->
        <Border Grid.Row="1" Style="{StaticResource PanelCardStyle}" Margin="0,10,0,12" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Invoice Number:"
                               Style="{StaticResource LabelStyle}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>

                    <TextBox x:Name="InvoiceNumberTextBox"
                             Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TextBoxStyle}"
                             Width="280"
                             Height="50"
                             FontSize="18"
                             Margin="0,0,16,0"
                             KeyDown="InvoiceNumberTextBox_KeyDown"/>

                    <TextBlock Text="{Binding LoadedInvoiceNumber, StringFormat='Loaded: {0}'}"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="{StaticResource Brush.Text.Muted}"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="SEARCH"
                        Command="{Binding SearchInvoiceCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="50"
                        Width="150"
                        FontSize="16"/>
            </Grid>
        </Border>

        <!-- Return Lines Grid -->
        <Border Grid.Row="2" Style="{StaticResource PanelCardStyle}" Padding="4" Margin="0,0,0,12">
            <DataGrid ItemsSource="{Binding ReturnLines}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      Style="{StaticResource DataGridStyle}"
                      RowStyle="{StaticResource TouchDataGridRowStyle}">
                <DataGrid.Columns>

                    <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="2*" IsReadOnly="True"/>

                    <DataGridTextColumn Header="Sold Qty" Binding="{Binding SoldQty, StringFormat=N2}" Width="*" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ReadOnlyCellTextStyle}">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="TextAlignment" Value="Right"/>
                                <Setter Property="Margin" Value="0,0,8,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource RightAlignedDataGridColumnHeaderStyle}"/>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat=N2}" Width="*" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ReadOnlyCellTextStyle}">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="TextAlignment" Value="Right"/>
                                <Setter Property="Margin" Value="0,0,8,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource RightAlignedDataGridColumnHeaderStyle}"/>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="Return Qty" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding ReturnQty, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                         Style="{StaticResource TextBoxStyle}"
                                         Height="48"
                                         FontSize="18"
                                         TextAlignment="Center"
                                         Margin="6"
                                         PreviewTextInput="QtyTextBox_PreviewTextInput"
                                         GotKeyboardFocus="SelectAllText_GotFocus"
                                         PreviewMouseLeftButtonDown="QtyTextBox_PreviewMouseLeftButtonDown"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Reason" Width="230">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.ReturnReasons, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedValue="{Binding ReturnReasonId, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="Reason"
                                          Style="{StaticResource ComboBoxStyle}"
                                          ItemContainerStyle="{StaticResource TouchComboBoxItemStyle}"
                                          Height="48"
                                          FontSize="15"
                                          Margin="6"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Send to Wastage" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox Content="Wastage"
                                          IsChecked="{Binding IsWastage, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource CheckBoxStyle}"
                                          FontSize="14"
                                          HorizontalAlignment="Center"
                                          Margin="6"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Refund" Binding="{Binding RefundAmount, StringFormat=N2}" Width="*" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource ReadOnlyCellTextStyle}">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="TextAlignment" Value="Right"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Margin" Value="0,0,8,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource RightAlignedDataGridColumnHeaderStyle}"/>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3" Style="{StaticResource PanelCardStyle}" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalRefund, StringFormat='Total Refund: Rs. {0:N2}'}"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{StaticResource DangerBrush}"/>

                    <TextBlock Text="{Binding AuthorizedByName, StringFormat='Authorized by: {0}'}"
                               FontSize="13"
                               Foreground="{StaticResource Brush.Text.Muted}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="PROCESS REFUND"
                        Command="{Binding ProcessReturnCommand}"
                        Style="{StaticResource DangerButtonStyle}"
                        Height="64"
                        Width="280"
                        FontSize="20"
                        FontWeight="Bold"/>
            </Grid>
        </Border>

    </Grid>
</UserControl>
