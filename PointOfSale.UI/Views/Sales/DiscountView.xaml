<UserControl
    x:Class="PointOfSale.UI.Views.Sales.DiscountView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="520"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource HeaderTextStyle}" Text="Discount Management" />

        <TabControl
            Grid.Row="1"
            SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
            Style="{StaticResource TabControlStyle}">
            <TabItem Header="New Discount" Style="{StaticResource TabItemStyle}">
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Margin="0,0,8,0" Style="{StaticResource PanelCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ScrollViewer Padding="0,0,10,0" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SubHeaderTextStyle}" Text="Discount Form" />

                                    <TextBlock Style="{StaticResource LabelStyle}" Text="Code" />
                                    <TextBox
                                        CharacterCasing="Upper"
                                        MaxLength="50"
                                        PreviewKeyDown="MoveFocusOnEnter"
                                        Style="{StaticResource TextBoxStyle}"
                                        Text="{Binding Code, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                                    <TextBlock Style="{StaticResource LabelStyle}" Text="Name" />
                                    <TextBox
                                        CharacterCasing="Upper"
                                        MaxLength="150"
                                        PreviewKeyDown="MoveFocusOnEnter"
                                        Style="{StaticResource TextBoxStyle}"
                                        Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Style="{StaticResource LabelStyle}" Text="Value" />
                                            <TextBox
                                                GotFocus="SelectAllText_GotFocus"
                                                PreviewKeyDown="MoveFocusOnEnter"
                                                Style="{StaticResource TextBoxStyle}"
                                                Text="{Binding DiscountValue, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Style="{StaticResource LabelStyle}" Text="Type" />
                                            <ComboBox
                                                ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                                ItemsSource="{Binding DiscountTypes}"
                                                PreviewKeyDown="MoveFocusOnEnter"
                                                SelectedItem="{Binding SelectedDiscountType, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                                Style="{StaticResource ComboBoxStyle}" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Style="{StaticResource LabelStyle}" Text="Minimum Bill Amount" />
                                    <TextBox
                                        GotFocus="SelectAllText_GotFocus"
                                        PreviewKeyDown="MoveFocusOnEnter"
                                        Style="{StaticResource TextBoxStyle}"
                                        Text="{Binding MinimumBillAmount, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                                    <TextBlock Style="{StaticResource LabelStyle}" Text="Maximum Discount Amount (Optional)" />
                                    <TextBox
                                        GotFocus="SelectAllText_GotFocus"
                                        PreviewKeyDown="MoveFocusOnEnter"
                                        Style="{StaticResource TextBoxStyle}"
                                        Text="{Binding MaximumDiscountAmount, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                                    <TextBlock Style="{StaticResource LabelStyle}" Text="Valid From" />
                                    <DatePicker
                                        PreviewKeyDown="MoveFocusOnEnter"
                                        SelectedDate="{Binding ValidFrom, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                        Style="{StaticResource DatePickerStyle}" />

                                    <TextBlock Style="{StaticResource LabelStyle}" Text="Valid To" />
                                    <DatePicker
                                        PreviewKeyDown="MoveFocusOnEnter"
                                        SelectedDate="{Binding ValidTo, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                        Style="{StaticResource DatePickerStyle}" />

                                    <StackPanel Margin="0,8,0,8" Orientation="Horizontal">
                                        <CheckBox
                                            Margin="0,0,16,0"
                                            VerticalAlignment="Center"
                                            Content="Single-use"
                                            IsChecked="{Binding IsSingleUse}"
                                            PreviewKeyDown="MoveFocusOnEnter"
                                            Style="{StaticResource CheckBoxStyle}" />

                                        <CheckBox
                                            Margin="0,0,0,0"
                                            VerticalAlignment="Center"
                                            Content="Auto Apply"
                                            IsChecked="{Binding IsAutoApply}"
                                            Style="{StaticResource CheckBoxStyle}" />

                                    </StackPanel>

                                    <StackPanel Margin="0,8,0,8" Visibility="{Binding IsAutoRuleVisible, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Style="{StaticResource LabelStyle}" Text="Apply Scope" />
                                        <ComboBox
                                            ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                            ItemsSource="{Binding ApplyScopes}"
                                            PreviewKeyDown="MoveFocusOnEnter"
                                            SelectedItem="{Binding SelectedApplyScope, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                            Style="{StaticResource ComboBoxStyle}" />

                                        <TextBlock
                                            Style="{StaticResource LabelStyle}"
                                            Text="Menu Category"
                                            Visibility="{Binding IsCategorySelectionVisible, Converter={StaticResource BoolToVisibility}}" />

                                        <ComboBox
                                            DisplayMemberPath="Name"
                                            ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                            ItemsSource="{Binding MenuCategories}"
                                            PreviewKeyDown="MoveFocusOnEnter"
                                            SelectedValue="{Binding SelectedMenuCategoryId, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                            SelectedValuePath="Id"
                                            Style="{StaticResource ComboBoxStyle}"
                                            Visibility="{Binding IsCategorySelectionVisible, Converter={StaticResource BoolToVisibility}}" />

                                        <TextBlock Style="{StaticResource LabelStyle}" Text="Day Filter" />
                                        <ComboBox
                                            DisplayMemberPath="Name"
                                            ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                            ItemsSource="{Binding DayOptions}"
                                            PreviewKeyDown="MoveFocusOnEnter"
                                            SelectedItem="{Binding SelectedDayOption, ValidatesOnNotifyDataErrors=True}"
                                            Style="{StaticResource ComboBoxStyle}" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Margin="0,0,6,0">
                                                <TextBlock Style="{StaticResource LabelStyle}" Text="Start Time (HH:mm)" />
                                                <TextBox
                                                    GotFocus="SelectAllText_GotFocus"
                                                    PreviewKeyDown="MoveFocusOnEnter"
                                                    Style="{StaticResource TextBoxStyle}"
                                                    Text="{Binding StartTimeText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock Style="{StaticResource LabelStyle}" Text="End Time (HH:mm)" />
                                                <TextBox
                                                    GotFocus="SelectAllText_GotFocus"
                                                    PreviewKeyDown="MoveFocusOnEnter"
                                                    Style="{StaticResource TextBoxStyle}"
                                                    Text="{Binding EndTimeText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <CheckBox
                                        VerticalAlignment="Center"
                                        Content="Active"
                                        IsChecked="{Binding IsActive}"
                                        Style="{StaticResource CheckBoxStyle}" />


                                </StackPanel>
                            </ScrollViewer>

                            <Border
                                Grid.Row="1"
                                Padding="0,12,0,0"
                                BorderBrush="#E0E0E0"
                                BorderThickness="0,1,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        Margin="0,0,12,0"
                                        Command="{Binding SaveCommand}"
                                        Content="{Binding SaveButtonText}"
                                        Style="{StaticResource PrimaryButtonStyle}" />

                                    <Button
                                        Margin="0"
                                        Command="{Binding EditCommand}"
                                        Content="Edit"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                    </Border>

                    <Border
                        Grid.Column="1"
                        Margin="0"
                        Style="{StaticResource PanelCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Style="{StaticResource SubHeaderTextStyle}" Text="Category Products" />
                            <DataGrid
                                Grid.Row="1"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                ItemsSource="{Binding CategoryProducts}"
                                Style="{StaticResource DataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="140"
                                        Binding="{Binding ProductCode}"
                                        Header="Product Code"
                                        IsReadOnly="True" />
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding ProductName}"
                                        Header="Product Name"
                                        IsReadOnly="True" />
                                    <DataGridCheckBoxColumn
                                        Width="170"
                                        Binding="{Binding IsExcluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Header="Exclude from Discount" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Discount Codes List" Style="{StaticResource TabItemStyle}">
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Margin="0,0,8,0" Style="{StaticResource PanelCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Padding="12,8" Background="#F1F2F6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Margin="0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SubHeaderTextStyle}"
                                        Text="Discount Codes" />

                                    <Button
                                        Grid.Column="1"
                                        Margin="10,0,0,0"
                                        Command="{Binding LoadCommand}"
                                        Style="{StaticResource RefreshButtonStyle}"
                                        ToolTip="Refresh" />

                                    <Button
                                        Grid.Column="2"
                                        Margin="10,0,0,0"
                                        Command="{Binding EditCommand}"
                                        Content="Edit"
                                        Style="{StaticResource SecondaryButtonStyle}" />

                                    <Button
                                        Grid.Column="4"
                                        Command="{Binding ToggleActiveCommand}"
                                        Content="Toggle Active"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                </Grid>
                            </Border>

                            <DataGrid
                                Grid.Row="1"
                                Margin="0,4,0,0"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                IsReadOnly="True"
                                ItemsSource="{Binding DiscountList}"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                SelectedItem="{Binding SelectedDiscount, UpdateSourceTrigger=PropertyChanged}"
                                SelectionMode="Single"
                                Style="{StaticResource DataGridStyle}">

                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="100"
                                        Binding="{Binding Code}"
                                        Header="Code" />
                                    <DataGridTextColumn
                                        Width="180"
                                        Binding="{Binding Name}"
                                        Header="Name" />
                                    <DataGridTextColumn
                                        Width="90"
                                        Binding="{Binding DiscountType}"
                                        Header="Type" />
                                    <DataGridTextColumn
                                        Width="80"
                                        Binding="{Binding DiscountValue, StringFormat=N2}"
                                        Header="Value">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn
                                        Width="150"
                                        Binding="{Binding MinimumBillAmount, StringFormat='Rs. {0:N2}'}"
                                        Header="MinimumBillAmount"
                                        HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn
                                        Width="80"
                                        Binding="{Binding IsAutoApply}"
                                        Header="Auto" />
                                    <DataGridTextColumn
                                        Width="85"
                                        Binding="{Binding ApplyScope}"
                                        Header="Scope" />
                                    <DataGridTextColumn
                                        Width="80"
                                        Binding="{Binding TargetMenuCategoryId}"
                                        Header="Category" />
                                    <DataGridTextColumn
                                        Width="70"
                                        Binding="{Binding DayOfWeekMask}"
                                        Header="DayMask" />
                                    <DataGridTextColumn
                                        Width="85"
                                        Binding="{Binding StartTime}"
                                        Header="Time" />
                                    <DataGridTextColumn
                                        Width="65"
                                        Binding="{Binding IsActive}"
                                        Header="Active" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Margin="0"
                        Style="{StaticResource PanelCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Style="{StaticResource SubHeaderTextStyle}" Text="{Binding SelectedDiscountProductsTitle}" />
                            <TextBlock
                                Grid.Row="1"
                                Style="{StaticResource LabelStyle}"
                                Text="{Binding SelectedDiscountProductsMessage}"
                                TextWrapping="Wrap" />
                            <DataGrid
                                Grid.Row="2"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                IsReadOnly="True"
                                ItemsSource="{Binding SelectedDiscountProducts}"
                                SelectionMode="Single"
                                Style="{StaticResource DataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="110"
                                        Binding="{Binding ProductCode}"
                                        Header="Product Code"
                                        IsReadOnly="True" />
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding ProductName}"
                                        Header="Product Name"
                                        IsReadOnly="True" />
                                    <DataGridCheckBoxColumn
                                        Width="160"
                                        Binding="{Binding IsExcluded, Mode=OneWay}"
                                        Header="Exclude from Discount"
                                        IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
