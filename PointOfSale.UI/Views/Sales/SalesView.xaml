<Window
    x:Class="PointOfSale.UI.Views.Sales.SalesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:PointOfSale.Core.Enums;assembly=PointOfSale.Core"
    xmlns:local="clr-namespace:PointOfSale.UI.Views.Sales"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SalesView"
    MinWidth="1366"
    MinHeight="760"
    FontFamily="Segoe UI"
    ResizeMode="CanResizeWithGrip"
    WindowState="Maximized"
    mc:Ignorable="d">

    <Window.Resources>
        <Style BasedOn="{StaticResource SalesScrollBarStyle}" TargetType="ScrollBar" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding
            Key="F1"
            Command="{Binding SelectPaymentMethodCommand}"
            CommandParameter="{x:Static enums:SalesPaymentMethod.CASH}" />
        <KeyBinding
            Key="F2"
            Command="{Binding SelectPaymentMethodCommand}"
            CommandParameter="{x:Static enums:SalesPaymentMethod.CARD}" />
        <KeyBinding
            Key="F3"
            Command="{Binding SelectPaymentMethodCommand}"
            CommandParameter="{x:Static enums:SalesPaymentMethod.CREDIT}" />
        <KeyBinding
            Key="F4"
            Command="{Binding SelectPaymentMethodCommand}"
            CommandParameter="{x:Static enums:SalesPaymentMethod.BANK_TRANSFER}" />
        <KeyBinding Key="Delete" Command="{Binding RemoveItemCommand}" />
    </Window.InputBindings>

    <Grid Style="{StaticResource SalesMainGridStyle}">
        <Border
            Panel.ZIndex="100"
            Background="#90000000"
            Visibility="{Binding IsOverlayVisible, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="13*" />
                <ColumnDefinition Width="7*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,0,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SalesViewTitleStyle}" Text="Orders list" />
                        <TextBlock Style="{StaticResource SalesViewCountStyle}" Text="{Binding ServedOrders.Count, StringFormat=' ({0})'}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button
                            Command="{Binding RefreshOrdersCommand}"
                            Style="{StaticResource RefreshButtonStyle}"
                            ToolTip="Refresh Orders" />
                    </StackPanel>
                </Grid>

                <ListBox
                    Grid.Row="1"
                    ItemsSource="{Binding ServedOrders}"
                    SelectedItem="{Binding SelectedServedOrder}"
                    Style="{StaticResource OrdersListBoxStyle}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource OrderCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <TextBlock Style="{StaticResource OrderNumberTextStyle}" Text="{Binding OrderNumber}" />
                                        <Border HorizontalAlignment="Right" Style="{StaticResource OrderTablePillStyle}">
                                            <TextBlock Style="{StaticResource OrderTablePillTextStyle}" Text="{Binding TableName}" />
                                        </Border>
                                    </Grid>

                                    <TextBlock
                                        Grid.Row="1"
                                        Style="{StaticResource OrderCustomerTextStyle}"
                                        Text="{Binding CustomerSummaryText}"
                                        ToolTip="{Binding CustomerSummaryText}" />

                                    <Grid Grid.Row="2" Margin="0,2,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource OrderMetaTextStyle}" Text="{Binding ItemCountText}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource OrderAmountTextStyle}"
                                            Text="{Binding TotalAmount, StringFormat='Rs. {0:N2}'}" />
                                    </Grid>

                                    <Border Grid.Row="3" Style="{StaticResource StatusProgressPillStyle}">
                                        <TextBlock Style="{StaticResource StatusProgressTextStyle}" Text="In Progress" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Border
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,0,12,12"
                Style="{StaticResource SalesSectionCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="310" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SalesViewTitleStyle}" Text="Menu" />
                            <TextBlock Style="{StaticResource SalesViewCountStyle}" Text="{Binding FilteredProducts.Count, StringFormat=' ({0})'}" />
                        </StackPanel>

                        <TextBox
                            x:Name="BarcodeTextBox"
                            Grid.Column="1"
                            DataObject.Pasting="AlphanumericOnly_Pasting"
                            PreviewKeyDown="BarcodeTextBox_KeyDown"
                            PreviewTextInput="AlphanumericOnly_PreviewTextInput"
                            Style="{StaticResource ProductInputStyle}"
                            Tag="Search or scan code"
                            Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />

                        <ComboBox
                            x:Name="ProductComboBox"
                            Grid.Column="2"
                            Margin="12,0,0,0"
                            IsEditable="True"
                            IsTextSearchEnabled="True"
                            ItemsSource="{Binding FilteredProducts}"
                            KeyDown="ProductComboBox_KeyDown"
                            SelectedItem="{Binding SelectedProduct, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                            Style="{StaticResource SalesComboStyle}"
                            TextSearch.TextPath="DisplayName">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2,0,2">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="#C96A00"
                                            Text="{Binding OfferSummary}"
                                            TextWrapping="Wrap"
                                            Visibility="{Binding HasOffer, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <ListBox
                        Grid.Row="1"
                        Margin="0,16,0,18"
                        ItemsSource="{Binding Categories}"
                        SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                        Style="{StaticResource CategoryChipListStyle}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding Name}"
                                    Style="{StaticResource CategoryChipButtonStyle}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ListBox
                        Grid.Row="2"
                        ItemsSource="{Binding FilteredProducts}"
                        ScrollViewer.CanContentScroll="True"
                        ScrollViewer.PanningMode="VerticalOnly"
                        SelectedItem="{Binding SelectedProduct, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource MenuProductListStyle}"
                        Stylus.IsFlicksEnabled="False">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="5" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource MenuProductCardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Border
                                            Grid.Row="0"
                                            Height="108"
                                            MaxHeight="108"
                                            Margin="8"
                                            Style="{StaticResource MenuImagePlaceholderStyle}">
                                            <Grid ClipToBounds="True">
                                                <Grid>
                                                    <Ellipse
                                                        Width="48"
                                                        Height="48"
                                                        Stroke="#CBD5E1"
                                                        StrokeThickness="2" />
                                                    <Path
                                                        Width="28"
                                                        Height="28"
                                                        Data="M4,18 L9,9 L13,14 L16,10 L22,18 Z M6,20 H22 V22 H6 Z"
                                                        Fill="#94A3B8"
                                                        Stretch="Uniform" />
                                                </Grid>
                                                <Image
                                                    MaxHeight="108"
                                                    RenderOptions.BitmapScalingMode="HighQuality"
                                                    Source="{Binding ImageUrl, IsAsync=True, TargetNullValue={x:Null}, FallbackValue={x:Null}}"
                                                    Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>

                                        <Grid
                                            Grid.Row="1"
                                            Height="58"
                                            Margin="5">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="32" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock
                                                Style="{StaticResource MenuProductNameStyle}"
                                                Text="{Binding DisplayName}"
                                                ToolTip="{Binding DisplayName}" />
                                            <TextBlock
                                                Grid.Row="1"
                                                Margin="0,2,0,0"
                                                Style="{StaticResource MenuProductPriceStyle}"
                                                Text="{Binding DefaultPrice, StringFormat='Rs. {0:N2}'}" />
                                        </Grid>

                                        <Button
                                            Grid.Row="2"
                                            Height="45"
                                            ClickMode="Release"
                                            Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Content="Add item"
                                            Focusable="False"
                                            Style="{StaticResource MenuCardAddButtonStyle}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border
                Grid.Row="2"
                Grid.Column="0"
                Margin="0,0,12,0"
                Style="{StaticResource ActionStripStyle}">
                <UniformGrid Columns="6" Rows="1">
                    <Button
                        Command="{Binding CancelInvoiceCommand}"
                        Content="Cancel Invoice"
                        Style="{StaticResource CancelInvoiceButtonStyle}" />

                    <Button
                        Command="{Binding OpenCashInOutCommand}"
                        Content="Cash In-Out"
                        Style="{StaticResource ReturnButtonStyle}" />

                    <Button
                        Command="{Binding OpenSalesReturnCommand}"
                        Content="Sales Return"
                        Style="{StaticResource SalesReturnActionButtonStyle}" />

                    <Button
                        Command="{Binding OpenRoomBookingCommand}"
                        Content="Room Booking"
                        Style="{StaticResource HoldButtonStyle}" />

                    <Button
                        Command="{Binding CloseShiftCommand}"
                        Content="Close Shift"
                        Style="{StaticResource ReturnButtonStyle}" />

                    <Button
                        Command="{Binding EnableDiscountCommad}"
                        Content="Discount"
                        Style="{StaticResource SearchActionButtonStyle}" />

                    <Button
                        Content="RE-PRINT"
                        Style="{StaticResource RePrintButtonStyle}"
                        Visibility="Collapsed" />
                    <Button
                        Command="{Binding RecallSaleCommand}"
                        Content="RECALL (F10)"
                        Style="{StaticResource RecallButtonStyle}"
                        Visibility="Collapsed" />
                </UniformGrid>
            </Border>

            <Border
                Grid.RowSpan="3"
                Grid.Column="1"
                Style="{StaticResource OrderDetailsPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource OrderDetailsTitleStyle}" Text="Order Details" />
                            <Button
                                Grid.Column="1"
                                Margin="0,0,12,0"
                                Command="{Binding OpenAdminDashboardCommand}"
                                Content="Switch to Dashboard"
                                Style="{StaticResource RefreshOrdersPillButtonStyle}"
                                Visibility="{Binding CanAccessAdminPanel, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock
                                Grid.Column="2"
                                Style="{StaticResource UserTextStyle}"
                                Text="{Binding CurrentUser.FullName}" />
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Style="{StaticResource DetailsLabelStyle}" Text="Date" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource DetailsValueStyle}"
                                Text="{Binding CurrentDateTime, StringFormat='{}{0:dddd, dd/MM/yyyy}'}" />
                        </Grid>

                        <TextBlock
                            Margin="0,18,0,0"
                            Style="{StaticResource DetailsFieldHeaderStyle}"
                            Text="Customer Name" />

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox
                                IsDropDownOpen="{Binding IsCustomerDropDownOpen, Mode=TwoWay}"
                                IsEditable="True"
                                IsTextSearchEnabled="False"
                                ItemsSource="{Binding FilteredCustomers}"
                                SelectedItem="{Binding SelectedCustomer, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, ValidatesOnNotifyDataErrors=True}"
                                SelectedValuePath="Id"
                                StaysOpenOnEdit="True"
                                Style="{StaticResource CustomerComboStyle}"
                                Text="{Binding CustomerSearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                TextSearch.TextPath="CustomerName">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding CustomerName}" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{StaticResource Brush.Text.Muted}"
                                                Text="{Binding ContactNumber}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Button
                                Grid.Column="1"
                                Width="38"
                                Height="38"
                                Margin="8,0,0,0"
                                Background="{StaticResource SalesAccentBrush}"
                                Command="{Binding AddCustomerCommand}"
                                Style="{StaticResource AddButtonStyle}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource BalanceLabelStyle}" Text="Outstanding Balance" />
                            <TextBlock Style="{StaticResource BalanceValueStyle}" Text="{Binding OutstandingBalance, StringFormat='Rs. {0:N2}'}" />
                        </StackPanel>

                        <Border Style="{StaticResource ProductImageBorderStyle}" Visibility="Collapsed">
                            <Image x:Name="ProductImage" Style="{StaticResource ProductImageStyle}" />
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <DataGrid
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            ItemsSource="{Binding CartItems}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            SelectedItem="{Binding SelectedCartItem}"
                            Style="{StaticResource SalesDataGridStyle}">
                            <DataGrid.RowStyle>
                                <Style BasedOn="{StaticResource Style.DataGrid.Row}" TargetType="DataGridRow">
                                    <Setter Property="MinHeight" Value="48" />
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="120"
                                    Binding="{Binding ProductCode}"
                                    Header="Product Code"
                                    Visibility="Hidden" />

                                <DataGridTextColumn
                                    Width="*"
                                    MinWidth="180"
                                    Binding="{Binding ProductName}"
                                    Header="Product Name"
                                    IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="ToolTip" Value="{Binding ProductName}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn
                                    Width="65"
                                    Binding="{Binding Note}"
                                    Header="Note"
                                    Visibility="Collapsed">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="ToolTip" Value="{Binding Note}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn
                                    Width="Auto"
                                    Binding="{Binding OfferDisplay}"
                                    Header="Offer"
                                    IsReadOnly="True"
                                    Visibility="Collapsed">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="ToolTip" Value="{Binding OfferDisplay}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn
                                    Width="120"
                                    Binding="{Binding UnitCost, StringFormat='Rs. {0:N2}'}"
                                    ElementStyle="{StaticResource RightAlignedTextStyle}"
                                    Header="Unit Cost"
                                    Visibility="Collapsed" />

                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding UnitPrice, StringFormat='Rs. {0:N2}'}"
                                    Header="Price"
                                    IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Width="80" Header="Discount">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox
                                                Padding="4,0"
                                                DataObject.Pasting="DecimalAmount_Pasting"
                                                IsEnabled="{Binding IsPriceLocked, Converter={StaticResource InverseBooleanConverter}}"
                                                PreviewTextInput="DecimalAmount_PreviewTextInput"
                                                Style="{StaticResource QuantityInputStyle}"
                                                Text="{Binding LineDiscount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.##}}"
                                                TextAlignment="Right"
                                                ToolTip="Discount for this line (Rs.)" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="140" Header="Qty">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Button
                                                    Grid.Column="0"
                                                    Margin="2,0,0,0"
                                                    Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Content="-"
                                                    Style="{StaticResource QuantityStepperButtonStyle}" />

                                                <TextBox
                                                    Grid.Column="1"
                                                    Width="50"
                                                    Padding="2,0"
                                                    IsEnabled="{Binding IsQuantityLocked, Converter={StaticResource InverseBooleanConverter}}"
                                                    Style="{StaticResource QuantityInputStyle}"
                                                    Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0}}"
                                                    TextAlignment="Center" />

                                                <Button
                                                    Grid.Column="2"
                                                    Margin="0,0,2,0"
                                                    Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Content="+"
                                                    Style="{StaticResource QuantityStepperButtonStyle}" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="120" Header="Total">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Text="{Binding Amount, StringFormat='Rs. {0:N2}'}"
                                                TextAlignment="Right" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="45" Header="">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DeleteButtonStyle}"
                                                ToolTip="Remove item" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,8,0,14">
                        <Border Margin="0,0,0,14" Style="{StaticResource SummaryBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Style="{StaticResource SummaryLabelStyle}"
                                    Text="Total Items"
                                    Visibility="Collapsed" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource SummaryValueStyle}"
                                    Text="{Binding CartItems.Count, StringFormat='{}{0} items'}"
                                    Visibility="Collapsed" />

                                <TextBlock
                                    Grid.Row="1"
                                    Style="{StaticResource SummaryLabelStyle}"
                                    Text="SUB TOTAL" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Style="{StaticResource SummaryValueStyle}"
                                    Text="{Binding SubTotal, StringFormat='Rs. {0:N2}', UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock
                                    Grid.Row="2"
                                    Style="{StaticResource SummaryLabelStyle}"
                                    Text="Tax"
                                    Visibility="Collapsed" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Style="{StaticResource SummaryValueStyle}"
                                    Text="{Binding TaxAmount, StringFormat='Rs. {0:N2}'}"
                                    Visibility="Collapsed" />

                                <TextBlock
                                    Grid.Row="3"
                                    Style="{StaticResource DiscountLabelStyle}"
                                    Text="BILL DISCOUNT %" />
                                <TextBox
                                    x:Name="TxtLineDiscountPercent"
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    DataObject.Pasting="DecimalAmount_Pasting"
                                    IsEnabled="{Binding IsDiscountEnabled}"
                                    PreviewTextInput="DecimalAmount_PreviewTextInput"
                                    Style="{StaticResource DiscountValueStyle}"
                                    Text="{Binding LineDiscountPercent, StringFormat=N2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <StackPanel
                                    Grid.Row="4"
                                    Grid.ColumnSpan="2"
                                    HorizontalAlignment="Right"
                                    IsEnabled="{Binding IsDiscountEnabled}"
                                    Orientation="Horizontal">
                                    <Button
                                        Command="{Binding ApplyQuickDiscountCommand}"
                                        CommandParameter="5"
                                        Content="5%"
                                        Style="{StaticResource QuickDiscountButtonStyle}" />
                                    <Button
                                        Command="{Binding ApplyQuickDiscountCommand}"
                                        CommandParameter="10"
                                        Content="10%"
                                        Style="{StaticResource QuickDiscountButtonStyle}" />
                                    <Button
                                        Command="{Binding ApplyQuickDiscountCommand}"
                                        CommandParameter="15"
                                        Content="15%"
                                        Style="{StaticResource QuickDiscountButtonStyle}" />
                                    <Button
                                        Command="{Binding ApplyQuickDiscountCommand}"
                                        CommandParameter="20"
                                        Content="20%"
                                        Style="{StaticResource QuickDiscountButtonStyle}" />
                                    <Button
                                        Command="{Binding ApplyQuickDiscountCommand}"
                                        CommandParameter="0"
                                        Content="Clear"
                                        Style="{StaticResource QuickDiscountButtonStyle}" />
                                </StackPanel>

                                <Grid
                                    Grid.Row="5"
                                    Grid.ColumnSpan="2"
                                    Visibility="{Binding HasAppliedDiscount, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Style="{StaticResource DiscountLabelStyle}"
                                        Text="{Binding AppliedDiscountLabel}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource SummaryValueStyle}"
                                        Text="{Binding AppliedDiscountAmount, StringFormat='- Rs. {0:N2}'}" />
                                </Grid>

                                <Rectangle
                                    Grid.Row="6"
                                    Grid.ColumnSpan="2"
                                    Height="1"
                                    Margin="0,12"
                                    Fill="#E5E7EB" />

                                <TextBlock
                                    Grid.Row="7"
                                    Style="{StaticResource NetAmountLabelStyle}"
                                    Text="NET AMOUNT" />
                                <TextBlock
                                    Grid.Row="7"
                                    Grid.Column="1"
                                    Style="{StaticResource NetAmountValueStyle}"
                                    Text="{Binding NetAmount, StringFormat='Rs. {0:N2}', UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Border>

                        <UniformGrid Margin="0,0,0,14" Columns="4">
                            <Button
                                Command="{Binding SelectPaymentMethodCommand}"
                                CommandParameter="{x:Static enums:SalesPaymentMethod.CASH}"
                                Content="CASH (F1)"
                                Style="{StaticResource PaymentModeButtonStyle}" />
                            <Button
                                Command="{Binding SelectPaymentMethodCommand}"
                                CommandParameter="{x:Static enums:SalesPaymentMethod.CARD}"
                                Content="CARD (F2)"
                                Style="{StaticResource PaymentModeButtonStyle}" />
                            <Button
                                Command="{Binding SelectPaymentMethodCommand}"
                                CommandParameter="{x:Static enums:SalesPaymentMethod.CREDIT}"
                                Content="STAFF CREDIT (F3)"
                                Style="{StaticResource PaymentModeButtonStyle}" />
                            <Button
                                Command="{Binding SelectPaymentMethodCommand}"
                                CommandParameter="{x:Static enums:SalesPaymentMethod.BANK_TRANSFER}"
                                Content="BANK TRANSFER (F4)"
                                Style="{StaticResource PaymentModeButtonStyle}" />
                        </UniformGrid>

                        <Border
                            x:Name="PaymentPanel"
                            Margin="0,0,0,14"
                            Style="{StaticResource PaymentPanelBorderStyle}"
                            Visibility="{Binding IsPaymentInputVisible, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid MinHeight="132" Visibility="{Binding IsPaymentTypeCash, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Margin="0,0,0,10"
                                        Style="{StaticResource PaymentHeaderStyle}"
                                        Text="CASH" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0,0,0,6"
                                        Style="{StaticResource InputLabelStyle}"
                                        Text="Customer Gave:" />

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox
                                            x:Name="TxtAmountGiven"
                                            DataObject.Pasting="DecimalAmount_Pasting"
                                            InputScope="Number"
                                            PreviewTextInput="DecimalAmount_PreviewTextInput"
                                            Style="{StaticResource CashInputStyle}"
                                            Text="{Binding CurrentPaymentAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />

                                        <Button
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Command="{Binding AddPaymentCommand}"
                                            Content="ADD"
                                            Style="{StaticResource AddPaymentButtonStyle}" />
                                    </Grid>

                                    <TextBlock
                                        Grid.Row="3"
                                        Style="{StaticResource PaymentErrorTextStyle}"
                                        Text="{Binding PaymentErrorMessage}" />
                                </Grid>

                                <Grid MinHeight="180" Visibility="{Binding IsPaymentTypeCard, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Margin="0,0,0,10"
                                        Style="{StaticResource PaymentHeaderStyle}"
                                        Text="CARD PAYMENT" />

                                    <Grid Grid.Row="1" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock
                                                Margin="0,0,0,6"
                                                Style="{StaticResource InputLabelStyle}"
                                                Text="Select Terminal:" />
                                            <ComboBox
                                                DisplayMemberPath="TerminalName"
                                                ItemsSource="{Binding PaymentTerminals}"
                                                SelectedItem="{Binding SelectedPaymentTerminal, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, ValidatesOnNotifyDataErrors=True}"
                                                Style="{StaticResource PaymentTerminalStyle}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock
                                                Margin="0,0,0,6"
                                                Style="{StaticResource InputLabelStyle}"
                                                Text="Reference No / Auth Code (4 digits):" />
                                            <TextBox
                                                x:Name="CardReferenceNumberTextBox"
                                                DataObject.Pasting="DigitsOnly_Pasting"
                                                InputScope="Number"
                                                MaxLength="4"
                                                PreviewTextInput="DigitsOnly_PreviewTextInput"
                                                Style="{StaticResource CashInputStyle}"
                                                Text="{Binding ReferenceNumber, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                TextAlignment="Left" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock
                                        Grid.Row="2"
                                        Margin="0,0,0,6"
                                        Style="{StaticResource InputLabelStyle}"
                                        Text="Amount:" />

                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox
                                            DataObject.Pasting="DecimalAmount_Pasting"
                                            InputScope="Number"
                                            PreviewTextInput="DecimalAmount_PreviewTextInput"
                                            Style="{StaticResource CashInputStyle}"
                                            Text="{Binding CurrentPaymentAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />

                                        <Button
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Command="{Binding AddPaymentCommand}"
                                            Content="ADD"
                                            Style="{StaticResource AddPaymentButtonStyle}" />
                                    </Grid>

                                    <TextBlock
                                        Grid.Row="4"
                                        Style="{StaticResource PaymentErrorTextStyle}"
                                        Text="{Binding PaymentErrorMessage}" />
                                </Grid>

                                <Grid MinHeight="160" Visibility="{Binding IsPaymentTypeCredit, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Margin="0,0,0,10"
                                        Style="{StaticResource PaymentHeaderStyle}"
                                        Text="STAFF CREDIT" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0,0,0,6"
                                        Style="{StaticResource InputLabelStyle}"
                                        Text="Reference (Signee / PO / Emp ID):" />

                                    <Grid Grid.Row="2" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox
                                            x:Name="StoreCreditReferenceNumberTextBox"
                                            Grid.Column="0"
                                            DataObject.Pasting="AlphanumericOnly_Pasting"
                                            MaxLength="50"
                                            PreviewTextInput="AlphanumericOnly_PreviewTextInput"
                                            Style="{StaticResource CashInputStyle}"
                                            Text="{Binding ReferenceNumber, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                            TextAlignment="Left" />

                                        <Button
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Command="{Binding AddPaymentCommand}"
                                            Content="ADD"
                                            Style="{StaticResource AddPaymentButtonStyle}" />
                                    </Grid>

                                    <Border
                                        Grid.Row="3"
                                        Margin="0,0,0,10"
                                        Padding="10,8"
                                        Background="#FFFBEB"
                                        BorderBrush="{StaticResource WarningBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource WarningBrush}"
                                            Text="Requires Customer Selection"
                                            TextWrapping="Wrap" />
                                    </Border>

                                    <TextBlock
                                        Grid.Row="4"
                                        Style="{StaticResource PaymentErrorTextStyle}"
                                        Text="{Binding PaymentErrorMessage}" />
                                </Grid>

                                <Grid MinHeight="180" Visibility="{Binding IsPaymentTypeBankTransfer, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Grid.Row="0"
                                        Margin="0,0,0,10"
                                        Style="{StaticResource PaymentHeaderStyle}"
                                        Text="BANK TRANSFER" />

                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="0,0,0,6"
                                        Style="{StaticResource InputLabelStyle}"
                                        Text="Transaction Ref / Slip No:" />

                                    <TextBox
                                        Grid.Row="2"
                                        Margin="0,0,0,10"
                                        DataObject.Pasting="AlphanumericOnly_Pasting"
                                        MaxLength="50"
                                        PreviewTextInput="AlphanumericOnly_PreviewTextInput"
                                        Style="{StaticResource CashInputStyle}"
                                        Text="{Binding ReferenceNumber, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                        TextAlignment="Left" />

                                    <TextBlock
                                        Grid.Row="3"
                                        Margin="0,0,0,6"
                                        Style="{StaticResource InputLabelStyle}"
                                        Text="Amount:" />

                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox
                                            DataObject.Pasting="DecimalAmount_Pasting"
                                            InputScope="Number"
                                            PreviewTextInput="DecimalAmount_PreviewTextInput"
                                            Style="{StaticResource CashInputStyle}"
                                            Text="{Binding CurrentPaymentAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />

                                        <Button
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Command="{Binding AddPaymentCommand}"
                                            Content="ADD"
                                            Style="{StaticResource AddPaymentButtonStyle}" />
                                    </Grid>

                                    <TextBlock
                                        Grid.Row="5"
                                        Style="{StaticResource PaymentErrorTextStyle}"
                                        Text="{Binding PaymentErrorMessage}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <StackPanel Margin="0,0,0,14" Visibility="{Binding IsPaymentWorkflowVisible, Converter={StaticResource BoolToVisibility}}">
                            <Border
                                Margin="0,0,0,10"
                                Style="{StaticResource AppliedPaymentsBorderStyle}"
                                Visibility="{Binding IsPaymentGridVisible, Converter={StaticResource BoolToVisibility}}">
                                <DataGrid
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    CanUserDeleteRows="False"
                                    CanUserResizeRows="False"
                                    HeadersVisibility="Column"
                                    ItemsSource="{Binding AppliedPayments}"
                                    SelectionMode="Single"
                                    Style="{StaticResource AppliedPaymentsDataGridStyle}"
                                    Visibility="{Binding IsPaymentGridVisible, Converter={StaticResource BoolToVisibility}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Width="*"
                                            Binding="{Binding PaymentMethod}"
                                            Header="Method"
                                            IsReadOnly="True" />
                                        <DataGridTextColumn
                                            Width="110"
                                            Binding="{Binding Amount, StringFormat='Rs. {0:N2}'}"
                                            Header="Amount"
                                            HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}"
                                            IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextAlignment" Value="Right" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn
                                            Width="90"
                                            Binding="{Binding ReferenceNumber}"
                                            Header="Ref"
                                            IsReadOnly="True" />
                                        <DataGridTemplateColumn Width="42" Header="Action">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding DataContext.RemovePaymentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource DeleteButtonStyle}"
                                                        ToolTip="Remove payment" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <Border Style="{StaticResource ChangeBorderStyle}">
                                <Grid>
                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Text="REMAINING:">
                                        <TextBlock.Style>
                                            <Style BasedOn="{StaticResource ChangeLabelTextStyle}" TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasRemainingBalance}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Text="CHANGE DUE:">
                                        <TextBlock.Style>
                                            <Style BasedOn="{StaticResource ChangeLabelTextStyle}" TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasRemainingBalance}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Text="{Binding RemainingBalance, StringFormat='Rs. {0:N2}'}">
                                        <TextBlock.Style>
                                            <Style BasedOn="{StaticResource ChangeAmountTextStyle}" TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasRemainingBalance}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Text="{Binding ChangeDueAmount, StringFormat='Rs. {0:N2}'}">
                                        <TextBlock.Style>
                                            <Style BasedOn="{StaticResource ChangeAmountTextStyle}" TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasRemainingBalance}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="2" Visibility="Collapsed">
                        <Button
                            Command="{Binding SaveSaleCommand}"
                            Content="SEND SMS (F5)"
                            Style="{StaticResource SMSButtonStyle}" />
                        <Button
                            Command="{Binding SaveAndPrintCommand}"
                            Content="SAVE &amp; PRINT (F6)"
                            Style="{StaticResource PrintButtonStyle}" />
                    </Grid>

                    <Grid Grid.Row="2" Visibility="Collapsed">
                        <Border Style="{StaticResource KeypadBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <UniformGrid Columns="3" Style="{StaticResource KeypadGridStyle}">
                                    <Button
                                        Click="NumberButton_Click"
                                        Content="7"
                                        Style="{StaticResource NumberButtonStyle}" />
                                    <Button
                                        Click="NumberButton_Click"
                                        Content="8"
                                        Style="{StaticResource NumberButtonStyle}" />
                                    <Button
                                        Click="NumberButton_Click"
                                        Content="9"
                                        Style="{StaticResource NumberButtonStyle}" />
                                    <Button
                                        Click="NumberButton_Click"
                                        Content="4"
                                        Style="{StaticResource NumberButtonStyle}" />
                                    <Button
                                        Click="NumberButton_Click"
                                        Content="5"
                                        Style="{StaticResource NumberButtonStyle}" />
                                    <Button
                                        Click="NumberButton_Click"
                                        Content="6"
                                        Style="{StaticResource NumberButtonStyle}" />
                                    <Button
                                        Click="NumberButton_Click"
                                        Content="1"
                                        Style="{StaticResource NumberButtonStyle}" />
                                    <Button
                                        Click="NumberButton_Click"
                                        Content="2"
                                        Style="{StaticResource NumberButtonStyle}" />
                                    <Button
                                        Click="NumberButton_Click"
                                        Content="3"
                                        Style="{StaticResource NumberButtonStyle}" />
                                    <Button
                                        Click="ClearKeyButton_Click"
                                        Content="C"
                                        Style="{StaticResource ClearKeyButtonStyle}" />
                                    <Button
                                        Click="NumberButton_Click"
                                        Content="0"
                                        Style="{StaticResource NumberButtonStyle}" />
                                    <Button
                                        Click="NumberButton_Click"
                                        Content="."
                                        Style="{StaticResource NumberButtonStyle}" />
                                </UniformGrid>

                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Button
                                        Grid.Row="0"
                                        Click="BackspaceButton_Click"
                                        Style="{StaticResource NumberButtonStyle}"
                                        ToolTip="Backspace">
                                        <Viewbox Width="20" Height="20">
                                            <Path Data="M22,3H7C6.31,3 5.77,3.35 5.41,3.88L0,12L5.41,20.12C5.77,20.65 6.31,21 7,21H22C23.11,21 24,20.11 24,19V5C24,3.89 23.11,3 22,3M19,15.59L17.59,17L14,13.41L10.41,17L9,15.59L12.59,12L9,8.41L10.41,7L14,10.59L17.59,7L19,8.41L15.41,12L19,15.59Z" Fill="{StaticResource Brush.Text.Primary}" />
                                        </Viewbox>
                                    </Button>

                                    <Button
                                        Grid.Row="1"
                                        Grid.RowSpan="3"
                                        Height="Auto"
                                        Background="#2563EB"
                                        BorderBrush="#2563EB"
                                        Click="EnterKeyButton_Click"
                                        Foreground="White"
                                        Style="{StaticResource NumberButtonStyle}"
                                        ToolTip="Enter">
                                        <Viewbox Width="26" Height="26">
                                            <Path Data="M19,7V11H5.83L8.42,8.41L7,7L2,12L7,17L8.41,15.59L5.83,13H21V7H19Z" Fill="White" />
                                        </Viewbox>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.Resources>
                            <Style x:Key="BottomActionButtonStyle" TargetType="Button">
                                <Setter Property="Height" Value="58" />
                                <Setter Property="FontSize" Value="16" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="8"
                                                SnapsToDevicePixels="True">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Opacity" Value="0.92" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Opacity" Value="0.84" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Grid.Resources>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.25*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Margin="0,0,6,0"
                            Background="#F59E0B"
                            Command="{Binding PrintPreBillCommand}"
                            Content="Print Pre-Bill"
                            Style="{StaticResource BottomActionButtonStyle}" />

                        <Button
                            Grid.Column="1"
                            Margin="6,0,6,0"
                            Background="#2563EB"
                            Command="{Binding RecallHeldSaleCommand}"
                            Content="Recall Bills"
                            Style="{StaticResource BottomActionButtonStyle}" />

                        <Button
                            Grid.Column="2"
                            Margin="6,0,0,0"
                            Background="#16A34A"
                            Command="{Binding SaveAndPrintCommand}"
                            Content="Settle / Pay"
                            Style="{StaticResource BottomActionButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
