<UserControl
    x:Class="PointOfSale.UI.Views.Sales.SalesPersonView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="650"
    d:DesignWidth="1100"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource HeaderTextStyle}" Text="Sales Person Management" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Margin="0,0,8,0"
                IsEnabled="{Binding IsFormEnabled}"
                Style="{StaticResource PanelCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource SubHeaderTextStyle}" Text="Sales Person Form" />

                            <TextBlock Style="{StaticResource LabelStyle}" Text="Code:" />
                            <TextBox
                                x:Name="SalesPersonCodeTextBox"
                                IsReadOnly="True"
                                IsTabStop="False"
                                PreviewKeyDown="MoveFocusOnEnter"
                                Style="{StaticResource TextBoxStyle}"
                                Text="{Binding Code, Mode=OneWay}"
                                ToolTip="Generated automatically when the sales person is saved." />

                            <TextBlock Style="{StaticResource LabelStyle}" Text="Name:" />
                            <TextBox
                                x:Name="SalesPersonNameTextBox"
                                MaxLength="100"
                                PreviewKeyDown="MoveFocusOnEnter"
                                Style="{StaticResource TextBoxStyle}"
                                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                            <TextBlock Style="{StaticResource LabelStyle}" Text="Email:" />
                            <TextBox
                                MaxLength="150"
                                PreviewKeyDown="MoveFocusOnEnter"
                                Style="{StaticResource TextBoxStyle}"
                                Text="{Binding Email, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                            <TextBlock Style="{StaticResource LabelStyle}" Text="NIC:" />
                            <TextBox
                                MaxLength="20"
                                PreviewKeyDown="MoveFocusOnEnter"
                                Style="{StaticResource TextBoxStyle}"
                                Text="{Binding NIC, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                            <TextBlock Style="{StaticResource LabelStyle}" Text="Contact Number:" />
                            <TextBox
                                MaxLength="15"
                                PreviewKeyDown="MoveFocusOnEnter"
                                Style="{StaticResource TextBoxStyle}"
                                Text="{Binding ContactNo, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                            <TextBlock Style="{StaticResource LabelStyle}" Text="Address:" />
                            <TextBox
                                MinHeight="64"
                                AcceptsReturn="True"
                                MaxLength="255"
                                Style="{StaticResource TextBoxStyle}"
                                Text="{Binding Address, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto" />

                            <CheckBox
                                Content="Is Active"
                                IsChecked="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}"
                                PreviewKeyDown="MoveFocusOnEnter"
                                Style="{StaticResource CheckBoxStyle}" />
                        </StackPanel>
                    </ScrollViewer>

                    <Border
                        Grid.Row="1"
                        Margin="0,20,0,0"
                        Padding="15"
                        VerticalAlignment="Top"
                        BorderBrush="#E0E0E0">
                        <StackPanel Orientation="Horizontal">
                            <Button
                                Margin="0,0,12,0"
                                Click="SubmitButton_Click"
                                Command="{Binding SaveCommand}"
                                Content="{Binding SaveButtonText}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                            <Button
                                Command="{Binding EditCommand}"
                                Content="Edit"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Margin="0"
                Style="{StaticResource PanelCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Padding="12,8" Background="#F1F2F6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Margin="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource SubHeaderTextStyle}"
                                Text="Sales Person List" />
                            <Button
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Command="{Binding LoadCommand}"
                                Style="{StaticResource RefreshButtonStyle}"
                                ToolTip="Refresh Sales Person List" />
                            <TextBox
                                Grid.Column="2"
                                Height="32"
                                MinWidth="100"
                                MaxWidth="320"
                                Margin="8,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource SearchTextBoxStyle}"
                                Tag="Search by Code, Name, Email, NIC or Phone..."
                                Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Column="3"
                                Command="{Binding NewCommand}"
                                Content="New"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>
                    </Border>

                    <DataGrid
                        Grid.Row="1"
                        Margin="0,4,0,0"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsEnabled="{Binding IsFormEnabled}"
                        IsReadOnly="True"
                        ItemsSource="{Binding SalesPersonList}"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        SelectedItem="{Binding SelectedSalesPerson, UpdateSourceTrigger=PropertyChanged}"
                        SelectionMode="Single"
                        Style="{StaticResource DataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="60"
                                MinWidth="60"
                                Binding="{Binding Id}"
                                Header="ID" />
                            <DataGridTextColumn
                                Width="110"
                                MinWidth="110"
                                Binding="{Binding Code}"
                                Header="Code" />
                            <DataGridTextColumn
                                Width="*"
                                MinWidth="180"
                                Binding="{Binding Name}"
                                Header="Name" />
                            <DataGridTextColumn
                                Width="200"
                                MinWidth="200"
                                Binding="{Binding Email}"
                                Header="Email" />
                            <DataGridTextColumn
                                Width="130"
                                MinWidth="130"
                                Binding="{Binding NIC}"
                                Header="NIC" />
                            <DataGridTextColumn
                                Width="140"
                                MinWidth="140"
                                Binding="{Binding ContactNo}"
                                Header="Contact Number" />
                            <DataGridTextColumn
                                Width="220"
                                MinWidth="220"
                                Binding="{Binding Address}"
                                Header="Address">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridCheckBoxColumn
                                Width="70"
                                MinWidth="70"
                                Binding="{Binding IsActive, Mode=OneWay}"
                                Header="Active" />
                            <DataGridTextColumn
                                Width="100"
                                MinWidth="100"
                                Binding="{Binding CreateBy}"
                                Header="Created By" />
                            <DataGridTextColumn
                                Width="160"
                                MinWidth="160"
                                Binding="{Binding CreateAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                Header="Created At" />
                            <DataGridTextColumn
                                Width="100"
                                MinWidth="100"
                                Binding="{Binding UpdateBy}"
                                Header="Updated By" />
                            <DataGridTextColumn
                                Width="160"
                                MinWidth="160"
                                Binding="{Binding UpdateAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                Header="Updated At" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
