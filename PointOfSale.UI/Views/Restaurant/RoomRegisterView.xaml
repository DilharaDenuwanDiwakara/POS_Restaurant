<UserControl x:Class="PointOfSale.UI.Views.Restaurant.RoomRegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1100">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Room Registration" Style="{StaticResource HeaderTextStyle}"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="285"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Room Form" Style="{StaticResource SubHeaderTextStyle}"/>

                    <TextBlock Text="Room Image" Style="{StaticResource LabelStyle}"/>

                    <Border Height="200" Background="#F1F2F6" CornerRadius="6" Margin="0,0,0,8" BorderBrush="#E0E0E0" BorderThickness="1">
                        <Grid>
                            <Image Source="{Binding RoomImageUrl}" Stretch="UniformToFill"/>
                            <TextBlock Text="No Image"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Foreground="#A0A0A0"
                                       Visibility="{Binding RoomImageUrl, Converter={StaticResource NullToVisibilityConverter}}"/>
                        </Grid>
                    </Border>

                    <Button Content="Upload Image"
                            Command="{Binding UploadImageCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,0,12"
                            Width="Auto"/>

                    <TextBlock Text="Room Name:" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="RoomNameTextBox"
                             Text="{Binding RoomName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                             MaxLength="100"
                             CharacterCasing="Upper"
                             Style="{StaticResource TextBoxStyle}"
                             PreviewKeyDown="MoveFocusOnEnter"/>

                    <TextBlock Text="Description:" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding RoomDescription, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="250"
                             Style="{StaticResource TextBoxStyle}"
                             PreviewKeyDown="MoveFocusOnEnter"/>

                    <TextBlock Text="Capacity:" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding RoomCapacity, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                             MaxLength="3"
                             Style="{StaticResource TextBoxStyle}"
                             GotFocus="SelectAllText_GotFocus"
                             PreviewKeyDown="MoveFocusOnEnter"/>

                    <TextBlock Text="Floor Number:" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding RoomFloorNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                             MaxLength="3"
                             Style="{StaticResource TextBoxStyle}"
                             GotFocus="SelectAllText_GotFocus"
                             PreviewKeyDown="MoveFocusOnEnter"/>

                    <TextBlock Text="Type:" Style="{StaticResource LabelStyle}"/>
                    <ComboBox ItemsSource="{Binding RoomTypes}"
                              SelectedItem="{Binding RoomType, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                              Style="{StaticResource ComboBoxStyle}"
                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                              PreviewKeyDown="MoveFocusOnEnter"/>

                    <TextBlock Text="Status:" Style="{StaticResource LabelStyle}"/>
                    <ComboBox ItemsSource="{Binding RoomStatuses}"
                              SelectedItem="{Binding RoomStatus, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                              Style="{StaticResource ComboBoxStyle}"
                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                              PreviewKeyDown="MoveFocusOnEnter"/>

                    <CheckBox Content="Active"
                              IsChecked="{Binding RoomIsActive}"
                              Margin="0,8,0,0"
                              PreviewKeyDown="MoveFocusOnEnter"
                              Style="{StaticResource CheckBoxStyle}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Center">
                        <Button Content="{Binding SaveButtonText}"
                                Command="{Binding SaveRoomCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,10,0"
                                Click="SubmitButton_Click"/>

                        <Button Content="Edit"
                                Command="{Binding EditRoomCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="#F1F2F6" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Room List" Style="{StaticResource SubHeaderTextStyle}" Margin="0" VerticalAlignment="Center"/>

                            <Button Grid.Column="1"
                                    Command="{Binding RefreshRoomsCommand}"
                                    Style="{StaticResource RefreshButtonStyle}"
                                    ToolTip="Refresh Room List"
                                    Margin="10 0 0 0"/>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding RoomList}"
                              SelectedItem="{Binding SelectedRoom, UpdateSourceTrigger=PropertyChanged}"
                              AutoGenerateColumns="False"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              Style="{StaticResource DataGridStyle}"
                              Margin="0,4,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto" Visibility="Hidden"/>
                            <DataGridTextColumn Header="Room" Binding="{Binding Name}" Width="aUTO"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                            
                            <DataGridTextColumn Header="Floor" Binding="{Binding FloorNumber}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Max Capacity" Binding="{Binding MaxCapacity}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="150"/>
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="80"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
