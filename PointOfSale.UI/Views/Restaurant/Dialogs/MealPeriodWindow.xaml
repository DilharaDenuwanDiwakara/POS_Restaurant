<Window x:Class="PointOfSale.UI.Views.Restaurant.Dialogs.MealPeriodWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Height="470" Width="860">

    <Border Style="{StaticResource WindowBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource Brush.Structure.Sidebar}"
                    CornerRadius="8,8,0,0"
                    Padding="10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Meal Period"
                                   Foreground="{StaticResource Brush.Text.OnDark}"
                                   Style="{StaticResource HeaderTextStyle}"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource IconOnlyButtonStyle}"
                            Background="Transparent"
                            Click="CloseButton_Click"
                            ToolTip="Close">
                        <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                              Fill="{StaticResource Brush.Text.OnDark}"
                              Width="12" Height="12" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Meal Period Form" Style="{StaticResource SubHeaderTextStyle}" Margin="0,0,0,12"/>

                        <TextBlock Text="Meal Period Name:" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="MealPeriodNameTextBox"
                                 Text="{Binding MealPeriodName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 MaxLength="100"
                                 CharacterCasing="Upper"
                                 Style="{StaticResource TextBoxStyle}"
                                 PreviewKeyDown="MoveFocusOnEnter"/>

                        <TextBlock Text="Start Time: (HH:mm - 24Hrs)" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="StartTimeTextBox"
                                 Text="{Binding StartTimeText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"
                                 MaxLength="5"
                                 ToolTip="HH:mm"
                                 Style="{StaticResource TextBoxStyle}"
                                 PreviewTextInput="TimeTextBox_PreviewTextInput"
                                 DataObject.Pasting="TimeTextBox_Pasting"
                                 PreviewKeyDown="MoveFocusOnEnter"/>

                        <TextBlock Text="End Time:   (HH:mm - 24Hrs)" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="EndTimeTextBox"
                                 Text="{Binding EndTimeText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"
                                 MaxLength="5"
                                 ToolTip="HH:mm"
                                 Style="{StaticResource TextBoxStyle}"
                                 PreviewTextInput="TimeTextBox_PreviewTextInput"
                                 DataObject.Pasting="TimeTextBox_Pasting"
                                 PreviewKeyDown="MoveFocusOnEnter"/>

                        <CheckBox Content="Is Active"
                                  IsChecked="{Binding IsActive}"
                                  Style="{StaticResource CheckBoxStyle}"
                                  Margin="0,8,0,0"/>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Center">
                            <Button Content="{Binding SaveButtonText}"
                                    Command="{Binding SaveCommand}"
                                    Click="Save_Click"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="0,0,12,0"/>

                            <Button Content="Edit"
                                    Command="{Binding EditCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"/>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Background="#F1F2F6" Padding="12,8">
                            <TextBlock Text="Meal Period List"
                                       Style="{StaticResource SubHeaderTextStyle}"
                                       VerticalAlignment="Center"
                                       Margin="0"/>
                        </Border>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding MealPeriodList}"
                                  SelectedItem="{Binding SelectedMealPeriod, UpdateSourceTrigger=PropertyChanged}"
                                  AutoGenerateColumns="False"
                                  SelectionMode="Single"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  Style="{StaticResource DataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto" Visibility="Hidden"/>
                                <DataGridTextColumn Header="Meal Period" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Start Time" Binding="{Binding DefaultStartTime, StringFormat={}{0:hh\\:mm}}" Width="120"/>
                                <DataGridTextColumn Header="End Time" Binding="{Binding DefaultEndTime, StringFormat={}{0:hh\\:mm}}" Width="120"/>
                                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
    
</Window>
