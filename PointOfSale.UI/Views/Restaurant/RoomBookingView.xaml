<UserControl x:Class="PointOfSale.UI.Views.Restaurant.RoomBookingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="1100">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Room Booking" Style="{StaticResource HeaderTextStyle}"/>

        <Grid Grid.Row="1" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="285"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel -->
            <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Booking Form" Style="{StaticResource SubHeaderTextStyle}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,0,0">
                            <TextBlock Text="Room:" Style="{StaticResource LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding BookableRooms}"
                                      SelectedItem="{Binding SelectedBookingRoom, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource ComboBoxStyle}"
                                      ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                      PreviewKeyDown="MoveFocusOnEnter"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Margin="0,8,0,0"
                                Command="{Binding RefreshRoomsCommand}"
                                Style="{StaticResource RefreshButtonStyle}"
                                ToolTip="Refresh Active Rooms"
                                Visibility="Collapsed"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="No. Of Pax:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding BookingNumberOfPax, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                     MaxLength="4"
                                     Style="{StaticResource TextBoxStyle}"
                                     PreviewKeyDown="MoveFocusOnEnter"
                                     GotFocus="SelectAllText_GotFocus"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Meal Period:" Style="{StaticResource LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding MealPeriods}"
                                      SelectedItem="{Binding SelectedMealPeriod, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource ComboBoxStyle}"
                                      ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                      PreviewKeyDown="MoveFocusOnEnter"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Margin="0,8,4,0"
                                Command="{Binding AddMealPeriodCommand}"
                                ToolTip="Add New Meal Period"
                                VerticalAlignment="Center"
                                Focusable="False"
                                Style="{StaticResource AddButtonStyle}"/>

                        <Button Grid.Column="2"
                                Margin="0,8,0,0"
                                Command="{Binding RefreshMealPeriodsCommand}"
                                Style="{StaticResource RefreshButtonStyle}"
                                ToolTip="Refresh Meal Periods"
                                Visibility="Collapsed"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="From Date:" Style="{StaticResource LabelStyle}"/>
                            <DatePicker SelectedDate="{Binding FromDate, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"
                                        Style="{StaticResource DatePickerStyle}"
                                        PreviewKeyDown="MoveFocusOnEnter"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="From Time: (24Hrs)" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="FromTimeTextBox"
                                     Text="{Binding FromTimeText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"
                                     MaxLength="5"
                                     Style="{StaticResource TextBoxStyle}"
                                     ToolTip="HH:mm"
                                     PreviewTextInput="TimeTextBox_PreviewTextInput"
                                     DataObject.Pasting="TimeTextBox_Pasting"
                                     PreviewKeyDown="MoveFocusOnEnter"
                                     GotFocus="SelectAllText_GotFocus"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="To Date:" Style="{StaticResource LabelStyle}"/>
                            <DatePicker SelectedDate="{Binding ToDate, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"
                                        Style="{StaticResource DatePickerStyle}"
                                        PreviewKeyDown="MoveFocusOnEnter"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="To Time:     (24Hrs)" Style="{StaticResource LabelStyle}"/>
                            <TextBox x:Name="ToTimeTextBox"
                                     Text="{Binding ToTimeText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"
                                     MaxLength="5"
                                     Style="{StaticResource TextBoxStyle}"
                                     ToolTip="HH:mm"
                                     PreviewTextInput="TimeTextBox_PreviewTextInput"
                                     DataObject.Pasting="TimeTextBox_Pasting"
                                     PreviewKeyDown="MoveFocusOnEnter"
                                     GotFocus="SelectAllText_GotFocus"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Customer Phone:" Style="{StaticResource LabelStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding BookingCustomerPhoneNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 MaxLength="10"
                                 Style="{StaticResource TextBoxStyle}"
                                 PreviewKeyDown="MoveFocusOnEnter"/>
                        <Button Grid.Column="1"
                                Content="Search"
                                Command="{Binding SearchCustomerCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="80"
                                Margin="4,0,0,0"/>
                    </Grid>

                    <TextBlock Text="Customer Name:" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding BookingCustomerName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                             MaxLength="100"
                             IsReadOnly="{Binding IsCustomerNameReadOnly}"
                             Style="{StaticResource TextBoxStyle}"
                             PreviewKeyDown="MoveFocusOnEnter"/>

                    <TextBlock Text="Booking Status:" Style="{StaticResource LabelStyle}" Margin="0,8,0,0"/>
                    <TextBox Text="{Binding SelectedStatus, Mode=OneWay}"
                             IsEnabled="False"
                             Style="{StaticResource TextBoxStyle}"/>

                    <TextBlock Text="Remarks:" Style="{StaticResource LabelStyle}" Margin="0,8,0,0"/>
                    <TextBox Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="60"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Style="{StaticResource TextBoxStyle}"
                             PreviewKeyDown="MoveFocusOnEnter"/>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0" >
                        <Button Content="Save"
                                Command="{Binding SaveBookingCommand}"
                                Width="120"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,10,0"/>
                        
                        <Button Content="New"
                                Command="{Binding NewBookingCommand}"
                                Width="120"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Right Panel -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border  Style="{StaticResource PanelCardStyle}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Background="#F1F2F6" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Bookings" Style="{StaticResource SubHeaderTextStyle}" Margin="0" VerticalAlignment="Center"/>

                                <Button Grid.Column="1"
                                        Command="{Binding RefreshBookingsCommand}"
                                        Style="{StaticResource RefreshButtonStyle}"
                                        ToolTip="Refresh Bookings"
                                        Margin="10,0,0,0"/>

                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding BookingList}"
                                  SelectedItem="{Binding SelectedBooking, UpdateSourceTrigger=PropertyChanged}"
                                  AutoGenerateColumns="False"
                                  SelectionMode="Single"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  Style="{StaticResource DataGridStyle}"
                                  Margin="0,4,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto" Visibility="Collapsed"/>
                                <DataGridTextColumn Header="Room" Binding="{Binding RoomName}" Width="150"/>
                                <DataGridTextColumn Header="Meal Period" Binding="{Binding MealPeriodName}" Width="150"/>
                                <DataGridTextColumn Header="From" Binding="{Binding From, StringFormat=dd-MMM-yyyy HH:mm}" Width="150"/>
                                <DataGridTextColumn Header="To" Binding="{Binding To, StringFormat=dd-MMM-yyyy HH:mm}" Width="150"/>
                                <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/>
                                <DataGridTextColumn Header="Phone" Binding="{Binding CustomerPhoneNumber}" Width="120"/>
                                <DataGridTextColumn Header="Pax" Binding="{Binding NumberOfPax}" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                <DataGridTextColumn Header="Advance" Binding="{Binding AdvancePayment, StringFormat='Rs. {0:N2}'}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource PanelCardStyle}" Margin="0 4 0 0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Export PDF"
                                Command="{Binding GenerateBookingReportCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,0"
                                Visibility="Collapsed"/>

                        <Button Content="Pay Advance"
                                Command="{Binding AddAdvancePaymentCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="130"
                                Margin="0,0,8,0"
                                Visibility="{Binding IsPayAdvanceVisible, Converter={StaticResource BoolToVisConverter}}"/>

                        <Button Content="Check-In"
                                Command="{Binding CheckInCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="130"
                                Margin="0,0,8,0"
                                Visibility="{Binding IsCheckInVisible, Converter={StaticResource BoolToVisConverter}}"/>

                        <Button Content="Cancel Booking"
                                Command="{Binding CancelBookingCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="130"/>

                    </StackPanel>
                </Border>
            </Grid>
            
        </Grid>
    </Grid>
</UserControl>
