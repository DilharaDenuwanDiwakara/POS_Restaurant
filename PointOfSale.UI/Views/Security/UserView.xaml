<UserControl x:Class="PointOfSale.UI.Views.Security.UserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PointOfSale.UI.Views.Security" 
             mc:Ignorable="d" 
             d:DesignHeight="520" d:DesignWidth="800">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="1" Style="{StaticResource TabControlStyle}" 
                    SelectedIndex="{Binding SelectedTabIndex}">

            <TabItem Style="{StaticResource TabItemStyle}" Header="User Details" Margin="0 0 0 4">
                <!-- Main Content -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="285"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Panel - Form -->
                    <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="User Form" Style="{StaticResource SubHeaderTextStyle}" Margin="0,0,0,12"/>

                            <!-- Full Name -->
                            <TextBlock Text="Full Name:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Name="FullNameTextBox"
                                     Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                     MaxLength="100"
                                     Style="{StaticResource TextBoxStyle}" 
                                     PreviewKeyDown="MoveFocusOnEnter"/>

                            <!-- Username -->
                            <TextBlock Text="Username:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                     MaxLength="50"
                                     Style="{StaticResource TextBoxStyle}"
                                     PreviewKeyDown="MoveFocusOnEnter"/>

                            <!-- Password -->
                            <TextBlock Text="Password:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                     MaxLength="10"
                                     Style="{StaticResource TextBoxStyle}"
                                     PreviewKeyDown="MoveFocusOnEnter"/>

                            <!-- PIN Code (used for quick cashier/waiter login and manager PIN authorization) -->
                            <TextBlock Text="PIN Code:" Style="{StaticResource LabelStyle}"/>
                            <TextBox Name="PinTextBox"
                                     Text="{Binding Pin, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                     MaxLength="3"
                                     Style="{StaticResource TextBoxStyle}"
                                     PreviewTextInput="PinTextBox_PreviewTextInput"
                                     PreviewKeyDown="MoveFocusOnEnter"/>

                            <!-- Role -->
                            <TextBlock Text="Role:" Style="{StaticResource LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Roles}"
                                      SelectedValue="{Binding RoleId, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, ValidatesOnNotifyDataErrors=True}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource ComboBoxStyle}"
                                      ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                      PreviewKeyDown="MoveFocusOnEnter"/>

                            <TextBlock Text="Branch:" Style="{StaticResource LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Branches}"
                                        SelectedValue="{Binding BranchId, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, ValidatesOnNotifyDataErrors=True}"
                                        SelectedValuePath="Id"
                                        DisplayMemberPath="Name"
                                        SelectedIndex="0"
                                        Style="{StaticResource ComboBoxStyle}"
                                        ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                        PreviewKeyDown="MoveFocusOnEnter"/>

                            <!-- Is Active -->
                            <CheckBox Content="Is Active"
                                      IsChecked="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource CheckBoxStyle}"
                                      Focusable="False"/>

                            <!-- Action Buttons -->
                            <StackPanel Orientation="Horizontal" Margin="0,24,0,0" HorizontalAlignment="Center">
                                <Button Name="SubmitButton"
                                        Content="{Binding SaveButtonText}"
                                        Command="{Binding SaveUserCommand}" 
                                        Style="{StaticResource PrimaryButtonStyle}" 
                                        Click="SubmitButton_Click"
                                        Margin="0,0,10,0"/>

                                <Button Content="Edit" 
                                        Command="{Binding EditUserCommand}" 
                                        Style="{StaticResource SecondaryButtonStyle}"/>
                                
                            </StackPanel>

                        </StackPanel>
                    </Border>

                    <!-- Right Panel - Data Grid -->
                    <Border Grid.Column="2" Style="{StaticResource PanelCardStyle}" Margin="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Background="#F1F2F6" Padding="12,6" Margin="0 0 0 8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Users List" 
                                               Style="{StaticResource SubHeaderTextStyle}" 
                                               Margin="0"
                                               VerticalAlignment="Center"/>

                                    <Button Grid.Column="1"
                                            Command="{Binding LoadUserCommand}" 
                                            Style="{StaticResource RefreshButtonStyle}" 
                                            ToolTip="Refresh Users"
                                            Margin="12,0,0,0"/>

                                    <Button Grid.Column="3"
                                            Command="{Binding DeleteUserCommand}" 
                                            Style="{StaticResource DeleteButtonStyle}" 
                                            ToolTip="Delete User"/>
                                    
                                </Grid>
                            </Border>

                            <!-- Data Grid -->
                            <DataGrid Grid.Row="1" 
                                      ItemsSource="{Binding UserList}" 
                                      SelectedItem="{Binding SelectedUser, UpdateSourceTrigger=PropertyChanged}"
                                      AutoGenerateColumns="False"
                                      SelectionMode="Single"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      Style="{StaticResource DataGridStyle}">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding UserId}" Width="Auto" Visibility="Hidden"/>
                                    <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="*"/>
                                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="150"/>
                                    <DataGridTextColumn Header="PasswordHash" Binding="{Binding PasswordHash}" Width="*" />
                                    <DataGridTextColumn Header="PIN" Binding="{Binding Pin, Converter={StaticResource PinMaskConverter}}" Width="70"/>
                                    <DataGridTextColumn Header="Role" Binding="{Binding RoleName}" Width="150"/>
                                    <DataGridTextColumn Header="Branch" Binding="{Binding BranchName}" Width="150"/>
                                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>

                        </Grid>
                    </Border>

                </Grid>
            </TabItem>

            <TabItem Header="Permissions" Style="{StaticResource TabItemStyle}">
                <Grid Background="#F9FAFB">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="Editing permissions for" FontSize="12" Foreground="#6B7280"/>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="{Binding SelectedUser.FullName}" FontSize="16" FontWeight="SemiBold" Foreground="#111827"/>
                                <TextBlock Text=" (" FontSize="16" Foreground="#6B7280"/>
                                <TextBlock Text="{Binding SelectedUser.RoleName}" FontSize="16" Foreground="#6B7280"/>
                                <TextBlock Text=")" FontSize="16" Foreground="#6B7280"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" MinWidth="180"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*" MinWidth="300"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource PanelCardStyle}" Margin="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Permission Categories" Style="{StaticResource SubHeaderTextStyle}" Margin="0,0,0,10"/>
                                <ListBox Grid.Row="1" ItemsSource="{Binding PermissionGroups}"
                                         SelectedItem="{Binding SelectedPermissionGroup, Mode=TwoWay}"
                                         BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <StaticResource ResourceKey="Style.View.UserView.ListBoxItem.01" />
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding GroupName}" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource PanelCardStyle}" Margin="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Background="#F3F4F6" Padding="12,10" CornerRadius="4,4,0,0">
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Right" Content="Select All"
                                                  IsChecked="{Binding SelectedPermissionGroup.IsAllSelected, Mode=TwoWay}"
                                                  Style="{StaticResource CheckBoxStyle}"/>
                                        <TextBlock Text="{Binding SelectedPermissionGroup.GroupName}"
                                                   FontSize="15" FontWeight="SemiBold" Foreground="#111827"/>
                                    </DockPanel>
                                </Border>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8">
                                    <ItemsControl ItemsSource="{Binding SelectedPermissionGroup.Permissions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="260" Margin="5" Padding="10" Background="Transparent"
                                                        CornerRadius="4" BorderThickness="1" BorderBrush="Transparent">
                                                    <CheckBox IsChecked="{Binding IsGranted, UpdateSourceTrigger=PropertyChanged}"
                                                              Style="{StaticResource CheckBoxStyle}" VerticalContentAlignment="Top">
                                                        <StackPanel Margin="8,-2,0,0">
                                                            <TextBlock Text="{Binding Description}" FontWeight="SemiBold"
                                                                       Foreground="#374151" FontSize="13" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding PermissionKey}" FontSize="10"
                                                                       Foreground="#9CA3AF" Margin="0,2,0,0"
                                                                       FontFamily="Consolas" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </CheckBox>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="15">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="Changes are saved when you select Update Permissions." Foreground="#6B7280" FontSize="12"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Update Permissions" 
                                        Command="{Binding UpdatePermissionsCommand}" 
                                        Style="{StaticResource PrimaryButtonStyle}" 
                                        Width="180" Height="35" FontSize="13"/>
                                
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            
        </TabControl>
        
        
    </Grid>

</UserControl>
