<Window x:Class="PointOfSale.UI.Views.Security.Dialogs.UserProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PointOfSale.UI.Views.Security.Dialogs"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Title="My Account" Height="450" Width="600"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="Transparent">

    <Border Style="{StaticResource WindowBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource Brush.Structure.Sidebar}"
                    CornerRadius="8,8,0,0"
                    Padding="10,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Profile" 
                                   Foreground="{StaticResource Brush.Text.OnDark}" 
                                   Style="{StaticResource HeaderTextStyle}"/>

                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource IconOnlyButtonStyle}"
                            Background="Transparent"
                            Click="CloseButton_Click"
                            ToolTip="Close">
                        <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                            Fill="{StaticResource Brush.Text.OnDark}"
                            Width="12" Height="12" Stretch="Uniform"/>

                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="10">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Border Width="50" Height="50" CornerRadius="25" Background="{StaticResource BrandBrush}" Margin="0,0,15,0">
                        <TextBlock Text="{Binding CurrentUser.Initials}" FontSize="20" Foreground="White" 
                                    FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentUser.FullName}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}"/>
                        <TextBlock Text="{Binding CurrentUser.RoleName}" FontSize="12" Foreground="{StaticResource Brush.Text.Muted}"/>
                    </StackPanel>
                </StackPanel>

                <TabControl Grid.Row="1" Style="{StaticResource TabControlStyle}">

                    <TabItem Header="Profile Information" Style="{StaticResource TabItemStyle}">
                        <StackPanel Margin="0,12,0,0">
                            <Label Content="Full Name" Foreground="{StaticResource Brush.Text.Muted}"/>
                            <TextBox Text="{Binding CurrentUser.FullName}" IsReadOnly="True" 
                                     Style="{StaticResource TextBoxStyle}"/>

                            <Label Content="Username" Foreground="{StaticResource Brush.Text.Muted}" Margin="0"/>
                            <TextBox Text="{Binding CurrentUser.Username}" IsReadOnly="True" Style="{StaticResource TextBoxStyle}"/>

                            <Label Content="Assigned Branch" Foreground="{StaticResource Brush.Text.Muted}" Margin="0"/>
                            <TextBox Text="{Binding CurrentUser.BranchName}" IsReadOnly="True" Style="{StaticResource TextBoxStyle}"/>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Security" Style="{StaticResource TabItemStyle}">
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="Change Password" Margin="0,0,0,12" Style="{StaticResource SubHeaderTextStyle}"/>

                            <Label Content="Current Password" Foreground="{StaticResource Brush.Text.Muted}"/>
                            <TextBox Text="{Binding CurrentPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource TextBoxStyle}"
                                     PreviewKeyDown="MoveFocusOnEnter"
                                     Margin="0"/>

                            <Label Content="New Password" Foreground="{StaticResource Brush.Text.Muted}" Margin="0"/>
                            <TextBox Text="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource TextBoxStyle}"
                                     PreviewKeyDown="MoveFocusOnEnter"
                                     Margin="0"/>

                            <Label Content="Confirm New Password" Foreground="{StaticResource Brush.Text.Muted}" Margin="0"/>
                            <TextBox Text="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource TextBoxStyle}" 
                                     PreviewKeyDown="MoveFocusOnEnter"
                                     Margin="0"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <Button Content="Cancel" 
                                        Command="{Binding CloseCommand}" 
                                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                        Style="{StaticResource SecondaryButtonStyle}" 
                                        Margin="0,0,8,0"/>

                                <Button Content="Update Password" 
                                        Command="{Binding ChangePasswordCommand}" 
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Width="140"/>

                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                </TabControl>
                
            </Grid>
        </Grid>
        
    </Border>
    
</Window>
