<Window x:Class="PointOfSale.UI.Views.Security.Dialogs.ManagerAuthorizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Height="380" Width="420">

    <Window.InputBindings>
        <KeyBinding Key="Return" Command="{Binding ConfirmCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>

    <Border Style="{StaticResource WindowBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource Brush.Structure.Sidebar}"
                    CornerRadius="8,8,0,0"
                    Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Manager Authorization Required"
                               Foreground="{StaticResource Brush.Text.OnDark}"
                               Style="{StaticResource HeaderTextStyle}"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            Style="{StaticResource IconOnlyButtonStyle}"
                            Background="Transparent"
                            Command="{Binding CancelCommand}"
                            ToolTip="Close">
                        <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                              Fill="{StaticResource Brush.Text.OnDark}"
                              Width="12" Height="12" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="24" VerticalAlignment="Center">

                <TextBlock Text="{Binding ActionDescription, StringFormat='A manager PIN is required to {0}.'}"
                           TextWrapping="Wrap"
                           Style="{StaticResource LabelStyle}"
                           FontSize="14"
                           Margin="0,0,0,18"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>

                <TextBlock Text="Manager PIN" Style="{StaticResource LabelStyle}" HorizontalAlignment="Center"/>

                <PasswordBox x:Name="PinBox"
                             PasswordChanged="PinBox_PasswordChanged"
                             MaxLength="10"
                             Height="56"
                             FontSize="28"
                             HorizontalContentAlignment="Center"
                             Style="{StaticResource PasswordBoxStyle}"
                             Margin="0,4,0,8"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           FontSize="13"
                           FontWeight="Medium"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                           Margin="0,0,0,8"/>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="CANCEL"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="52"
                            FontSize="15"
                            Width="Auto"
                            Margin="0,0,8,0"/>

                    <Button Grid.Column="1"
                            Content="CONFIRM"
                            Command="{Binding ConfirmCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="52"
                            FontSize="15"
                            Width="Auto"
                            Margin="8,0,0,0"/>
                </Grid>

            </StackPanel>
        </Grid>
    </Border>
</Window>
