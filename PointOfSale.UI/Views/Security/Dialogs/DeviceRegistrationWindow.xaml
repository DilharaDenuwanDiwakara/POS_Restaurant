<Window x:Class="PointOfSale.UI.Views.Security.Dialogs.DeviceRegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Height="430"
        Width="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=BranchIdTextBox}">

    <Window.Resources>
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource BrandBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource WindowBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource Brush.Structure.Sidebar}"
                    CornerRadius="8,8,0,0"
                    Padding="14,0">
                <Grid>
                    <TextBlock Text="Register POS Terminal"
                               Foreground="{StaticResource Brush.Text.OnDark}"
                               Style="{StaticResource HeaderTextStyle}"
                               VerticalAlignment="Center"
                               Margin="0"/>

                    <Button HorizontalAlignment="Right"
                            Style="{StaticResource IconOnlyButtonStyle}"
                            Background="Transparent"
                            Click="CloseButton_Click"
                            ToolTip="Close">
                        <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                              Fill="{StaticResource Brush.Text.OnDark}"
                              Width="12"
                              Height="12"
                              Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Style="{StaticResource PanelCardStyle}"
                    Margin="12">
                <StackPanel>
                    <TextBlock Text="Authorize this workstation as a POS terminal."
                               Style="{StaticResource LabelStyle}"
                               Foreground="{StaticResource Brush.Text.Muted}"
                               Margin="0,0,0,12"/>

                    <Border Style="{StaticResource PanelErrorStyle}"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                            Margin="0,0,0,12">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource DangerBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="Machine Name" Style="{StaticResource LabelStyle}"/>
                    <Border Background="{StaticResource Brush.App.Background}"
                            BorderBrush="{StaticResource Brush.Card.Border}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Height="30"
                            Padding="8,0"
                            Margin="0,0,0,12">
                        <TextBlock Text="{Binding MachineName, Mode=OneWay}"
                                   Foreground="{StaticResource Brush.Text.Muted}"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Branch Id" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="BranchIdTextBox"
                             Text="{Binding BranchId, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                             Style="{StaticResource TextBoxStyle}"
                             PreviewKeyDown="MoveFocusOnEnter"
                             TabIndex="0"/>

                    <TextBlock Text="Register Code" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding RegisterCode, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                             Style="{StaticResource TextBoxStyle}"
                             PreviewKeyDown="MoveFocusOnEnter"
                             TabIndex="1"/>

                    <TextBlock Text="Register Name" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding RegisterName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                             Style="{StaticResource TextBoxStyle}"
                             PreviewKeyDown="MoveFocusOnEnter"
                             TabIndex="2"/>

                    <Button Content="Register POS Terminal"
                            Command="{Binding RegisterCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="190"
                            HorizontalAlignment="Right"
                            IsDefault="True"
                            Margin="0,2,0,12"
                            TabIndex="3"/>

                    <Separator Margin="0,0,0,8"/>

                    <Button Content="Skip - Open Admin Dashboard Only"
                            Command="{Binding SkipCommand}"
                            Style="{StaticResource LinkButtonStyle}"
                            HorizontalAlignment="Center"
                            TabIndex="4"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
