<Window x:Class="PointOfSale.UI.Views.Security.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:PointOfSale.UI.Views.Security"
        mc:Ignorable="d" 
        Width="650" Height="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FocusManager.FocusedElement="{Binding ElementName=UsernameTextBox}">

    <Border Style="{StaticResource WindowBorderStyle}">
        <Grid>
            
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource Brush.Structure.Sidebar}"
                    CornerRadius="8,8,0,0"
                    Padding="20,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="24" Height="24" Fill="{StaticResource BrandBrush}" Margin="0,0,12,0"/>

                        <TextBlock VerticalAlignment="Center">
                            <Run Text="Nexora" Foreground="{StaticResource Brush.Text.OnDark}" FontWeight="SemiBold" FontSize="16"/>
                            <Run Text=" | Restaurant" Foreground="{StaticResource Brush.Text.Muted}" FontSize="14"/>
                        </TextBlock>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource IconOnlyButtonStyle}"
                            Background="Transparent"
                            Click="CloseButton_Click"
                            ToolTip="Close">
                        <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                              Fill="{StaticResource Brush.Text.OnDark}"
                              Width="12" Height="12" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="#F8FAFC"
                        CornerRadius="0,0,0,8"
                        ClipToBounds="True">
                    <Grid>
                        <Viewbox Margin="16">
                            <Image Source="/Resources/Images/login_image.png"/>
                        </Viewbox>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="12">
                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="Sign In" Style="{StaticResource HeaderTextStyle}" HorizontalAlignment="Left"/>
                        <TextBlock Text="Please enter your credentials to continue." 
                                   Style="{StaticResource LabelStyle}" 
                                   Foreground="{StaticResource Brush.Text.Muted}"
                                   Margin="0,0,0,20"/>

                        <Border Style="{StaticResource PanelErrorStyle}" 
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                                Margin="0,0,0,12">
                            
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M13,13H11V7H13M13,17H11V15H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z" 
                                      Fill="{StaticResource DangerBrush}"
                                      Style="{StaticResource Style.Icon.Base}"
                                      Margin="8,0,8,0"/>
                                
                                <TextBlock Text="{Binding ErrorMessage}" 
                                           Foreground="{StaticResource DangerBrush}" 
                                           FontSize="13" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Username" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="UsernameTextBox"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 Style="{StaticResource TextBoxStyle}"
                                 Height="32"
                                 PreviewKeyDown="MoveFocusOnEnter"
                                 Margin="0,0,0,16"
                                 TabIndex="0"/>

                        <TextBlock Text="Password" Style="{StaticResource LabelStyle}"/>
                        <PasswordBox x:Name="PasswordBox"
                                     PasswordChanged="PasswordBox_Changed"
                                     PreviewKeyDown="MoveFocusOnEnter"
                                     Style="{StaticResource PasswordBoxStyle}"
                                     Height="32"
                                     TabIndex="1"/>

                        <Button Content="Sign In"
                                Command="{Binding LoginCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                IsDefault="True" 
                                Margin="0,12,0,0"
                                Width="Auto"
                                TabIndex="2"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
