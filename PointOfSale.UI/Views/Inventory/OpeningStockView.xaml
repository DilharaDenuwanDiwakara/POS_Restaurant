<UserControl x:Class="PointOfSale.UI.Views.Inventory.OpeningStockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="1100">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Opening Stock" Style="{StaticResource HeaderTextStyle}"/>

        <Border Grid.Row="1" Style="{StaticResource PanelCardStyle}" Margin="0,8,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Location" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding Locations}"
                                  SelectedItem="{Binding SelectedLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="Name"
                                  IsEditable="True"
                                  Style="{StaticResource ComboBoxStyle}"
                                  ItemContainerStyle="{StaticResource ComboBoxItemStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Opening Date" Style="{StaticResource LabelStyle}"/>
                        <DatePicker SelectedDate="{Binding OpeningDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource DatePickerStyle}"/>
                    </StackPanel>
                </Grid>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding StockItems}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="False"
                          SelectionMode="Single"
                          Style="{StaticResource DataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Product Name"
                                            Binding="{Binding ProductName}"
                                            Width="*"
                                            IsReadOnly="True"/>
                        <DataGridTextColumn Header="UOM"
                                            Binding="{Binding DefaultUOM}"
                                            Width="120"
                                            IsReadOnly="True"/>
                        <DataGridTextColumn Header="Current Stock"
                                            Binding="{Binding CurrentStock, StringFormat=N3}"
                                            Width="140"
                                            IsReadOnly="True"/>
                        <DataGridTextColumn Header="Opening Quantity"
                                            Binding="{Binding OpeningQuantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N3}"
                                            Width="170"
                                            IsReadOnly="False"/>
                        <DataGridTextColumn Header="Unit Cost"
                                            Binding="{Binding UnitCost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                            Width="150"
                                            IsReadOnly="False"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource PanelCardStyle}" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Clear/Discard Draft"
                        Command="{Binding ClearDraftCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"/>
                <Button Content="Save Opening Stock"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
