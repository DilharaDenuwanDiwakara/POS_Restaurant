                    <DataGrid
                        Grid.Row="1"
                        Margin="0,4"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        GridLinesVisibility="All"
                        HorizontalScrollBarVisibility="Auto"
                        IsReadOnly="True"
                        ItemsSource="{Binding HistoryList}"
                        SelectionMode="Single"
                        Style="{StaticResource DataGridStyle}">

                        <DataGrid.RowStyle>
                            <Style BasedOn="{StaticResource Style.DataGrid.Row}" TargetType="DataGridRow">
                                <Setter Property="Height" Value="Auto" />
                                <Setter Property="MinHeight" Value="42" />
                                <Setter Property="DetailsVisibility" Value="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}" />
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <!--  Expand / Collapse Button  -->
                            <DataGridTemplateColumn Width="44">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton
                                            Width="28"
                                            Height="28"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding IsExpanded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            ToolTip="Expand transfer details">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton">
                                                    <Setter Property="Content" Value="&gt;" />
                                                    <Setter Property="FontFamily" Value="Segoe UI" />
                                                    <Setter Property="FontSize" Value="12" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="Foreground" Value="#334155" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Cursor" Value="Hand" />
                                                    <Setter Property="Focusable" Value="False" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter Property="Content" Value="v" />
                                                            <Setter Property="ToolTip" Value="Collapse transfer details" />
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#E5E7EB" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!--  Parent Columns (StockTransfer)  -->
                            <DataGridTextColumn
                                Width="Auto"
                                Binding="{Binding TransferId}"
                                Header="ID"
                                Visibility="Collapsed"/>
                            <DataGridTextColumn
                                Width="130"
                                Binding="{Binding TransferNumber}"
                                Header="Transfer #" />
                            <DataGridTextColumn
                                Width="160"
                                Binding="{Binding FromLocationName}"
                                Header="From" />
                            <DataGridTextColumn
                                Width="160"
                                Binding="{Binding ToLocationName}"
                                Header="To" />
                            <DataGridTextColumn
                                Width="130"
                                Binding="{Binding TransferDate, StringFormat='{}{0:dd/MM/yyyy}'}"
                                Header="Transfer Date">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Note}"
                                Header="Note" />
                            <DataGridTextColumn
                                Width="110"
                                Binding="{Binding Status}"
                                Header="Status" />
                            <DataGridTextColumn
                                Width="120"
                                Binding="{Binding Username}"
                                Header="Created By" />
                        </DataGrid.Columns>

                        <!--  Child Row Details (StockTransferLine Items with Unit Measure Name)  -->
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <Border
                                    Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    Margin="0,12,0,12"
                                    Padding="40,0,12,0"
                                    HorizontalAlignment="Stretch"
                                    Background="#F4F6F8"
                                    BorderBrush="#D8DEE6"
                                    BorderThickness="0,1,0,1"
                                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <Border Margin="0,10,0,10" HorizontalAlignment="Stretch">
                                            <DataGrid
                                                MinHeight="50"
                                                HorizontalAlignment="Stretch"
                                                AutoGenerateColumns="False"
                                                CanUserAddRows="False"
                                                HeadersVisibility="Column"
                                                HorizontalScrollBarVisibility="Disabled"
                                                IsReadOnly="True"
                                                ItemsSource="{Binding Lines}"
                                                Style="{StaticResource DataGridStyle}"
                                                VerticalScrollBarVisibility="Disabled">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn
                                                        Width="Auto"
                                                        Binding="{Binding TransferLineId}"
                                                        Header="Line ID" 
                                                        Visibility="Collapsed"/>
                                                    <DataGridTextColumn
                                                        Width="Auto"
                                                        Binding="{Binding TransferId}"
                                                        Header="Transfer ID" 
                                                        Visibility="Collapsed"/>
                                                    <DataGridTextColumn
                                                        Width="*"
                                                        Binding="{Binding ProductName}"
                                                        Header="Product Name" />
                                                    <DataGridTextColumn
                                                        Width="150"
                                                        Binding="{Binding ProductCode}"
                                                        Header="Product Name" />
                                                    <DataGridTextColumn
                                                        Width="110"
                                                        Binding="{Binding Quantity, StringFormat=N2}"
                                                        ElementStyle="{StaticResource RightAlignedTextStyle}"
                                                        Header="Quantity"
                                                        HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}" />
                                                    <DataGridTextColumn
                                                        Width="130"
                                                        Binding="{Binding UnitMeasureName}"
                                                        Header="Unit Measure" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
