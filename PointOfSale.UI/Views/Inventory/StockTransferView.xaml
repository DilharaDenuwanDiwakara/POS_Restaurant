<UserControl x:Class="PointOfSale.UI.Views.Inventory.StockTransferView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PointOfSale.UI.Views.Inventory"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <TabControl Style="{StaticResource TabControlStyle}">

            <!-- ============================================================ -->
            <!-- TAB 1 : New Transfer                                         -->
            <!-- ============================================================ -->
            <TabItem Header=" 🔄 New Transfer " Style="{StaticResource TabItemStyle}">
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="285"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,8,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="Transfer Details" Style="{StaticResource SubHeaderTextStyle}"/>

                                <TextBlock Text="Transfer Date:" Style="{StaticResource LabelStyle}"/>
                                <DatePicker SelectedDate="{Binding TransferDate, UpdateSourceTrigger=PropertyChanged}"
                                            IsTodayHighlighted="True"
                                            Style="{StaticResource DatePickerStyle}"
                                            PreviewKeyDown="MoveFocusOnEnter"/>

                                <TextBlock Text="From (Source):" Style="{StaticResource LabelStyle}"/>
                                <ComboBox ItemsSource="{Binding Locations}"
                                          SelectedValue="{Binding FromLocationId, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          SelectedIndex="0"
                                          Style="{StaticResource ComboBoxStyle}"
                                          ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                          PreviewKeyDown="MoveFocusOnEnter"/>

                                <TextBlock Text="To (Destination):" Style="{StaticResource LabelStyle}"/>
                                <ComboBox ItemsSource="{Binding Locations}"
                                          SelectedValue="{Binding ToLocationId, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          SelectedIndex="1"
                                          Style="{StaticResource ComboBoxStyle}"
                                          ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                          PreviewKeyDown="MoveFocusOnEnter"/>

                                <TextBlock Text="Reference / Note:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="500"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Height="80"
                                         VerticalContentAlignment="Top"
                                         Style="{StaticResource TextBoxStyle}"
                                         PreviewKeyDown="MoveFocusOnEnter"/>

                                <StackPanel Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Center">
                                    <Button Content="Process Transfer"
                                            Command="{Binding SaveTransferCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Width="140"
                                            Margin="0,0,10,0"/>

                                    <Button Content="Clear"
                                            Command="{Binding ClearCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Width="100"
                                            Focusable="False"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}" Margin="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Background="#F8F9FA" BorderBrush="#E1E8ED" BorderThickness="1"
                                    CornerRadius="6" Padding="8" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Add Items" Style="{StaticResource SubHeaderTextStyle}" VerticalAlignment="Center"/>

                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Margin="0 0 8 0">
                                            <TextBlock Text="Code / Barcode:" Style="{StaticResource LabelStyle}"/>
                                            <TextBox x:Name="BarcodeTextBox"
                                                     Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                     Style="{StaticResource TextBoxStyle}"
                                                     PreviewKeyDown="MoveFocusOnEnter"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="0 0 8 0">
                                            <TextBlock Text="Product:" Style="{StaticResource LabelStyle}"/>
                                            <ComboBox x:Name="ProductCombobox"
                                                      ItemsSource="{Binding Products}"
                                                      SelectedItem="{Binding SelectedProduct, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      DisplayMemberPath="ProductName"
                                                      IsEditable="True"
                                                      IsTextSearchEnabled="True"
                                                      IsTabStop="False"
                                                      PreviewKeyDown="MoveFocusOnEnter"
                                                      Style="{StaticResource ComboBoxStyle}"
                                                      Validation.ErrorTemplate="{StaticResource ErrorTemplate}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="0 0 8 0">
                                            <TextBlock Text="UOM:" Style="{StaticResource LabelStyle}"/>
                                            <ComboBox ItemsSource="{Binding AllowedUOMs}"
                                                      SelectedItem="{Binding SelectedUOM, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      DisplayMemberPath="DisplayName"
                                                      Style="{StaticResource ComboBoxStyle}"
                                                      ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                                      PreviewKeyDown="MoveFocusOnEnter"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Margin="0 0 8 0">
                                            <TextBlock Text="Available:" Style="{StaticResource LabelStyle}"/>
                                            <TextBox Text="{Binding SelectedBatch.AvailableQuantity, StringFormat=N3, FallbackValue='-'}"
                                                     Style="{StaticResource ReadOnlyTextBoxStyle}"
                                                     IsReadOnly="True"
                                                     FontWeight="Bold"
                                                     Foreground="{StaticResource SuccessBrush}"
                                                     TextAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4" Margin="0 0 8 0">
                                            <TextBlock Text="Quantity:" Style="{StaticResource LabelStyle}"/>
                                            <TextBox x:Name="QtyTextBox"
                                                     Text="{Binding TransferQuantity, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource TextBoxStyle}"
                                                     Validation.ErrorTemplate="{StaticResource ErrorTemplate}"
                                                     GotKeyboardFocus="SelectAllText_GotFocus"
                                                     PreviewKeyDown="MoveFocusOnEnter"
                                                     TextAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="5">
                                            <Button x:Name="AddButton"
                                                    Content="Add"
                                                    Command="{Binding AddLineCommand}"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Click="AddButton_Click"
                                                    Width="100" Height="32"
                                                    Margin="0 20 0 0"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding TransferLines}"
                                      SelectedItem="{Binding SelectedLine}"
                                      Style="{StaticResource DataGridStyle}"
                                      Margin="0,4,0,0"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*"/>

                                    <DataGridTextColumn Header="UOM" Binding="{Binding UnitMeasureName}" Width="100"/>

                                    <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, StringFormat=N3}" Width="120" FontWeight="Bold">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="Cost Price" Binding="{Binding UnitCost, StringFormat='Rs. {0:N2}'}" Width="120" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTemplateColumn Width="80" Header="Action">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource DeleteButtonStyle}"
                                                        ToolTip="Remove line"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Row="2" Background="#F8F9FA" BorderBrush="#E1E8ED" BorderThickness="1"
                                    CornerRadius="6" Padding="8" Margin="0,4,0,0">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Total Items:" Style="{StaticResource LabelStyle}" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding TransferLines.Count}" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                        </Grid>
                    </Border>

                </Grid>
            </TabItem>

            <!-- ============================================================ -->
            <!-- TAB 2 : Transfer History                                     -->
            <!-- ============================================================ -->
            <TabItem Header=" 📋 Transfer History " Style="{StaticResource TabItemStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filter Bar -->
                    <Border Style="{StaticResource PanelCardStyle}" Margin="0 4 0 0">
                        <StackPanel Orientation="Horizontal">

                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="From Date" Style="{StaticResource LabelStyle}" Margin="0,0,0,2"/>
                                <DatePicker SelectedDate="{Binding HistoryDateFrom}"
                                            Style="{StaticResource DatePickerStyle}"
                                            Width="150" Margin="0"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="To Date" Style="{StaticResource LabelStyle}" Margin="0,0,0,2"/>
                                <DatePicker SelectedDate="{Binding HistoryDateTo}"
                                            Style="{StaticResource DatePickerStyle}"
                                            Width="150" Margin="0"/>
                            </StackPanel>

                            <Button Command="{Binding SearchHistoryCommand}"
                                    Margin="0,16,12,0"
                                    Style="{StaticResource SearchButtonStyle}"
                                    Width="80" Height="30"/>
                        </StackPanel>
                    </Border>

                    <!-- History DataGrid -->
                    <DataGrid x:Name="StockTransferHistoryDataGrid"
                              Grid.Row="1" Margin="0 4"
                              ItemsSource="{Binding HistoryList}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              GridLinesVisibility="All"
                              Style="{StaticResource DataGridStyle}"
                              RowDetailsVisibilityMode="Visible"
                              SelectionMode="Single"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource Style.DataGrid.Row}">
                                <Setter Property="Height" Value="Auto"/>
                                <Setter Property="MinHeight" Value="42"/>
                                <Setter Property="DetailsVisibility" Value="Visible"/>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="44">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Width="28"
                                                      Height="28"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      ToolTip="Expand transfer">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton">
                                                    <Setter Property="Content" Value="&gt;"/>
                                                    <Setter Property="FontFamily" Value="Segoe UI"/>
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Foreground" Value="#334155"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="Focusable" Value="False"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter Property="Content" Value="v"/>
                                                            <Setter Property="ToolTip" Value="Collapse transfer"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#E5E7EB"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Transfer #"   Binding="{Binding TransferNumber}"                          Width="130"/>
                            <DataGridTextColumn Header="From"         Binding="{Binding FromLocationName}"                        Width="160"/>
                            <DataGridTextColumn Header="To"           Binding="{Binding ToLocationName}"                          Width="160"/>
                            <DataGridTextColumn Header="Transfer Date" Binding="{Binding TransferDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Note"         Binding="{Binding Note}"                                    Width="*"/>
                            <DataGridTextColumn Header="Status"       Binding="{Binding Status}"                                  Width="110"/>
                            <DataGridTextColumn Header="Created By"   Binding="{Binding Username}"                                Width="120"/>
                            <DataGridTemplateColumn Header="Action" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.PrintStockTransferCommand, ElementName=StockTransferHistoryDataGrid}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DataGridPrintButtonStyle}"
                                                ToolTip="Print stock transfer"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>

                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <Border Background="#F4F6F8"
                                        BorderBrush="#D8DEE6"
                                        BorderThickness="0,1,0,1"
                                        Margin="0,12,0,12"
                                        Padding="40,0,12,0"
                                        Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        HorizontalAlignment="Stretch"
                                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <TextBlock Text="Loading stock transfer items..."
                                                   Foreground="#64748B"
                                                   Margin="4,0,0,8">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLoadingLineItems}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Border Margin="0,22,0,0"
                                                HorizontalAlignment="Stretch">
                                            <DataGrid ItemsSource="{Binding LineItems}"
                                                      Style="{StaticResource DataGridStyle}"
                                                      AutoGenerateColumns="False"
                                                      CanUserAddRows="False"
                                                      IsReadOnly="True"
                                                      HeadersVisibility="Column"
                                                      HorizontalAlignment="Stretch"
                                                      MinHeight="78"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Disabled">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*" MinWidth="240"/>
                                                    <DataGridTextColumn Header="UOM"
                                                                        Binding="{Binding UnitMeasureName}"
                                                                        Width="100"/>
                                                    <DataGridTextColumn Header="Qty"
                                                                        Binding="{Binding Quantity, StringFormat=N3}"
                                                                        Width="90"
                                                                        ElementStyle="{StaticResource RightAlignedTextStyle}"/>
                                                    <DataGridTextColumn Header="Batch"
                                                                        Binding="{Binding BatchId}"
                                                                        Width="90"/>
                                                    <DataGridTextColumn Header="Expiry"
                                                                        Binding="{Binding ExpiryDate, StringFormat='{}{0:dd/MM/yyyy}'}"
                                                                        Width="120"/>
                                                    <DataGridTextColumn Header="Unit Cost"
                                                                        Binding="{Binding UnitCost, StringFormat='Rs. {0:N2}'}"
                                                                        Width="120"
                                                                        ElementStyle="{StaticResource RightAlignedTextStyle}"
                                                                        HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}"/>
                                                    <DataGridTextColumn Header="Total"
                                                                        Binding="{Binding LineTotal, StringFormat='Rs. {0:N2}'}"
                                                                        Width="120"
                                                                        ElementStyle="{StaticResource RightAlignedTextStyle}"
                                                                        HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
