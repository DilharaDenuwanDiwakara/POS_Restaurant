<UserControl
    x:Class="PointOfSale.UI.Views.Inventory.StockTransferView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PointOfSale.UI.Views.Inventory"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <TabControl Style="{StaticResource TabControlStyle}">

            <!--  ============================================================  -->
            <!--  TAB 1 : New Transfer  -->
            <!--  ============================================================  -->
            <TabItem Header=" 🔄 New Transfer " Style="{StaticResource TabItemStyle}">
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="285" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Margin="0,0,8,0" Style="{StaticResource PanelCardStyle}">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SubHeaderTextStyle}" Text="Transfer Details" />

                                <TextBlock Style="{StaticResource LabelStyle}" Text="Transfer Date:" />
                                <DatePicker
                                    IsTodayHighlighted="True"
                                    PreviewKeyDown="MoveFocusOnEnter"
                                    SelectedDate="{Binding TransferDate, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource DatePickerStyle}" />

                                <TextBlock Style="{StaticResource LabelStyle}" Text="From (Source):" />
                                <ComboBox
                                    DisplayMemberPath="Name"
                                    ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                    ItemsSource="{Binding Locations}"
                                    PreviewKeyDown="MoveFocusOnEnter"
                                    SelectedIndex="0"
                                    SelectedValue="{Binding FromLocationId, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                    SelectedValuePath="Id"
                                    Style="{StaticResource ComboBoxStyle}" />

                                <TextBlock Style="{StaticResource LabelStyle}" Text="To (Destination):" />
                                <ComboBox
                                    DisplayMemberPath="Name"
                                    ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                    ItemsSource="{Binding Locations}"
                                    PreviewKeyDown="MoveFocusOnEnter"
                                    SelectedIndex="1"
                                    SelectedValue="{Binding ToLocationId, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                    SelectedValuePath="Id"
                                    Style="{StaticResource ComboBoxStyle}" />

                                <TextBlock Style="{StaticResource LabelStyle}" Text="Reference / Note:" />
                                <TextBox
                                    Height="80"
                                    VerticalContentAlignment="Top"
                                    AcceptsReturn="True"
                                    MaxLength="500"
                                    PreviewKeyDown="MoveFocusOnEnter"
                                    Style="{StaticResource TextBoxStyle}"
                                    Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap" />

                                <StackPanel
                                    Margin="0,20,0,0"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Button
                                        Width="140"
                                        Margin="0,0,10,0"
                                        Command="{Binding SaveTransferCommand}"
                                        Content="Process Transfer"
                                        Style="{StaticResource PrimaryButtonStyle}" />

                                    <Button
                                        Width="100"
                                        Command="{Binding ClearCommand}"
                                        Content="Clear"
                                        Focusable="False"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Margin="0"
                        Style="{StaticResource PanelCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border
                                Margin="0,0,0,4"
                                Padding="8"
                                Background="#F8F9FA"
                                BorderBrush="#E1E8ED"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SubHeaderTextStyle}"
                                        Text="Add Items" />

                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Style="{StaticResource LabelStyle}" Text="Code / Barcode:" />
                                            <TextBox
                                                x:Name="BarcodeTextBox"
                                                PreviewKeyDown="MoveFocusOnEnter"
                                                Style="{StaticResource TextBoxStyle}"
                                                Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                            <TextBlock Style="{StaticResource LabelStyle}" Text="Product:" />
                                            <ComboBox
                                                x:Name="ProductCombobox"
                                                DisplayMemberPath="ProductName"
                                                IsEditable="True"
                                                IsTabStop="False"
                                                IsTextSearchEnabled="True"
                                                ItemsSource="{Binding Products}"
                                                PreviewKeyDown="MoveFocusOnEnter"
                                                SelectedItem="{Binding SelectedProduct, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource ComboBoxStyle}"
                                                Validation.ErrorTemplate="{StaticResource ErrorTemplate}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                            <TextBlock Style="{StaticResource LabelStyle}" Text="UOM:" />
                                            <ComboBox
                                                DisplayMemberPath="DisplayName"
                                                ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                                ItemsSource="{Binding AllowedUOMs}"
                                                PreviewKeyDown="MoveFocusOnEnter"
                                                SelectedItem="{Binding SelectedUOM, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource ComboBoxStyle}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                            <TextBlock Style="{StaticResource LabelStyle}" Text="Available:" />
                                            <TextBox
                                                FontWeight="Bold"
                                                Foreground="{StaticResource SuccessBrush}"
                                                IsReadOnly="True"
                                                Style="{StaticResource ReadOnlyTextBoxStyle}"
                                                Text="{Binding SelectedBatch.AvailableQuantity, StringFormat=N3, FallbackValue='-'}"
                                                TextAlignment="Center" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="4" Margin="0,0,8,0">
                                            <TextBlock Style="{StaticResource LabelStyle}" Text="Quantity:" />
                                            <TextBox
                                                x:Name="QtyTextBox"
                                                GotKeyboardFocus="SelectAllText_GotFocus"
                                                PreviewKeyDown="MoveFocusOnEnter"
                                                Style="{StaticResource TextBoxStyle}"
                                                Text="{Binding TransferQuantity, UpdateSourceTrigger=PropertyChanged}"
                                                TextAlignment="Center"
                                                Validation.ErrorTemplate="{StaticResource ErrorTemplate}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="5">
                                            <Button
                                                x:Name="AddButton"
                                                Width="100"
                                                Height="32"
                                                Margin="0,20,0,0"
                                                Click="AddButton_Click"
                                                Command="{Binding AddLineCommand}"
                                                Content="Add"
                                                Style="{StaticResource PrimaryButtonStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <DataGrid
                                Grid.Row="1"
                                Margin="0,4,0,0"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                IsReadOnly="True"
                                ItemsSource="{Binding TransferLines}"
                                SelectedItem="{Binding SelectedLine}"
                                Style="{StaticResource DataGridStyle}">

                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding ProductName}"
                                        Header="Product Name" />

                                    <DataGridTextColumn
                                        Width="100"
                                        Binding="{Binding UnitMeasureName}"
                                        Header="UOM" />

                                    <DataGridTextColumn
                                        Width="120"
                                        Binding="{Binding Quantity, StringFormat=N3}"
                                        FontWeight="Bold"
                                        Header="Quantity">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Left" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn
                                        Width="120"
                                        Binding="{Binding UnitCost, StringFormat='Rs. {0:N2}'}"
                                        Header="Cost Price"
                                        HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTemplateColumn Width="80" Header="Action">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button
                                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource DeleteButtonStyle}"
                                                    ToolTip="Remove line" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border
                                Grid.Row="2"
                                Margin="0,4,0,0"
                                Padding="8"
                                Background="#F8F9FA"
                                BorderBrush="#E1E8ED"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,0,5,0"
                                            Style="{StaticResource LabelStyle}"
                                            Text="Total Items:" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="Bold"
                                            Text="{Binding TransferLines.Count}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                        </Grid>
                    </Border>

                </Grid>
            </TabItem>

            <!--  ============================================================  -->
            <!--  TAB 2 : Transfer History  -->
            <!--  ============================================================  -->
            <TabItem Header=" 📋 Transfer History " Style="{StaticResource TabItemStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Filter Bar  -->
                    <Border Margin="0,4,0,0" Style="{StaticResource PanelCardStyle}">
                        <StackPanel Orientation="Horizontal">

                            <StackPanel Margin="0,0,20,0">
                                <TextBlock
                                    Margin="0,0,0,2"
                                    Style="{StaticResource LabelStyle}"
                                    Text="From Date" />
                                <DatePicker
                                    Width="150"
                                    Margin="0"
                                    SelectedDate="{Binding HistoryDateFrom}"
                                    Style="{StaticResource DatePickerStyle}" />
                            </StackPanel>

                            <StackPanel Margin="0,0,20,0">
                                <TextBlock
                                    Margin="0,0,0,2"
                                    Style="{StaticResource LabelStyle}"
                                    Text="To Date" />
                                <DatePicker
                                    Width="150"
                                    Margin="0"
                                    SelectedDate="{Binding HistoryDateTo}"
                                    Style="{StaticResource DatePickerStyle}" />
                            </StackPanel>

                            <Button
                                Width="80"
                                Height="30"
                                Margin="0,16,12,0"
                                Command="{Binding SearchHistoryCommand}"
                                Style="{StaticResource SearchButtonStyle}" />
                        </StackPanel>
                    </Border>


