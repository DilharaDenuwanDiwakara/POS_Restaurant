<UserControl x:Class="PointOfSale.UI.Views.Inventory.WastageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PointOfSale.UI.Views.Inventory"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Wastage" Style="{StaticResource HeaderTextStyle}"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="285"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,8,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Wastage Form" Style="{StaticResource SubHeaderTextStyle}"/>

                        <TextBlock Text="Wastage Date:" Style="{StaticResource LabelStyle}"/>
                        <DatePicker SelectedDate="{Binding WastageDate, UpdateSourceTrigger=PropertyChanged}"
                                    IsTodayHighlighted="True"
                                    Style="{StaticResource DatePickerStyle}"
                                    PreviewKeyDown="MoveFocusOnEnter"/>

                        <TextBlock Text="Location:" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding Locations}"
                                  SelectedValue="{Binding LocationId, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  Style="{StaticResource ComboBoxStyle}"
                                  ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                  PreviewKeyDown="MoveFocusOnEnter"/>

                        <TextBlock Text="Note:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="500"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="80"
                                 VerticalContentAlignment="Top"
                                 Style="{StaticResource TextBoxStyle}"
                                 PreviewKeyDown="MoveFocusOnEnter"/>

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Center">
                            <Button Content="save"
                                    Command="{Binding SaveCommand}" 
                                    Style="{StaticResource PrimaryButtonStyle}" 
                                    Margin="0,0,10,0"/>

                            <Button Content="Clear" 
                                    Command="{Binding ClearCommand}" 
                                    Style="{StaticResource SecondaryButtonStyle}"/>
                            
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Background="#F8F9FA" BorderBrush="#E1E8ED" BorderThickness="1" 
                            CornerRadius="6" Padding="10" Margin="0,0,0,4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Add Items" Style="{StaticResource SubHeaderTextStyle}" VerticalAlignment="Center" Margin="0"/>
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0 0 8 0">
                                    <TextBlock Text="Code / Barcode:" Style="{StaticResource LabelStyle}"/>
                                    <TextBox x:Name="BarcodeTextBox"
                                             Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                             Style="{StaticResource TextBoxStyle}"
                                             PreviewKeyDown="MoveFocusOnEnter"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0 0 8 0">
                                    <TextBlock Text="Product:" Style="{StaticResource LabelStyle}"/>
                                    <ComboBox x:Name="ProductCombobox"
                                              ItemsSource="{Binding Products}"
                                              SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                                              DisplayMemberPath="ProductName"
                                              IsEditable="True"
                                              IsTextSearchEnabled="True"
                                              PreviewKeyDown="MoveFocusOnEnter"
                                              Style="{StaticResource ComboBoxStyle}"/>
                                    
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="0 0 8 0">
                                    <TextBlock Text="Reason:" Style="{StaticResource LabelStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ComboBox ItemsSource="{Binding Reasons}"
                                                  SelectedValue="{Binding ReasonId}"
                                                  DisplayMemberPath="Reason"
                                                  SelectedValuePath="Id"
                                                  PreviewKeyDown="MoveFocusOnEnter"
                                                  Style="{StaticResource ComboBoxStyle}"
                                                  Margin="0"/>

                                        <Button Grid.Column="1"
                                                Command="{Binding AddReasonCommand}"
                                                ToolTip="Add New Reason"
                                                Margin="4,0"
                                                Style="{StaticResource AddButtonStyle}"
                                                Focusable="False"/>
                                    </Grid>

                                </StackPanel>

                                <StackPanel Grid.Column="3" Margin="0 0 8 0">
                                    <TextBlock Text="Available:" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Text="{Binding SelectedBatch.AvailableQuantity, StringFormat=N3, FallbackValue='-'}"
                                             IsReadOnly="True"
                                             Style="{StaticResource ReadOnlyTextBoxStyle}"
                                             Foreground="Gray"
                                             FontWeight="Bold"
                                             TextAlignment="Center"/>
                                    
                                </StackPanel>

                                <StackPanel Grid.Column="4" Margin="0 0 8 0">
                                    <TextBlock Text="Quantity:" Style="{StaticResource LabelStyle}"/>
                                    <TextBox x:Name="QtyTextBox"
                                             Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                             Style="{StaticResource TextBoxStyle}"
                                             PreviewKeyDown="MoveFocusOnEnter"
                                             GotKeyboardFocus="SelectAllText_GotFocus"
                                             PreviewMouseLeftButtonDown="QtyTextBox_PreviewMouseLeftButtonDown"
                                             PreviewTextInput="QtyTextBox_PreviewTextInput"
                                             TextAlignment="Center"/>
                                    
                                </StackPanel>

                                <StackPanel Grid.Column="5" VerticalAlignment="Bottom">
                                    <Button x:Name="AddButton"
                                            Content="Add"
                                            Command="{Binding AddLineCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="AddButton_Click"
                                            Width="70" Height="32" Margin="0,0,0,12"/>
                                    
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1" 
                              ItemsSource="{Binding WastageLines}" 
                              SelectedItem="{Binding SelectedLine}" 
                              Style="{StaticResource DataGridStyle}"
                              Margin="0,4,0,0"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="Reason" Binding="{Binding ReasonName}" Width="Auto"/>

                            <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, StringFormat=N3}" Width="120" FontWeight="Bold">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Unit Cost" Binding="{Binding UnitCost, StringFormat='Rs. {0:N2}'}" Width="120" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Width="80" Header="Action">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DeleteButtonStyle}"
                                                ToolTip="Remove line"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Background="#F8F9FA" BorderBrush="#E1E8ED" BorderThickness="1" 
                        CornerRadius="6" Padding="8" Margin="0,4,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Total Items:" Style="{StaticResource LabelStyle}" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding WastageLines.Count}" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </Grid>
            </Border>

        </Grid>
    </Grid>
    
</UserControl>
