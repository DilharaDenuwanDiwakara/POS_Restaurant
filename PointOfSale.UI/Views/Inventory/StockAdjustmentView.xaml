<UserControl x:Class="PointOfSale.UI.Views.Inventory.StockAdjustmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PointOfSale.UI.Views.Inventory"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="285"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel - Main Form -->
        <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,8,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Stock Adjustment Form" Style="{StaticResource SubHeaderTextStyle}"/>

                    <TextBlock Text="Adjustment Date:" Style="{StaticResource LabelStyle}"/>
                    <DatePicker SelectedDate="{Binding AdjustDate, UpdateSourceTrigger=PropertyChanged}"
                            IsTodayHighlighted="True"
                            Style="{StaticResource DatePickerStyle}"
                            PreviewKeyDown="MoveFocusOnEnter"/>

                    <TextBlock Text="Location:" Style="{StaticResource LabelStyle}"/>
                    <ComboBox ItemsSource="{Binding Locations}"
                          SelectedItem="{Binding SelectedLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          DisplayMemberPath="Name"
                          Style="{StaticResource ComboBoxStyle}"
                          ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                          PreviewKeyDown="MoveFocusOnEnter"/>

                    <TextBlock Text="Note (Optional):" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="200"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="80"
                         VerticalContentAlignment="Top"
                         Style="{StaticResource TextBoxStyle}"
                         PreviewKeyDown="MoveFocusOnEnter"/>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Center">
                        <Button Content="save"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,10,0"/>

                        <Button Content="Clear"
                            Command="{Binding ClearCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Right Panel - Add Items & Grid -->
        <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top Section: Add Items -->
                <Border Background="#F8F9FA" BorderBrush="#E1E8ED" BorderThickness="1"
                    CornerRadius="6" Padding="10" Margin="0,0,0,4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Add Items" Style="{StaticResource SubHeaderTextStyle}" VerticalAlignment="Center" Margin="0"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <!-- Product -->
                                <ColumnDefinition Width="130"/>
                                <!-- Action -->
                                <ColumnDefinition Width="110"/>
                                <!-- Current Stock -->
                                <ColumnDefinition Width="110"/>
                                <!-- Quantity -->
                                <ColumnDefinition Width="100"/>
                                <!-- Add Button -->
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0 0 8 0">
                                <TextBlock Text="Product:" Style="{StaticResource LabelStyle}"/>
                                <ComboBox x:Name="ProductCombobox"
                                      ItemsSource="{Binding Products}"
                                      SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                                      DisplayMemberPath="ProductName"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      PreviewKeyDown="MoveFocusOnEnter"
                                      Style="{StaticResource ComboBoxStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0 0 8 0">
                                <TextBlock Text="Action:" Style="{StaticResource LabelStyle}"/>
                                <ComboBox ItemsSource="{Binding AddorDeduct}"
                                      SelectedItem="{Binding SelectedAddOrDeduct}"
                                      Style="{StaticResource ComboBoxStyle}"
                                      ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                      PreviewKeyDown="MoveFocusOnEnter"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0 0 8 0">
                                <TextBlock Text="Current Stock:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding CurrentStock, StringFormat=N3, FallbackValue='-'}"
                                     IsReadOnly="True"
                                     Style="{StaticResource ReadOnlyTextBoxStyle}"
                                     Foreground="Gray"
                                     FontWeight="Bold"
                                     TextAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="0 0 8 0">
                                <TextBlock Text="Quantity:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding AdjustmentQuantity, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                     Style="{StaticResource TextBoxStyle}"
                                     PreviewKeyDown="MoveFocusOnEnter"
                                     TextAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4" Margin="0" VerticalAlignment="Top">
                                <Button Content="Add"
                                        Width="100"
                                        Height="30"
                                    Command="{Binding AddLineCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="0,20,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Middle Section: DataGrid -->
                <DataGrid Grid.Row="1"
                      ItemsSource="{Binding StockAdjustments}"
                      SelectedItem="{Binding SelectedLine}"
                      Style="{StaticResource DataGridStyle}"
                      Margin="0,4,0,0"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="Action" Binding="{Binding ActionType}" Width="120"/>

                        <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, StringFormat=N3}" Width="120" FontWeight="Bold">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Width="100" Header="Action">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource DeleteButtonStyle}"
                                        ToolTip="Remove line"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Bottom Section: Total Items Footer -->
                <Border Grid.Row="2" Background="#F8F9FA" BorderBrush="#E1E8ED" BorderThickness="1"
                    CornerRadius="6" Padding="8" Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Total Items:" Style="{StaticResource LabelStyle}" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding StockAdjustments.Count}" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
