<UserControl x:Class="PointOfSale.UI.Views.Inventory.StockAdjustmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Stock Adjustment" Style="{StaticResource HeaderTextStyle}"/>

        <TabControl Grid.Row="1"
                    Style="{StaticResource TabControlStyle}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
            <TabItem Header=" New Stock Adjustment " Style="{StaticResource TabItemStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="285"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,8,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="Stock Adjustment Form" Style="{StaticResource SubHeaderTextStyle}"/>

                                <TextBlock Text="Date:" Style="{StaticResource LabelStyle}"/>
                                <DatePicker SelectedDate="{Binding AdjustDate, UpdateSourceTrigger=PropertyChanged}"
                                            IsTodayHighlighted="True"
                                            Style="{StaticResource DatePickerStyle}"
                                            PreviewKeyDown="MoveFocusOnEnter"/>

                                <TextBlock Text="Location:" Style="{StaticResource LabelStyle}"/>
                                <ComboBox x:Name="LocationCombobox"
                                          ItemsSource="{Binding Locations}"
                                          SelectedItem="{Binding SelectedLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          DisplayMemberPath="Name"
                                          IsEditable="True"
                                          Style="{StaticResource ComboBoxStyle}"
                                          ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                          PreviewKeyDown="MoveFocusOnEnter"/>

                                <TextBlock Text="Note:" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                         MaxLength="500"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Height="100"
                                         VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto"
                                         Style="{StaticResource TextBoxStyle}"
                                         PreviewKeyDown="MoveFocusOnEnter"/>

                                <StackPanel Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Center">
                                    <Button Content="Save"
                                            Command="{Binding SaveCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Margin="0,0,10,0"/>

                                    <Button Content="Clear"
                                            Command="{Binding ClearCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}" Margin="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Background="#F8F9FA" BorderBrush="#E1E8ED" BorderThickness="1"
                                    CornerRadius="6" Padding="10" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="Add Items" Style="{StaticResource SubHeaderTextStyle}" VerticalAlignment="Center" Margin="0"/>
                                    </StackPanel>

                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Margin="0 0 8 0">
                                            <TextBlock Text="Product:" Style="{StaticResource LabelStyle}"/>
                                            <ComboBox x:Name="ProductCombobox"
                                                      ItemsSource="{Binding Products}"
                                                      SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                                                      DisplayMemberPath="ProductName"
                                                      TextSearch.TextPath="ProductName"
                                                      IsEditable="True"
                                                      IsTextSearchEnabled="True"
                                                      PreviewKeyDown="MoveFocusOnEnter"
                                                      Style="{StaticResource ComboBoxStyle}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="0 0 8 0">
                                            <TextBlock Text="Line Reason:" Style="{StaticResource LabelStyle}"/>
                                            <TextBox Text="{Binding LineReason, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                                     MaxLength="500"
                                                     Style="{StaticResource TextBoxStyle}"
                                                     PreviewKeyDown="MoveFocusOnEnter"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="0 0 8 0">
                                            <TextBlock Text="Current Stock:" Style="{StaticResource LabelStyle}"/>
                                            <TextBox Text="{Binding CurrentStock, StringFormat=N3}"
                                                     IsReadOnly="True"
                                                     Style="{StaticResource ReadOnlyTextBoxStyle}"
                                                     Foreground="Gray"
                                                     FontWeight="Bold"
                                                     TextAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Margin="0 0 8 0">
                                            <TextBlock Text="Action:" Style="{StaticResource LabelStyle}"/>
                                            <ComboBox ItemsSource="{Binding AddorDeduct}"
                                                      SelectedItem="{Binding SelectedAddOrDeduct}"
                                                      Style="{StaticResource ComboBoxStyle}"
                                                      PreviewKeyDown="MoveFocusOnEnter"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4" Margin="0 0 8 0">
                                            <TextBlock Text="Quantity:" Style="{StaticResource LabelStyle}"/>
                                            <TextBox x:Name="QtyTextBox"
                                                     Text="{Binding AdjustmentQuantity, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                                     MaxLength="20"
                                                     Style="{StaticResource TextBoxStyle}"
                                                     TextAlignment="Center"
                                                     PreviewKeyDown="MoveFocusOnEnter"
                                                     GotKeyboardFocus="SelectAllText_GotFocus"
                                                     PreviewMouseLeftButtonDown="QtyTextBox_PreviewMouseLeftButtonDown"
                                                     PreviewTextInput="QtyTextBox_PreviewTextInput"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="5" Margin="0" VerticalAlignment="Top">
                                            <Button x:Name="AddButton"
                                                    Content="Add"
                                                    Command="{Binding AddLineCommand}"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Click="AddButton_Click"
                                                    Margin="0,20,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding StockAdjustmentLines}"
                                      SelectedItem="{Binding SelectedLine}"
                                      Style="{StaticResource DataGridStyle}"
                                      Margin="0,4,0,0"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*"/>
                                    <DataGridTextColumn Header="Current Stock" Binding="{Binding CurrentStock, StringFormat=N3}" Width="130" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="100"/>
                                    <DataGridTextColumn Header="Quantity" Binding="{Binding AdjustmentQuantity, StringFormat=N3}" Width="120" FontWeight="Bold">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Signed Qty" Binding="{Binding Quantity, StringFormat=N3}" Width="120" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="Reason" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="100" Header="Action">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource DeleteButtonStyle}"
                                                        ToolTip="Remove line"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Row="2" Background="#F8F9FA" BorderBrush="#E1E8ED" BorderThickness="1"
                                    CornerRadius="6" Padding="8" Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Total Items:" Style="{StaticResource LabelStyle}" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding StockAdjustmentLines.Count}" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header=" Adjustment History " Style="{StaticResource TabItemStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource PanelCardStyle}" Margin="0 4 0 0"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="From Date" Style="{StaticResource LabelStyle}" Margin="0,0,0,2"/>
                                <DatePicker SelectedDate="{Binding SearchDateFrom}"
                                            Style="{StaticResource DatePickerStyle}"
                                            Width="150"
                                            Margin="0"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="To Date" Style="{StaticResource LabelStyle}" Margin="0,0,0,2"/>
                                <DatePicker SelectedDate="{Binding SearchDateTo}"
                                            Style="{StaticResource DatePickerStyle}"
                                            Width="150"
                                            Margin="0"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Location" Style="{StaticResource LabelStyle}" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding Locations}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding HistoryLocationId}"
                                          Style="{StaticResource ComboBoxStyle}"
                                          ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                          Width="220"
                                          IsEditable="True"
                                          Margin="0"/>
                            </StackPanel>

                            <Button Command="{Binding SearchCommand}"
                                    Margin="0,16,12,0"
                                    Style="{StaticResource SearchButtonStyle}"
                                    Width="80" Height="30"/>

                            <TextBlock Text="Loading adjustment history..."
                                       Foreground="#64748B"
                                       VerticalAlignment="Center"
                                       Margin="0,16,0,0"
                                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="AdjustmentHistoryDataGrid"
                              Grid.Row="1" Margin="0 4"
                              ItemsSource="{Binding AdjustmentHistory}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              GridLinesVisibility="All"
                              Style="{StaticResource DataGridStyle}"
                              RowDetailsVisibilityMode="Visible"
                              SelectionMode="Single"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource Style.DataGrid.Row}">
                                <Setter Property="Height" Value="Auto"/>
                                <Setter Property="MinHeight" Value="42"/>
                                <Setter Property="DetailsVisibility" Value="Visible"/>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="44">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Width="28"
                                                      Height="28"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      ToolTip="Expand adjustment">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton">
                                                    <Setter Property="Content" Value="&gt;"/>
                                                    <Setter Property="FontFamily" Value="Segoe UI"/>
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Foreground" Value="#334155"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="Focusable" Value="False"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter Property="Content" Value="v"/>
                                                            <Setter Property="ToolTip" Value="Collapse adjustment"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#E5E7EB"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Adjustment #" Binding="{Binding AdjustmentNumber}" Width="140"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding AdjustDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="120"/>
                            <DataGridTextColumn Header="Location" Binding="{Binding LocationName}" Width="160"/>
                            <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
                            <DataGridTemplateColumn Header="Status" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusPillBorderStyle}">
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource StatusPillTextStyle}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Created By" Binding="{Binding CreatedByName}" Width="130"/>
                            <DataGridTextColumn Header="Total Amount"
                                                Binding="{Binding TotalAmount, StringFormat='Rs. {0:N2}'}"
                                                Width="130"
                                                ElementStyle="{StaticResource RightAlignedTextStyle}"
                                                HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}"/>
                        </DataGrid.Columns>

                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <Border Background="#F4F6F8"
                                        BorderBrush="#D8DEE6"
                                        BorderThickness="0,1,0,1"
                                        Margin="0,12,0,12"
                                        Padding="40,0,12,0"
                                        Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        HorizontalAlignment="Stretch"
                                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                    <DataGrid ItemsSource="{Binding Lines}"
                                              Style="{StaticResource DataGridStyle}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              HorizontalAlignment="Stretch"
                                              MinHeight="78"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Disabled">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*"/>
                                            <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="180"/>
                                            <DataGridTextColumn Header="Qty"
                                                                Binding="{Binding Quantity, StringFormat=N3}"
                                                                Width="90"
                                                                ElementStyle="{StaticResource RightAlignedTextStyle}"/>
                                            <DataGridTextColumn Header="Unit Cost"
                                                                Binding="{Binding UnitCost, StringFormat='Rs. {0:N2}'}"
                                                                Width="120"
                                                                ElementStyle="{StaticResource RightAlignedTextStyle}"
                                                                HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}"/>
                                            <DataGridTextColumn Header="Total"
                                                                Binding="{Binding Total, StringFormat='Rs. {0:N2}'}"
                                                                Width="120"
                                                                ElementStyle="{StaticResource RightAlignedTextStyle}"
                                                                HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
