<UserControl
    x:Class="PointOfSale.UI.Views.Inventory.StockAdjustmentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PointOfSale.UI.Views.Inventory"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="285" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Left Panel - Main Form  -->
        <Border Margin="0,0,8,0" Style="{StaticResource PanelCardStyle}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource SubHeaderTextStyle}" Text="Stock Adjustment Form" />

                    <TextBlock Style="{StaticResource LabelStyle}" Text="Adjustment Date:" />
                    <DatePicker
                        IsTodayHighlighted="True"
                        PreviewKeyDown="MoveFocusOnEnter"
                        SelectedDate="{Binding AdjustDate, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource DatePickerStyle}" />

                    <TextBlock Style="{StaticResource LabelStyle}" Text="Location:" />
                    <ComboBox
                        DisplayMemberPath="Name"
                        ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                        ItemsSource="{Binding Locations}"
                        PreviewKeyDown="MoveFocusOnEnter"
                        SelectedItem="{Binding SelectedLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource ComboBoxStyle}" />

                    <TextBlock Style="{StaticResource LabelStyle}" Text="Note (Optional):" />
                    <TextBox
                        Height="80"
                        VerticalContentAlignment="Top"
                        AcceptsReturn="True"
                        MaxLength="200"
                        PreviewKeyDown="MoveFocusOnEnter"
                        Style="{StaticResource TextBoxStyle}"
                        Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />

                    <StackPanel
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Margin="0,0,10,0"
                            Command="{Binding SaveCommand}"
                            Content="save"
                            Style="{StaticResource PrimaryButtonStyle}" />

                        <Button
                            Command="{Binding ClearCommand}"
                            Content="Clear"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--  Right Panel - Add Items & Grid  -->
        <Border
            Grid.Column="1"
            Margin="0"
            Style="{StaticResource PanelCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Top Section: Add Items  -->
                <Border
                    Margin="0,0,0,4"
                    Padding="10"
                    Background="#F8F9FA"
                    BorderBrush="#E1E8ED"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                            <TextBlock
                                Margin="0"
                                VerticalAlignment="Center"
                                Style="{StaticResource SubHeaderTextStyle}"
                                Text="Add Items" />
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <!--  Product  -->
                                <ColumnDefinition Width="130" />
                                <!--  Action  -->
                                <ColumnDefinition Width="110" />
                                <!--  Current Stock  -->
                                <ColumnDefinition Width="110" />
                                <!--  Quantity  -->
                                <ColumnDefinition Width="100" />
                                <!--  Add Button  -->
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource LabelStyle}" Text="Product:" />
                                <ComboBox
                                    x:Name="ProductCombobox"
                                    DisplayMemberPath="ProductName"
                                    IsEditable="True"
                                    IsTextSearchEnabled="True"
                                    ItemsSource="{Binding Products}"
                                    PreviewKeyDown="MoveFocusOnEnter"
                                    SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                                    Style="{StaticResource ComboBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource LabelStyle}" Text="Action:" />
                                <ComboBox
                                    ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                    ItemsSource="{Binding AddorDeduct}"
                                    PreviewKeyDown="MoveFocusOnEnter"
                                    SelectedItem="{Binding SelectedAddOrDeduct}"
                                    Style="{StaticResource ComboBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource LabelStyle}" Text="Current Stock:" />
                                <TextBox
                                    FontWeight="Bold"
                                    Foreground="Gray"
                                    IsReadOnly="True"
                                    Style="{StaticResource ReadOnlyTextBoxStyle}"
                                    Text="{Binding CurrentStock, StringFormat=N3, FallbackValue='-'}"
                                    TextAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource LabelStyle}" Text="Quantity:" />
                                <TextBox
                                    PreviewKeyDown="MoveFocusOnEnter"
                                    Style="{StaticResource TextBoxStyle}"
                                    Text="{Binding AdjustmentQuantity, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                    TextAlignment="Center" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="4"
                                Margin="0"
                                VerticalAlignment="Top">
                                <Button
                                    Width="100"
                                    Height="30"
                                    Margin="0,20,0,0"
                                    Command="{Binding AddLineCommand}"
                                    Content="Add"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!--  Middle Section: DataGrid  -->
                <DataGrid
                    Grid.Row="1"
                    Margin="0,4,0,0"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    IsReadOnly="True"
                    ItemsSource="{Binding StockAdjustments}"
                    SelectedItem="{Binding SelectedLine}"
                    Style="{StaticResource DataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding ProductName}"
                            Header="Product Name" />
                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding ActionType}"
                            Header="Action" />

                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding Quantity, StringFormat=N3}"
                            FontWeight="Bold"
                            Header="Quantity">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Width="100" Header="Action">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button
                                        Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource DeleteButtonStyle}"
                                        ToolTip="Remove line" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!--  Bottom Section: Total Items Footer  -->
                <Border
                    Grid.Row="2"
                    Margin="0,4,0,0"
                    Padding="8"
                    Background="#F8F9FA"
                    BorderBrush="#E1E8ED"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,5,0"
                            Style="{StaticResource LabelStyle}"
                            Text="Total Items:" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="{Binding StockAdjustments.Count}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
