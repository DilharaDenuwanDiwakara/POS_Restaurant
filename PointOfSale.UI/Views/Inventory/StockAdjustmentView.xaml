<UserControl x:Class="PointOfSale.UI.Views.Inventory.StockAdjustmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PointOfSale.UI.Views.Inventory"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Stock Adjustment" Style="{StaticResource HeaderTextStyle}"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="285"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Form -->
            <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Stock Adjustment Form" Style="{StaticResource SubHeaderTextStyle}" Margin="0,0,0,12"/>

                    <!-- Location Name -->
                    <TextBlock Text="Location" Style="{StaticResource LabelStyle}"/>
                    <ComboBox x:Name="LocationCombobox"
                              ItemsSource="{Binding Locations}"
                              SelectedItem="{Binding SelectedLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True"
                              DisplayMemberPath="Name"
                              Style="{StaticResource ComboBoxStyle}"
                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                              PreviewKeyDown="MoveFocusOnEnter"/>

                    <TextBlock Text="Product:" Style="{StaticResource LabelStyle}"/>
                    <ComboBox x:Name="ProductCombobox"
                              ItemsSource="{Binding Products}"
                              SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                              DisplayMemberPath="ProductName"
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              IsTabStop="False"
                              PreviewKeyDown="MoveFocusOnEnter"
                              Style="{StaticResource ComboBoxStyle}"/>

                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Current Stock" Style="{StaticResource LabelStyle}" Foreground="Gray"/>
                            <TextBox Text="{Binding CurrentStock, StringFormat=N3, Mode=OneWay}" 
                                     Style="{StaticResource TextBoxStyle}"
                                     IsReadOnly="True" 
                                     Background="#F0F0F0" 
                                     FontWeight="Bold"
                                     Focusable="False"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Width="120">
                            <TextBlock Text="Action" Style="{StaticResource LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding AddorDeduct}"
                                      SelectedItem="{Binding SelectedAddOrDeduct}"
                                      Style="{StaticResource ComboBoxStyle}"
                                      PreviewKeyDown="MoveFocusOnEnter"/>
                        
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Adjustment Quantity" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding AdjustmentQuantity, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                             MaxLength="20"
                             Style="{StaticResource TextBoxStyle}"
                             PreviewKeyDown="MoveFocusOnEnter"/>

                    <!-- Reason-->
                    <TextBlock Text="Reason" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                            MaxLength="250" 
                            Height="100"
                            Style="{StaticResource TextBoxStyle}"
                            PreviewKeyDown="MoveFocusOnEnter"         
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto"/>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Right">
                        <Button Name="SaveButton"
                                Content="Save"
                                Command="{Binding SaveCommand}" 
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                Click="Save_Click"
                                Style="{StaticResource PrimaryButtonStyle}" />

                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Right Panel - Data Grid -->
                <Border  Style="{StaticResource PanelCardStyle}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Data Grid Header - Fixed Alignment -->
                        <Border Background="#F1F2F6" Padding="12,8" Margin="0 4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" 
                                               Text="Adjust List" 
                                               Style="{StaticResource SubHeaderTextStyle}" 
                                               VerticalAlignment="Center"
                                               Margin="0 0 12 0"/>

                                <Button Grid.Column="1" Visibility="Visible"
                                            Command="{Binding RefreshCommand}" 
                                            Style="{StaticResource RefreshButtonStyle}" 
                                            ToolTip="Refresh List">

                                </Button>
                            </Grid>
                        </Border>

                        <!-- Data Grid -->
                        <DataGrid Grid.Row="1" 
                                      ItemsSource="{Binding StockAdjustments}" 
                                      SelectedItem="{Binding SelectedBrand, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,0,0,0"
                                      AutoGenerateColumns="False"
                                      SelectionMode="Single"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      Style="{StaticResource DataGridStyle}">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding StockAdjustmentId}" Width="Auto" Visibility="Hidden"/>
                                <DataGridTextColumn Header="AdjustDate" Binding="{Binding AdjustDate}" Width="Auto"/>
                                <DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="AUto"/>
                                <DataGridTextColumn Header="Location" Binding="{Binding LocationName}" Width="Auto"/>
                                <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, StringFormat=N3}" Width="Auto"/>
                                <DataGridTemplateColumn Header="Reason" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource PanelCardStyle}" Margin="0 4 0 0" Visibility="Collapsed">
                    <Grid>
                        <Button Command="{Binding BrowseAndImportCommand}"
                                    Content="Import Opening Stock"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Width="180" Height="40"
                                    ToolTip="Import Opening Stock from Excel"
                                    HorizontalAlignment="Right" Visibility="Collapsed"/>

                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
