<Window x:Class="PointOfSale.UI.Views.Inventory.Dialogs.WastageReason"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PointOfSale.UI.Views.Inventory.Dialogs"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Height="450" Width="650">

    <Border Style="{StaticResource WindowBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource Brush.Structure.Sidebar}"
                    CornerRadius="8,8,0,0"
                    Padding="10,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Wastage Reason" 
                                   Foreground="{StaticResource Brush.Text.OnDark}" 
                                   Style="{StaticResource HeaderTextStyle}"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource IconOnlyButtonStyle}"
                            Background="Transparent"
                            Click="CloseButton_Click"
                            ToolTip="Close">
                        <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                              Fill="{StaticResource Brush.Text.OnDark}"
                              Width="12" Height="12" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="285"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Reason Form" Style="{StaticResource SubHeaderTextStyle}" Margin="0,0,0,12"/>

                        <TextBlock Text="Reason:" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="ReasonTextBox"
                                 Text="{Binding ReasonName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 MaxLength="100"
                                 CharacterCasing="Upper"
                                 Style="{StaticResource TextBoxStyle}"
                                 PreviewKeyDown="MoveFocusOnEnter"/>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Center">
                            <Button Content="{Binding SaveButtonText}"
                                    Command="{Binding SaveReasonCommand}" 
                                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                    Style="{StaticResource PrimaryButtonStyle}" 
                                    Margin="0,0,12,0"/>

                            <Button Content="Edit" 
                                    Command="{Binding EditReasonCommand}" 
                                    Style="{StaticResource SecondaryButtonStyle}"/>

                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Background="#F1F2F6" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" 
                                           Text="Reason List" 
                                           Style="{StaticResource SubHeaderTextStyle}" 
                                           VerticalAlignment="Center"
                                           Margin="0"/>

                                <Button Grid.Column="3"
                                        Command="{Binding DeleteReasonCommand}" 
                                        Style="{StaticResource DeleteButtonStyle}" 
                                        ToolTip="Delete Reason">
                                </Button>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1" 
                                  ItemsSource="{Binding ReasonList}" 
                                  SelectedItem="{Binding SelectedReason, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,0,0,0"
                                  AutoGenerateColumns="False"
                                  SelectionMode="Single"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  Style="{StaticResource DataGridStyle}">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding WastageReasonId}" Width="Auto" Visibility="Hidden"/>
                                <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/>
                            </DataGrid.Columns>

                        </DataGrid>

                    </Grid>
                </Border>

            </Grid>

        </Grid>
    </Border>
</Window>
