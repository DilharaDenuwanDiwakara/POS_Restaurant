<UserControl x:Class="PointOfSale.UI.Views.Inventory.SubRecipeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="620"
             d:DesignWidth="1100"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Sub-Recipes"
                       Style="{StaticResource HeaderTextStyle}" />

            <Button Grid.Column="1"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource RefreshButtonStyle}"
                    ToolTip="Refresh Sub-Recipes" />
        </Grid>

        <Border Grid.Row="1"
                Margin="0,12,0,0"
                Style="{StaticResource PanelCardStyle}">
            <Grid IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      MaxWidth="720"
                      HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="520" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Prep Item"
                                   Style="{StaticResource LabelStyle}" />
                        <ComboBox ItemsSource="{Binding PrepItems}"
                                  SelectedItem="{Binding SelectedPrepItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="ProductId"
                                  DisplayMemberPath="ProductName"
                                  TextSearch.TextPath="ProductName"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  IsTextSearchCaseSensitive="False"
                                  PreviewKeyDown="MoveFocusOnEnter"
                                  Style="{StaticResource ComboBoxStyle}" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Margin="12,20,0,0"
                            Padding="14,7"
                            MinWidth="120"
                            Background="#EEF4FF"
                            BorderBrush="#C9D8FF"
                            BorderThickness="1"
                            CornerRadius="4"
                            VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Base UOM"
                                       FontSize="10"
                                       Foreground="#5F6B85" />
                            <TextBlock Text="{Binding SelectedPrepItem.UnitMeasureName, TargetNullValue='-'}"
                                       FontWeight="SemiBold"
                                       Foreground="#223B8F" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="1"
                      Margin="0,18,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Ingredient"
                                   Style="{StaticResource LabelStyle}" />
                        <ComboBox x:Name="IngredientComboBox"
                                  ItemsSource="{Binding Ingredients}"
                                  SelectedItem="{Binding SelectedIngredient, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="ProductId"
                                  DisplayMemberPath="ProductName"
                                  TextSearch.TextPath="ProductName"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  IsTextSearchCaseSensitive="False"
                                  PreviewKeyDown="MoveFocusOnEnter"
                                  Style="{StaticResource ComboBoxStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Margin="0,0,12,0">
                        <TextBlock Text="Unit Measure"
                                   Style="{StaticResource LabelStyle}" />
                        <ComboBox ItemsSource="{Binding AvailableUnitMeasures}"
                                  SelectedValue="{Binding SelectedUnitMeasureId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="UnitMeasureId"
                                  DisplayMemberPath="UnitMeasureName"
                                  TextSearch.TextPath="UnitMeasureName"
                                  IsTextSearchEnabled="True"
                                  PreviewKeyDown="MoveFocusOnEnter"
                                  Style="{StaticResource ComboBoxStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Margin="0,0,12,0">
                        <TextBlock Text="Quantity"
                                   Style="{StaticResource LabelStyle}" />
                        <TextBox Text="{Binding QuantityInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="MoveFocusOnEnter"
                                 Style="{StaticResource TextBoxStyle}" />
                    </StackPanel>

                    <Button Grid.Column="3"
                            x:Name="AddIngredientButton"
                            Content="Add Ingredient"
                            Command="{Binding AddIngredientCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="AddIngredientButton_Click"
                            PreviewKeyDown="MoveFocusOnEnter"
                            Width="150"
                            VerticalAlignment="Bottom" />
                </Grid>

                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding RecipeLines}"
                          SelectedItem="{Binding SelectedRecipeLine}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          Style="{StaticResource DataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ingredient"
                                            Binding="{Binding ProductName}"
                                            Width="*" />
                        <DataGridTextColumn Header="Unit"
                                            Binding="{Binding UnitMeasureName}"
                                            Width="180" />
                        <DataGridTextColumn Header="Quantity"
                                            Binding="{Binding Quantity, StringFormat=N3}"
                                            Width="140" />
                        <DataGridTextColumn Header="Std. Cost"
                                            Binding="{Binding StandardCost, StringFormat='Rs. {0:N2}'}"
                                            Width="130" />
                        <DataGridTextColumn Header="Line Cost"
                                            Binding="{Binding LineCost, StringFormat='Rs. {0:N2}'}"
                                            Width="130" />
                        <DataGridTemplateColumn Header=""
                                                Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Remove"
                                            Command="{Binding DataContext.RemoveIngredientCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource DeleteButtonStyle}"
                                            ToolTip="Remove ingredient" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="3"
                        Margin="0,10,0,0"
                        Padding="16,12"
                        Background="#F7F9FC"
                        BorderBrush="#E0E6F0"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Total Recipe Cost"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="#334155" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding TotalRecipeCost, StringFormat='Rs. {0:N2}'}"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#223B8F" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,18,0,0">
                    <TextBlock Text="Saving..."
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"
                               Style="{StaticResource LabelStyle}"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Save Sub-Recipe"
                            Command="{Binding SaveSubRecipeCommand}"
                            PreviewKeyDown="MoveFocusOnEnter"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="180" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
