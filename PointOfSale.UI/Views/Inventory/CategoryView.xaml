<UserControl x:Class="PointOfSale.UI.Views.Inventory.CategoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PointOfSale.UI.Views.Inventory"
             mc:Ignorable="d" 
             d:DesignHeight="520" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <!-- Layout define -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="Product Category Management" Style="{StaticResource HeaderTextStyle}"/>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="285"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Form -->
            <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Category Form" Style="{StaticResource SubHeaderTextStyle}" />

                    <!-- Category Code -->
                    <TextBlock Text="Category Code:" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="CategoryCodeTextBox"
                             Text="{Binding Code, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, ValidatesOnNotifyDataErrors=True}"
                             Style="{StaticResource TextBoxStyle}" 
                             MaxLength="3"
                             CharacterCasing="Upper"
                             PreviewKeyDown="MoveFocusOnEnter"/>
                    
                    <!-- Category Name -->
                    <TextBlock Text="Category Name:" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                             Style="{StaticResource TextBoxStyle}" 
                             MaxLength="50"
                             CharacterCasing="Upper"
                             PreviewKeyDown="MoveFocusOnEnter"/>

                    <!-- Parent Category -->
                    <TextBlock Text="Parent Category:" Style="{StaticResource LabelStyle}"/>
                    <ComboBox ItemsSource="{Binding ParentCategoryList}"
                              SelectedValue="{Binding SelectedParentId, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValuePath="Id"
                              TextSearch.TextPath="DisplayName"
                              Style="{StaticResource ComboBoxStyle}"
                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                              ItemTemplate="{StaticResource HierarchicalCategoryTemplate}"
                              PreviewKeyDown="MoveFocusOnEnter"/>

                    <!-- Product category account mappings - parent categories only -->
                    <StackPanel Visibility="{Binding IsParentCategory, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Stock Account:" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding StockChartOfAccounts}"
                                  DisplayMemberPath="DisplayText"
                                  SelectedValuePath="Code"
                                  SelectedValue="{Binding StockAccountCode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                  IsEditable="True"
                                  TextSearch.TextPath="DisplayText"
                                  Style="{StaticResource ComboBoxStyle}"
                                  ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                  PreviewKeyDown="MoveFocusOnEnter"/>

                        <TextBlock Text="Cost Of Sales Account:" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding CostOfSalesChartOfAccounts}"
                                  DisplayMemberPath="DisplayText"
                                  SelectedValuePath="Code"
                                  SelectedValue="{Binding CostOfSalesAccountCode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                  IsEditable="True"
                                  TextSearch.TextPath="DisplayText"
                                  Style="{StaticResource ComboBoxStyle}"
                                  ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                  PreviewKeyDown="MoveFocusOnEnter"/>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Center">
                        <Button Content="{Binding SaveButtonText}"
                                Name="SubmitButton"
                                Command="{Binding SaveCategoryCommand}" 
                                Click="Save_Click"
                                Style="{StaticResource PrimaryButtonStyle}" 
                                Margin="0,0,12,0"/>

                        <Button Content="Edit" 
                                Command="{Binding EditCategoryCommand}" 
                                Style="{StaticResource SecondaryButtonStyle}"/>
                        
                    </StackPanel>
                    
                </StackPanel>
            </Border>

            <!-- Center Panel - Data Grid -->
            <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Data Grid Header - Fixed Alignment -->
                    <Border Background="#F1F2F6" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" 
                                       Text="Category List" 
                                       Style="{StaticResource SubHeaderTextStyle}" 
                                       VerticalAlignment="Center"
                                       Margin="0"/>

                            <Button Grid.Column="1"
                                    Command="{Binding LoadCategoryCommand}" 
                                    Style="{StaticResource RefreshButtonStyle}" 
                                    ToolTip="Refresh Category List"
                                    Margin="10,0,0,0">
                            </Button>

                            <Button Grid.Column="3"
                                    Command="{Binding DeleteCategoryCommand}" 
                                    Style="{StaticResource DeleteButtonStyle}" 
                                    ToolTip="Delete Supplier">
                               
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Data Grid -->
                    <DataGrid Grid.Row="1" 
                              ItemsSource="{Binding CategoryList}" 
                              SelectedItem="{Binding SelectedCategory, UpdateSourceTrigger=PropertyChanged}" 
                              Style="{StaticResource DataGridStyle}"
                              Margin="0,4,0,0"
                              AutoGenerateColumns="False"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              IsReadOnly="True">
                        
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding SupplierId}" Width="Auto"  Visibility="Hidden"/>
                            <DataGridTextColumn Header="Category Code" Binding="{Binding Code}" Width="Auto" />
                            <DataGridTextColumn Header="Category Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Parent Category" Binding="{Binding ParentCategoryName}" Width="Auto"/>
                            <DataGridTextColumn Header="Stock Acc. Code" Binding="{Binding StockAccountCode}" Width="120"/>
                            <DataGridTextColumn Header="Cost Acc. Code" Binding="{Binding CostOfSalesAccountCode}" Width="120"/>
                        </DataGrid.Columns>
                        
                    </DataGrid>
                    
                </Grid>
            </Border>

            <!-- Right Panel - Hiegrarchy -->
            <Border Grid.Column="2" Style="{StaticResource PanelCardStyle}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Hierarchy Tree" Style="{StaticResource SubHeaderTextStyle}"/>

                    <TreeView Grid.Row="1" ItemsSource="{Binding CategoryTree}" BorderThickness="0">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Text="📁" Foreground="{StaticResource SecondaryBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding Code, StringFormat=' ({0})'}" Foreground="Gray" FontSize="11"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>

                        <TreeView.ItemContainerStyle>
                            <Style TargetType="{x:Type TreeViewItem}">
                                <Setter Property="IsExpanded" Value="False"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        
                    </TreeView>
                </Grid>
            </Border>
            
        </Grid>
        
    </Grid>

</UserControl>
