<Window x:Class="PointOfSale.UI.Views.Inventory.BatchSelectionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PointOfSale.UI.Views.Inventory" 
        xmlns:conv="clr-namespace:PointOfSale.UI.Converters"
        mc:Ignorable="d"
        Height="450" Width="800"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Border Style="{StaticResource WindowBorderStyle}">
        <Grid >
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource Brush.Structure.Sidebar}"
                    CornerRadius="8,8,0,0"
                    Padding="10,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center">
                            <TextBlock Text="Product Batch" 
                                       Foreground="{StaticResource Brush.Text.OnDark}" 
                                       Style="{StaticResource HeaderTextStyle}" 
                                       Margin="0"/>
                        </TextBlock>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Background="Transparent"
                            Style="{StaticResource IconOnlyButtonStyle}"
                            Click="CloseButton_Click"
                            ToolTip="Close">

                        <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                              Fill="{StaticResource Brush.Text.OnDark}"
                              Width="12" Height="12" Stretch="Uniform"/>

                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock
                        Text="This product has multiple cost prices / batches. Please select a batch:"
                        Margin="0,0,0,10"
                        Style="{StaticResource LabelStyle}"/>

                <DataGrid Grid.Row="1"
                          x:Name="BatchesDataGrid"
                          AutoGenerateColumns="False"
                          ItemsSource="{Binding AvailableBatches}"
                          SelectedItem="{Binding SelectedBatch, Mode=Default}"
                          Style="{StaticResource DataGridStyle}"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          PreviewKeyDown="BatchesDataGrid_PreviewKeyDown">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Batch ID" Binding="{Binding BatchId}" Width="*" Visibility="Hidden"/>
                        <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="Auto"/>
                        <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="Available Qty" Binding="{Binding AvailableQuantity}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Received Date"
                                        Binding="{Binding ReceivedDate, StringFormat=\{0:dd-MMM-yyyy\}}"
                                        Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Unit Cost"
                                        Binding="{Binding UnitCost, StringFormat='Rs. {0:N2}'}"
                                        Width="120"
                                        Visibility="{Binding Context, Converter={StaticResource BatchContextToVisibilityConverter}, ConverterParameter=UnitCost}" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Margin" Value="0,0,5,0" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>

                        </DataGridTextColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,10,0,0">
                
                    <Button Content="OK"
                            IsDefault="True"
                            Margin="0,0,10,0"
                            Click="OkButton_Click"
                            Command="{Binding SelectBatchCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"/>

                    <Button Content="Cancel"
                            IsCancel="True"
                            Click="CancelButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>
            </Grid>
            
        </Grid>
    </Border>
</Window>
