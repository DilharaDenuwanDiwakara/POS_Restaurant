<UserControl x:Class="PointOfSale.UI.Views.Inventory.ProductListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PointOfSale.UI.Views.Inventory"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="Product List" Style="{StaticResource HeaderTextStyle}"/>

        <Border Grid.Row="1" Style="{StaticResource PanelCardStyle}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Background="#F1F2F6" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Location:" VerticalAlignment="Center" Style="{StaticResource LabelStyle}" Margin="0,0,5,0"/>

                        <ComboBox Grid.Row="1"  Grid.Column="0"
                                  ItemsSource="{Binding Locations, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                  SelectedItem="{Binding SelectedLocation, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  Width="150"
                                  Style="{StaticResource ComboBoxStyle}"
                                  Margin="0 0 12 0"/>

                        <TextBlock Grid.Column="1"
                                   Text="Category" 
                                   Style="{StaticResource LabelStyle}" />

                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, ValidatesOnNotifyDataErrors=True}"
                                  SelectedValuePath="Id"
                                  SelectedIndex="0"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  TextSearch.TextPath="DisplayName"
                                  Width="220"
                                  Style="{StaticResource ComboBoxStyle}"
                                  ItemTemplate="{StaticResource HierarchicalCategoryTemplate}"
                                  Margin="0"/> 

                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="Item Type"
                                   Style="{StaticResource LabelStyle}"
                                   Margin="12,0,0,0"/>

                        <ComboBox Grid.Row="1" Grid.Column="2"
                                  ItemsSource="{Binding ItemTypes}"
                                  SelectedItem="{Binding SelectedItemType, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                  DisplayMemberPath="TypeName"
                                  SelectedValuePath="Id"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  TextSearch.TextPath="TypeName"
                                  Width="180"
                                  Style="{StaticResource ComboBoxStyle}"
                                  Margin="12,0,0,0"/>

                        <TextBlock Grid.Row="0" Grid.Column="3" 
                                   Text="Code / Name" 
                                   Style="{StaticResource LabelStyle}" 
                                   Margin="12,0,0,0"/>

                        <TextBox Grid.Row="1" Grid.Column="3"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SearchTextBoxStyle}"
                                 CharacterCasing="Upper"
                                 Width="220"
                                 VerticalAlignment="Top"
                                 PreviewTextInput="AlphaNumericWithSpace_PreviewTextInput"
                                 DataObject.Pasting="AlphaNumericWithSpace_Pasting"
                                 Margin="12,0,0,0"/>

                        <Button Grid.Row="1" Grid.Column="4"
                                Command="{Binding SearchProductCommand}" 
                                Style="{StaticResource SearchButtonStyle}" 
                                ToolTip="Search Products"
                                VerticalAlignment="Center"
                                Margin="8,0,0,0">
                            
                        </Button>
                    </Grid>
                </Border>

                <!-- Data Grid -->
                <DataGrid Grid.Row="1" 
                          ItemsSource="{Binding ProductList}" 
                          Style="{StaticResource DataGridStyle}"
                          Margin="0 4"
                          AutoGenerateColumns="False"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding ProductId}" Width="Auto" Visibility="Hidden"/>
                        <DataGridTextColumn Header="Product Code" Binding="{Binding ProductCode}" Width="120"/>
                        <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="Auto"/>
                        <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="Auto" />
                        <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="200" />
                        <DataGridTextColumn Header="Item Type" Binding="{Binding ItemTypeName}" Width="150" />
                        
                        <DataGridTextColumn Header="Cost Price" Binding="{Binding StandardCost, StringFormat='Rs. {0:N2}'}" Width="120" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Selling Price" Binding="{Binding SellingPrice, StringFormat='Rs. {0:N2}'}" Width="Auto" Visibility="Collapsed" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Reorder Point" Binding="{Binding ReorderPoint}" Width="120" >
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        
                        <DataGridTextColumn Header="Available Qty" Binding="{Binding AvailableQuantity, StringFormat=N3}" Width="120" >
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Unit Measure" Binding="{Binding UnitMeasureName}" Width="150" />

                        <DataGridTextColumn Header="Add.Stock Qty" Binding="{Binding AdditionalStockQuantity}" Width="120" >
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Wastage %" Binding="{Binding WastagePercentage}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridCheckBoxColumn Header="Purchasable" Binding="{Binding IsPurchasable}" Width="Auto" />
                        <DataGridCheckBoxColumn Header="TrackExpiry" Binding="{Binding TrackExpiry}" Width="100" />
                        <DataGridCheckBoxColumn Header="Taxable" Binding="{Binding IsTaxApplicable}" Width="90" />
                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="100" />
                        
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Summary Section -->
                <Border Grid.Row="2" Style="{StaticResource PanelCardStyle}" Margin="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Section - Total Products -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Total Products: " 
                                       Style="{StaticResource LabelStyle}"/>
                            <TextBlock Text="{Binding TotalProductCount}" 
                                       Style="{StaticResource LabelStyle}"
                                       Margin="4,0,0,0"/>
                        </StackPanel>
                        
                        <!-- Right Section - Product Breakdown -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                            <!-- Active Products -->
                            <Border Style="{StaticResource Style.Badge.Success}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Active: " FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="{Binding ActiveProductCount}" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>
                            </Border>

                            <!-- Inactive Products -->
                            <Border Style="{StaticResource Style.Badge.Danger}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Inactive: " FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="{Binding InactiveProductCount}" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>
                            </Border>

                            <!-- Low Stock Warning -->
                            <Border Style="{StaticResource Style.Badge.Warning}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Low Stock: " FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="{Binding LowStockProductCount}" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                        
                    </Grid>
                </Border>
            </Grid>
        </Border>
        
    </Grid>
</UserControl>
