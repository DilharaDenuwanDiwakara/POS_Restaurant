<UserControl x:Class="PointOfSale.UI.Views.Inventory.BatchProductionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="520"
             d:DesignWidth="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Batch Production" Style="{StaticResource HeaderTextStyle}"/>

        <Grid Grid.Row="1"
              Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="18"
                        Background="White"
                        BorderBrush="#E0E6F0"
                        BorderThickness="1"
                        CornerRadius="4"
                        VerticalAlignment="Top">
                    <Grid IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Production Input"
                                   Style="{StaticResource SubHeaderTextStyle}"
                                   Margin="0,0,0,14"/>

                        <StackPanel Grid.Row="1">
                            <TextBlock Text="Location" Style="{StaticResource LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Locations}"
                                      SelectedValue="{Binding SelectedLocationId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Name"
                                      IsTextSearchEnabled="True"
                                      Style="{StaticResource ComboBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,14,0,0">
                            <TextBlock Text="Item to Produce" Style="{StaticResource LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding PrepItems}"
                                      SelectedItem="{Binding SelectedProduct, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="ProductId"
                                      DisplayMemberPath="ProductName"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      Style="{StaticResource ComboBoxStyle}"/>
                        </StackPanel>

                        <Grid Grid.Row="3" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Available Qty" Style="{StaticResource LabelStyle}"/>
                                <Border Height="36"
                                        Background="#F7F9FC"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <TextBlock Text="{Binding SelectedProductAvailableQuantity, StringFormat={}{0:N3}}"
                                               VerticalAlignment="Center"
                                               Margin="10,0"
                                               FontWeight="SemiBold"
                                               Foreground="#334155"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="UOM" Style="{StaticResource LabelStyle}"/>
                                <Border Height="36"
                                        Background="#F7F9FC"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <TextBlock Text="{Binding TargetUomName, TargetNullValue='-'}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Foreground="#334155"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="4" Margin="0,14,0,0">
                            <TextBlock Text="Yield Quantity" Style="{StaticResource LabelStyle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Text="{Binding ProducedQuantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource TextBoxStyle}"/>
                                <Border Grid.Column="1"
                                        Margin="10,0,0,0"
                                        Padding="12,0"
                                        MinWidth="110"
                                        Height="36"
                                        Background="#F7F9FC"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <TextBlock Text="{Binding TargetUomName, TargetNullValue='-'}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Foreground="#334155"/>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="5"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,24,0,0">
                            <TextBlock Text="Processing..."
                                       VerticalAlignment="Center"
                                       Margin="0,0,16,0"
                                       Style="{StaticResource LabelStyle}"
                                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                            <Button Content="Process Batch"
                                    Command="{Binding ProcessBatchCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Width="180"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Padding="18"
                        Background="White"
                        BorderBrush="#E0E6F0"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Production History"
                                   Style="{StaticResource SubHeaderTextStyle}"
                                   Margin="0,0,0,14"/>

                        <Border Grid.Row="1"
                                Background="#F8F9FA"
                                BorderBrush="#E1E8ED"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10"
                                Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="From Date" Style="{StaticResource LabelStyle}"/>
                                    <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource DatePickerStyle}"
                                                Width="150"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="To Date" Style="{StaticResource LabelStyle}"/>
                                    <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource DatePickerStyle}"
                                                Width="150"/>
                                </StackPanel>

                                <Button Content="Search"
                                        Command="{Binding SearchHistoryCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Width="100"
                                        Margin="0,18,0,0"/>
                            </StackPanel>
                        </Border>

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding RecentProductions}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  Style="{StaticResource DataGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Item"
                                                    Binding="{Binding ItemName}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Yield Qty"
                                                    Binding="{Binding YieldQuantity, StringFormat={}{0:N3}}"
                                                    Width="130"/>
                                <DataGridTextColumn Header="UOM"
                                                    Binding="{Binding UnitMeasureName}"
                                                    Width="130"/>
                                <DataGridTextColumn Header="Time"
                                                    Binding="{Binding ProcessedAt, StringFormat={}{0:t}}"
                                                    Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
        </Grid>
    </Grid>
</UserControl>
