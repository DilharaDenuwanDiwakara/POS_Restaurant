<UserControl x:Class="PointOfSale.UI.Views.Inventory.InventoryReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:PointOfSale.UI.Views.Inventory"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadDataCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== LEFT PANEL: Report Parameters ===== -->
        <Border Style="{StaticResource PanelCardStyle}" Margin="0 0 8 0">
            <StackPanel>

                <TextBlock Text="Inventory Reports"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"
                           Style="{StaticResource SubHeaderTextStyle}"/>

                <!-- Always-visible: Branch + Report Type -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0 0 12 0">
                        <TextBlock Text="Select Branch:" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding Branches}"
                                  SelectedItem="{Binding SelectedBranch}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource ComboBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0 0 12 0">
                        <TextBlock Text="Select Location:" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding Locations}"
                                  SelectedItem="{Binding SelectedLocation}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource ComboBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Select Report Type:" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding ReportTypes}"
                                  SelectedItem="{Binding SelectedReportType}"
                                  Style="{StaticResource ComboBoxStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- ===== STANDARD REPORT PARAMETERS ===== -->
                <!-- Visible for: Current Inventory Stock, Reorder Level List, Expiry Reach List -->
                <StackPanel Visibility="{Binding IsStandardReportSelected, Converter={StaticResource BoolToVisibility}}">

                    <TextBlock Text="As Of Date:" Style="{StaticResource LabelStyle}"/>
                    <DatePicker SelectedDate="{Binding ReportDate}"
                                Style="{StaticResource DatePickerStyle}"
                                Margin="0,0,0,12"/>

                    <!-- Category filter: only relevant for "Current Inventory Stock" -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedReportType}" Value="Reorder Level List">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SelectedReportType}" Value="Expiry Reach List">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="Filter by Category:" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory}"
                                  SelectedValuePath="Id"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  TextSearch.TextPath="DisplayName"
                                  ItemTemplate="{StaticResource HierarchicalCategoryTemplate}"
                                  Style="{StaticResource ComboBoxStyle}"
                                  Margin="0,0,0,12"/>
                    </StackPanel>

                </StackPanel>

                <!-- ===== LEDGER REPORT PARAMETERS ===== -->
                <!-- Visible only when "Stock Movement Ledger" is selected -->
                <StackPanel Visibility="{Binding IsLedgerReportSelected, Converter={StaticResource BoolToVisibility}}">

                    <!-- Row 1: Date Range -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0 0 6 0">
                            <TextBlock Text="Start Date:" Style="{StaticResource LabelStyle}"/>
                            <DatePicker SelectedDate="{Binding StartDate}"
                                        Style="{StaticResource DatePickerStyle}"
                                        Margin="0,0,0,12"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="6 0 0 0">
                            <TextBlock Text="End Date:" Style="{StaticResource LabelStyle}"/>
                            <DatePicker SelectedDate="{Binding EndDate}"
                                        Style="{StaticResource DatePickerStyle}"
                                        Margin="0,0,0,12"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Select Product:" Style="{StaticResource LabelStyle}"/>
                    <ComboBox ItemsSource="{Binding Products}"
                              SelectedItem="{Binding SelectedProduct}"
                              DisplayMemberPath="ProductName"
                              SelectedValuePath="ProductId"
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              TextSearch.TextPath="ProductName"
                              Style="{StaticResource ComboBoxStyle}"
                              Margin="0,0,0,12"/>

                </StackPanel>

                <!-- Generate Button (always visible) -->
                <Button Command="{Binding GenerateReportCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="45" Width="200"
                        HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="GENERATE REPORT" Margin="5,0"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Border>

        <!-- ===== RIGHT PANEL: Pie Chart ===== -->
        <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Inventory Value by Category"
                           HorizontalAlignment="Center"
                           Style="{StaticResource SubHeaderTextStyle}"
                           Margin="0,0,0,20"/>

                <lvc:PieChart Grid.Row="1"
                              Series="{Binding InventoryValueSeries}"
                              InitialRotation="-90"
                              LegendPosition="Right"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.ColumnSpan="2"
                Style="{StaticResource PanelCardStyle}" Margin="0 8 0 0">
            <TextBlock Text="Row 2, Col 1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#AAA"/>
        </Border>

    </Grid>
</UserControl>
