<UserControl x:Class="PointOfSale.UI.Views.Purchasing.GoodsPurchaseNoteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PointOfSale.UI.Views.Purchasing"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <TabControl Style="{StaticResource TabControlStyle}" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

            <TabItem Header=" New Purchase Order " Style="{StaticResource TabItemStyle}">
                <!-- Main Content -->
                <Grid Margin="0,4,0,0">
                    
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="285"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Panel - PO Header -->
                    <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,8,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="Purchase Order Form" Style="{StaticResource SubHeaderTextStyle}"/>

                                <!-- Received Date -->
                                <TextBlock Text="Order Date:" Style="{StaticResource LabelStyle}"/>
                                <DatePicker SelectedDate="{Binding PurchaseDate, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                            IsTodayHighlighted="True"
                                            Style="{StaticResource DatePickerStyle}"
                                            Validation.ErrorTemplate="{StaticResource ErrorTemplate}"
                                            PreviewKeyDown="MoveFocusOnEnter"/>

                                <TextBlock Text="Expected Delivery:" Style="{StaticResource LabelStyle}"/>
                                <DatePicker SelectedDate="{Binding ExpectedDeliveryDate, UpdateSourceTrigger=PropertyChanged}"
                                            IsTodayHighlighted="True"
                                            Style="{StaticResource DatePickerStyle}"
                                            PreviewKeyDown="MoveFocusOnEnter"/>

                                <!-- Supplier Name -->
                                <TextBlock Text="Supplier:" Style="{StaticResource LabelStyle}"/>
                                <ComboBox x:Name="SupplierComboBox"
                                              ItemsSource="{Binding Suppliers}"
                                              SelectedItem="{Binding SelectedSupplier, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, ValidatesOnNotifyDataErrors=True}"
                                              DisplayMemberPath="SupplierName"
                                              SelectedValuePath="SupplierId"
                                              IsEditable="True"
                                              IsTextSearchEnabled="True"
                                              TextSearch.TextPath="SupplierName"
                                              Style="{StaticResource ComboBoxStyle}"
                                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                              PreviewKeyDown="MoveFocusOnEnter"/>

                                <!-- Received By -->
                                <TextBlock Text="Request By:" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="ReceivedByTextBox"
                                             Text="{Binding OrderBy, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                             MaxLength="100"
                                             CharacterCasing="Upper"
                                             Style="{StaticResource TextBoxStyle}" 
                                             Validation.ErrorTemplate="{StaticResource ErrorTemplate}"
                                             PreviewKeyDown="MoveFocusOnEnter"/>

                                <!-- Note -->
                                <TextBlock Text="Note:" Style="{StaticResource LabelStyle}"/>
                                <TextBox x:Name="NoteTextBox" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                             MaxLength="500"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             Height="60"
                                             VerticalContentAlignment="Top"
                                             Style="{StaticResource TextBoxStyle}"
                                             Validation.ErrorTemplate="{StaticResource ErrorTemplate}"
                                             PreviewKeyDown="MoveFocusOnEnter"/>

                                <!-- GRN Action Buttons -->
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Center">
                                    <Button Content="Save"
                                                Command="{Binding SavePOCommand, UpdateSourceTrigger=PropertyChanged}" 
                                                Style="{StaticResource PrimaryButtonStyle}" 
                                                Margin="0,0,12,0"/>

                                    <Button Content="Clear" 
                                                Command="{Binding NewPOCommand}" 
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Focusable="False"/>

                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Right Panel - Items Management -->
                    <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}" Margin="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Item Entry Form -->
                            <Border Background="#F8F9FA" BorderBrush="#E1E8ED" BorderThickness="1" 
                                        CornerRadius="6" Padding="8" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Add Item" Style="{StaticResource SubHeaderTextStyle}"/>

                                    <Grid Grid.Row="1" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Margin="0 0 8 0">
                                            <TextBlock Text="Code / Barcode:" Style="{StaticResource LabelStyle}"/>
                                            <TextBox x:Name="BarcodeTextBox"
                                                     Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                     Style="{StaticResource TextBoxStyle}" Margin="0"
                                                     MaxLength="50"
                                                     PreviewKeyDown="BarcodeTextBox_PreviewKeyDown"/>

                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="0 0 8 0">
                                            <TextBlock Text="Product:" Style="{StaticResource LabelStyle}"/>
                                            <ComboBox x:Name="ProductComboBox"
                                                    ItemsSource="{Binding Products}"
                                                    SelectedItem="{Binding SelectedProduct, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, ValidatesOnNotifyDataErrors=True}"
                                                    SelectedValuePath="ProductId"
                                                    DisplayMemberPath="ProductName"
                                                    IsEditable="True"
                                                    IsTextSearchEnabled="True"
                                                    TextSearch.TextPath="ProductName"
                                                    Style="{StaticResource ComboBoxStyle}"
                                                    ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                                    Margin="0"
                                                    PreviewKeyDown="MoveFocusOnEnter"/>

                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Margin="0 0 8 0">
                                            <TextBlock Text="UOM:" Style="{StaticResource LabelStyle}"/>
                                            <Border Background="#EAF2FB" BorderBrush="#5B8DB8" BorderThickness="1"
                                                    CornerRadius="4" Height="30" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding SelectedUnitMeasureName}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           FontSize="12" FontWeight="SemiBold" Foreground="#2C5F8A"
                                                           Padding="4,0"/>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Margin="0 0 8 0">
                                            <TextBlock Text="Qty:" Style="{StaticResource LabelStyle}"/>
                                            <TextBox x:Name="QuantityTextBox"
                                                    Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                                    Style="{StaticResource TextBoxStyle}"
                                                    GotFocus="SelectAllText_GotFocus"
                                                    PreviewKeyDown="MoveFocusOnEnter"
                                                    Margin="0"/>

                                        </StackPanel>

                                        <StackPanel Grid.Column="4" Margin="0 0 8 0">
                                            <TextBlock Text="Unit Price:" Style="{StaticResource LabelStyle}"/>
                                            <TextBox x:Name="UnitPriceTextBox"
                                                     Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, StringFormat=N2}"
                                                     TextAlignment="Right"
                                                     Style="{StaticResource TextBoxStyle}"
                                                     Margin="0"
                                                     GotFocus="SelectAllText_GotFocus"
                                                     PreviewKeyDown="MoveFocusOnEnter"/>
                                            <TextBlock Text="{Binding LastGrnCostPrice, StringFormat='Last GRN: {0:N2}'}"
                                                       FontSize="10" Foreground="#5B8DB8" Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LastGrnCostPrice}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="5">
                                            <TextBlock Text="" Style="{StaticResource LabelStyle}" />
                                            <Button x:Name="AddItemButton"
                                                    Content="Add"
                                                    Command="{Binding AddLineCommand}"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Width="80" Height="30"
                                                    Click="AddItemButton_Click"/>

                                        </StackPanel>

                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Item Grid Data -->
                            <DataGrid Grid.Row="1" 
                                    ItemsSource="{Binding GoodsPurchaseNoteLines}" 
                                    Style="{StaticResource DataGridStyle}"
                                    Margin="0,4,0,0"
                                    AutoGenerateColumns="False"
                                    SelectionMode="Single"
                                    CanUserAddRows="False"
                                    IsReadOnly="False">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Item Id" Binding="{Binding ProductId, UpdateSourceTrigger=PropertyChanged}" Width="60" MinWidth="120" Visibility="Hidden" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Item Name" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>

                                    <DataGridTextColumn Header="Quantity" Binding="{Binding QuantityOrdered, StringFormat=N3}" Width="100" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="UOM" Binding="{Binding UnitMeasure}" Width="100" IsReadOnly="True"/>

                                    <DataGridTextColumn Header="Last GRN Cost" Binding="{Binding LastGrnCostPrice, StringFormat='Rs. {0:N2}'}" Width="120" IsReadOnly="True" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Foreground" Value="#5B8DB8"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat='Rs. {0:N2}'}" Width="120" IsReadOnly="True" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="Line Discount" Binding="{Binding LineDiscount, UpdateSourceTrigger=PropertyChanged, StringFormat='Rs. {0:N2}'}" Width="120" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Background" Value="#FFFDE7"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style TargetType="TextBox">
                                                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                                <Setter Property="Background" Value="#FFFDE7"/>
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="Tax Amount" Binding="{Binding TaxAmount, Mode=OneWay, StringFormat='Rs. {0:N2}'}" Width="110" IsReadOnly="True" Visibility="Collapsed" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    

                                    <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, StringFormat='Rs. {0:N2}'}" Width="120" IsReadOnly="True" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTemplateColumn Header="Action" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource DeleteButtonStyle}"
                                                        ToolTip="Remove Item"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Row="2" Background="#F8F9FA" BorderBrush="#E1E8ED" BorderThickness="1" 
                                        CornerRadius="0 0 6 6" Padding="8">
                                <StackPanel HorizontalAlignment="Right" Width="250">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Sub Total:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SubTotal, StringFormat='Rs. {0:N2}'}" FontWeight="SemiBold" TextAlignment="Right" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Bill Discount:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding BillDiscount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                                 Style="{StaticResource TextBoxStyle}"
                                                 Background="White"
                                                 TextAlignment="Right"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Total Tax:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TaxAmount, StringFormat='Rs. {0:N2}'}" FontWeight="SemiBold" TextAlignment="Right" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Rectangle Height="1" Fill="#E1E8ED" Margin="0,4,0,8"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="GRAND TOTAL:" Style="{StaticResource LabelStyle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding NetAmount, StringFormat='Rs. {0:N2}'}"
                                                   FontSize="18" FontWeight="SemiBold" TextAlignment="Right" HorizontalAlignment="Right" Foreground="{StaticResource BrandBrush}"
                                                   VerticalAlignment="Center"/>

                                    </Grid>

                                </StackPanel>
                            </Border>

                        </Grid>
                    </Border>

                </Grid>
            </TabItem>

            <TabItem Header=" Order History " Style="{StaticResource TabItemStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource PanelCardStyle}" Margin="0 4 0 0">
                        <StackPanel Orientation="Horizontal">

                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="From Date" Style="{StaticResource LabelStyle}" Margin="0,0,0,2"/>
                                <DatePicker SelectedDate="{Binding SearchDateFrom}" 
                                            Style="{StaticResource DatePickerStyle}"
                                            Width="150"
                                            Margin="0"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="To Date" Style="{StaticResource LabelStyle}" Margin="0,0,0,2"/>
                                <DatePicker SelectedDate="{Binding SearchDateTo}" 
                                            Style="{StaticResource DatePickerStyle}"
                                            Width="150"
                                            Margin="0"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Supplier" Style="{StaticResource LabelStyle}" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding SearchSuppliers}" 
                                          DisplayMemberPath="SupplierName" 
                                          SelectedValuePath="SupplierId"
                                          SelectedValue="{Binding FilterSupplierId}"
                                          Style="{StaticResource ComboBoxStyle}"
                                          ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                          Width="200"
                                          IsEditable="True"
                                          Margin="0"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Status" Style="{StaticResource LabelStyle}" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding FilterStatuses}" 
                                          SelectedItem="{Binding FilterStatus}"
                                          Style="{StaticResource ComboBoxStyle}"
                                          Width="180"
                                          Margin="0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TargetNullValue=ALL}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <Button Command="{Binding SearchCommand}" 
                                    Margin="0,16,12,0" 
                                    Style="{StaticResource SearchButtonStyle}"
                                    Width="80" Height="30"/>
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="PurchaseOrdersDataGrid"
                              Grid.Row="1" Margin="0 4"
                              ItemsSource="{Binding HistoryList}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              GridLinesVisibility="All"
                              Style="{StaticResource DataGridStyle}"
                              RowDetailsVisibilityMode="Visible"
                              SelectionMode="Single"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource Style.DataGrid.Row}">
                                <Setter Property="Height" Value="Auto"/>
                                <Setter Property="MinHeight" Value="42"/>
                                <Setter Property="DetailsVisibility" Value="Visible"/>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="44">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Width="28"
                                                      Height="28"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      ToolTip="Expand purchase order">
                                            <ToggleButton.Style>
                                                <Style TargetType="ToggleButton">
                                                    <Setter Property="Content" Value="&gt;"/>
                                                    <Setter Property="FontFamily" Value="Segoe UI"/>
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Foreground" Value="#334155"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="Focusable" Value="False"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter Property="Content" Value="v"/>
                                                            <Setter Property="ToolTip" Value="Collapse purchase order"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#E5E7EB"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ToggleButton.Style>
                                        </ToggleButton>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="PO #" Binding="{Binding PONumber}" Width="120"/>
                            <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="*"/>

                            <DataGridTextColumn Header="Tax Amount" Binding="{Binding TaxAmount, StringFormat='Rs. {0:N2}'}" Width="120" Visibility="Collapsed" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Total Amount" Binding="{Binding TotalAmount, StringFormat='Rs. {0:N2}'}" Width="120" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Note" Binding="{Binding Notes}" Width="Auto"/>
                            <DataGridTextColumn Header="Order By" Binding="{Binding OrderBy}" Width="120"/>
                            <DataGridTextColumn Header="Order Date" Binding="{Binding OrderDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="120"/>
                            <DataGridTextColumn Header="Expected Delivery Date" Binding="{Binding ExpectedDeliveryDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="180"/>
                            <DataGridTemplateColumn Header="Status" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusPillBorderStyle}">
                                            <TextBlock Text="{Binding Status}"
                                                       Style="{StaticResource StatusPillTextStyle}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Created By" Binding="{Binding Username}" Width="120"/>
                            <DataGridTemplateColumn Header="Action" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Command="{Binding DataContext.LoadDraftPOCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding Source}"
                                                    Margin="0,0,6,0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource EditButtonStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Source.IsDraft}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Source.IsRejected}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <Button Command="{Binding DataContext.DeleteDraftPOCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding Source}"
                                                    Margin="0,0,6,0"
                                                    Visibility="Collapsed">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource DeleteButtonStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Source.IsDraft}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <Button Command="{Binding DataContext.PrintPurchaseOrderCommand, ElementName=PurchaseOrdersDataGrid}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource DataGridPrintButtonStyle}"
                                                    ToolTip="Print purchase order"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>

                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <Border Background="#F4F6F8"
                                        BorderBrush="#D8DEE6"
                                        BorderThickness="0,1,0,1"
                                        Margin="0,12,0,12"
                                        Padding="40,0,12,0"
                                        Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        HorizontalAlignment="Stretch"
                                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <TextBlock Text="Loading purchase order items..."
                                                   Foreground="#64748B"
                                                   Margin="4,0,0,8">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLoadingLineItems}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Border Margin="0,22,0,0"
                                                HorizontalAlignment="Stretch">
                                            <DataGrid ItemsSource="{Binding LineItems}"
                                                      Style="{StaticResource DataGridStyle}"
                                                      AutoGenerateColumns="False"
                                                      CanUserAddRows="False"
                                                      IsReadOnly="True"
                                                      HeadersVisibility="Column"
                                                      HorizontalAlignment="Stretch"
                                                      MinHeight="78"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Disabled">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Item Name" Binding="{Binding ProductName}" Width="*"/>

                                                    <DataGridTextColumn Header="Qty"
                                                                        Binding="{Binding QuantityOrdered, StringFormat=N3}"
                                                                        Width="90"
                                                                        ElementStyle="{StaticResource RightAlignedTextStyle}"/>

                                                    <DataGridTextColumn Header="Received"
                                                                        Binding="{Binding AlreadyReceivedQuantity, StringFormat=N3}"
                                                                        Width="100"
                                                                        ElementStyle="{StaticResource RightAlignedTextStyle}"/>

                                                    <DataGridTextColumn Header="Unit Price"
                                                                        Binding="{Binding UnitPrice, StringFormat='Rs. {0:N2}'}"
                                                                        Width="120"
                                                                        ElementStyle="{StaticResource RightAlignedTextStyle}" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}"/>

                                                    <DataGridTextColumn Header="Total"
                                                                        Binding="{Binding LineTotal, StringFormat='Rs. {0:N2}'}"
                                                                        Width="120"
                                                                        ElementStyle="{StaticResource RightAlignedTextStyle}" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
