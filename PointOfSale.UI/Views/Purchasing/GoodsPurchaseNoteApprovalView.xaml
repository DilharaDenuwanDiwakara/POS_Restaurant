<UserControl
    x:Class="PointOfSale.UI.Views.Purchasing.GoodsPurchaseNoteApprovalView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="650"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <Grid Margin="0,4,0,0">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Margin="0,0,0,4" Style="{StaticResource PanelCardStyle}">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock
                        Margin="0,0,0,2"
                        Style="{StaticResource LabelStyle}"
                        Text="From Date" />
                    <DatePicker
                        Width="150"
                        Margin="0"
                        SelectedDate="{Binding SearchDateFrom}"
                        Style="{StaticResource DatePickerStyle}" />
                </StackPanel>

                <StackPanel Margin="0,0,12,0">
                    <TextBlock
                        Margin="0,0,0,2"
                        Style="{StaticResource LabelStyle}"
                        Text="To Date" />
                    <DatePicker
                        Width="150"
                        Margin="0"
                        SelectedDate="{Binding SearchDateTo}"
                        Style="{StaticResource DatePickerStyle}" />
                </StackPanel>

                <StackPanel Margin="0,0,12,0">
                    <TextBlock
                        Margin="0,0,0,2"
                        Style="{StaticResource LabelStyle}"
                        Text="Supplier" />
                    <ComboBox
                        Width="220"
                        Margin="0"
                        DisplayMemberPath="SupplierName"
                        IsEditable="True"
                        ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                        ItemsSource="{Binding SearchSuppliers}"
                        SelectedValue="{Binding FilterSupplierId}"
                        SelectedValuePath="SupplierId"
                        Style="{StaticResource ComboBoxStyle}" />
                </StackPanel>

                <Button
                    Width="80"
                    Height="30"
                    Margin="0,16,12,0"
                    Command="{Binding SearchCommand}"
                    Style="{StaticResource SearchButtonStyle}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Margin="0,0,8,0"
                Style="{StaticResource PanelCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Margin="0,0,0,6"
                        Style="{StaticResource SubHeaderTextStyle}"
                        Text="Pending PO Approval Queue" />

                    <DataGrid
                        Grid.Row="1"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        GridLinesVisibility="Horizontal"
                        IsReadOnly="True"
                        ItemsSource="{Binding ApprovalQueue}"
                        SelectedItem="{Binding SelectedPO}"
                        SelectionMode="Single"
                        Style="{StaticResource DataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding PONumber}"
                                Header="PO #" />
                            <DataGridTextColumn
                                Width="Auto"
                                Binding="{Binding SupplierName}"
                                Header="Supplier" />
                            <DataGridTextColumn
                                Width="120"
                                Binding="{Binding OrderDate, StringFormat='{}{0:dd/MM/yyyy}'}"
                                Header="Date" />
                            <DataGridTextColumn
                                Width="130"
                                Binding="{Binding ExpectedDeliveryDate, StringFormat='{}{0:dd/MM/yyyy}'}"
                                Header="Delivery Date" />

                            <DataGridTextColumn
                                Width="120"
                                Binding="{Binding TotalAmount, StringFormat='Rs. {0:N2}'}"
                                Header="Amount"
                                HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn
                                Width="120"
                                Binding="{Binding Status}"
                                Header="Status"
                                Visibility="Collapsed" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Margin="0"
                Style="{StaticResource PanelCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource LabelStyle}" Text="Request By: " />
                        <TextBlock Style="{StaticResource LabelStyle}" Text="{Binding SelectedPO.RequestedBy}" />
                    </StackPanel>

                    <DataGrid
                        Grid.Row="1"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        GridLinesVisibility="Horizontal"
                        IsReadOnly="True"
                        ItemsSource="{Binding SelectedPOLines}"
                        Style="{StaticResource DataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding ProductName}"
                                Header="Item" />

                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding QuantityOrdered, StringFormat=N3}"
                                Header="Quantity">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn
                                Width="80"
                                Binding="{Binding UnitMeasure}"
                                Header="UOM">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn
                                Width="120"
                                Binding="{Binding UnitPrice, StringFormat='Rs. {0:N2}'}"
                                Header="Unit Price"
                                HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn
                                Width="120"
                                Binding="{Binding LineDiscount, StringFormat='Rs. {0:N2}'}"
                                Header="Line Discount"
                                HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}"
                                IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn
                                Width="110"
                                Binding="{Binding TaxAmount, StringFormat='Rs. {0:N2}'}"
                                Header="Tax Amount"
                                HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}"
                                IsReadOnly="True"
                                Visibility="Collapsed">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn
                                Width="120"
                                Binding="{Binding LineTotal, StringFormat='Rs. {0:N2}'}"
                                Header="Total"
                                HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}"
                                IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border
                        Grid.Row="2"
                        Margin="0,8,0,0"
                        Padding="8"
                        Background="#F8F9FA"
                        BorderBrush="#E1E8ED"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel>

                            <Grid
                                Width="260"
                                Margin="0,0,0,12"
                                HorizontalAlignment="Right">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Margin="0,0,0,6"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabelStyle}"
                                    Text="Sub Total:" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="0,0,0,6"
                                    HorizontalAlignment="Right"
                                    FontWeight="SemiBold"
                                    Text="{Binding SelectedPO.SubTotal, StringFormat='Rs. {0:N2}'}"
                                    TextAlignment="Right" />

                                <TextBlock
                                    Grid.Row="1"
                                    Margin="0,0,0,6"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabelStyle}"
                                    Text="Bill Discount:" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="0,0,0,6"
                                    HorizontalAlignment="Right"
                                    FontWeight="SemiBold"
                                    Text="{Binding SelectedPO.DiscountAmount, StringFormat='Rs. {0:N2}'}"
                                    TextAlignment="Right" />

                                <TextBlock
                                    Grid.Row="2"
                                    Margin="0,0,0,8"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource LabelStyle}"
                                    Text="Total Tax:" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Right"
                                    FontWeight="SemiBold"
                                    Text="{Binding SelectedPO.TaxAmount, StringFormat='Rs. {0:N2}'}"
                                    TextAlignment="Right" />

                                <TextBlock
                                    Grid.Row="3"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Style="{StaticResource LabelStyle}"
                                    Text="GRAND TOTAL:" />
                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource BrandBrush}"
                                    Text="{Binding SelectedPO.TotalAmount, StringFormat='Rs. {0:N2}'}"
                                    TextAlignment="Right" />
                            </Grid>

                            <TextBlock
                                Margin="0,0,0,2"
                                Style="{StaticResource LabelStyle}"
                                Text="Remarks:" />
                            <TextBox
                                VerticalContentAlignment="Top"
                                AcceptsReturn="True"
                                MaxLength="500"
                                Style="{StaticResource TextBoxStyle}"
                                Text="{Binding ApprovalRemarks, UpdateSourceTrigger=PropertyChanged}" />

                        </StackPanel>
                    </Border>

                    <StackPanel
                        Grid.Row="3"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            Margin="0,0,10,0"
                            Command="{Binding RejectCommand}"
                            Content="Reject"
                            Style="{StaticResource SecondaryButtonStyle}" />

                        <Button
                            Command="{Binding ApproveCommand}"
                            Content="Approve"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
