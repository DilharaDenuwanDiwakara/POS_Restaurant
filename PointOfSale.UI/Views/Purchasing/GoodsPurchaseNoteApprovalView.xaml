<UserControl x:Class="PointOfSale.UI.Views.Purchasing.GoodsPurchaseNoteApprovalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="1100">

    <Grid Margin="0,4,0,0">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="From Date" Style="{StaticResource LabelStyle}" Margin="0,0,0,2"/>
                    <DatePicker SelectedDate="{Binding SearchDateFrom}"
                                Style="{StaticResource DatePickerStyle}"
                                Width="150" Margin="0"/>
                </StackPanel>

                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="To Date" Style="{StaticResource LabelStyle}" Margin="0,0,0,2"/>
                    <DatePicker SelectedDate="{Binding SearchDateTo}"
                                Style="{StaticResource DatePickerStyle}"
                                Width="150" Margin="0"/>
                </StackPanel>

                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Supplier" Style="{StaticResource LabelStyle}" Margin="0,0,0,2"/>
                    <ComboBox ItemsSource="{Binding SearchSuppliers}"
                              DisplayMemberPath="SupplierName"
                              SelectedValuePath="SupplierId"
                              SelectedValue="{Binding FilterSupplierId}"
                              Style="{StaticResource ComboBoxStyle}"
                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                              Width="220"
                              IsEditable="True" Margin="0"/>
                </StackPanel>

                <Button Command="{Binding SearchCommand}"
                        Margin="0,16,12,0"
                        Style="{StaticResource SearchButtonStyle}"
                        Width="80"
                        Height="30"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelCardStyle}" Margin="0 0 8 0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Pending PO Approval Queue" Style="{StaticResource SubHeaderTextStyle}" Margin="0,0,0,6"/>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ApprovalQueue}"
                              SelectedItem="{Binding SelectedPO}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              Style="{StaticResource DataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PO #" Binding="{Binding PONumber}" Width="100"/>
                            <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="Auto"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding OrderDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="120"/>
                            <DataGridTextColumn Header="Delivery Date" Binding="{Binding ExpectedDeliveryDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="130"/>

                            <DataGridTextColumn Header="Amount" Binding="{Binding TotalAmount, StringFormat='Rs. {0:N2}'}" Width="120" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" Visibility="Collapsed"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Vertical" Margin="0,0,0,8">
                        <TextBlock Text="{Binding SelectedPO.PONumber, StringFormat='PO: {0}'}" Style="{StaticResource LabelStyle}" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding SelectedPO.SupplierName, StringFormat='Supplier: {0}'}" Style="{StaticResource LabelStyle}"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding SelectedPOLines}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal"
                              Style="{StaticResource DataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item" Binding="{Binding ProductName}" Width="*"/>

                            <DataGridTextColumn Header="Quantity" Binding="{Binding QuantityOrdered, StringFormat=N3}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="UOM" Binding="{Binding UnitMeasure}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat='Rs. {0:N2}'}" Width="120" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Line Discount" Binding="{Binding LineDiscount, StringFormat='Rs. {0:N2}'}" Width="120" IsReadOnly="True" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Tax Amount" Binding="{Binding TaxAmount, StringFormat='Rs. {0:N2}'}" 
                                                Width="110" 
                                                IsReadOnly="True" 
                                                HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}"
                                                Visibility="Collapsed">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat='Rs. {0:N2}'}" Width="120" IsReadOnly="True" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Background="#F8F9FA" BorderBrush="#E1E8ED" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,8,0,0">
                        <StackPanel>

                            <Grid HorizontalAlignment="Right" Width="260" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Sub Total:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedPO.SubTotal, StringFormat='Rs. {0:N2}'}" FontWeight="SemiBold" TextAlignment="Right" HorizontalAlignment="Right" Margin="0,0,0,6"/>

                                <TextBlock Grid.Row="1" Text="Bill Discount:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedPO.DiscountAmount, StringFormat='Rs. {0:N2}'}" FontWeight="SemiBold" TextAlignment="Right" HorizontalAlignment="Right" Margin="0,0,0,6"/>

                                <TextBlock Grid.Row="2" Text="Total Tax:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedPO.TaxAmount, StringFormat='Rs. {0:N2}'}" FontWeight="SemiBold" TextAlignment="Right" HorizontalAlignment="Right" Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="3" Text="GRAND TOTAL:" Style="{StaticResource LabelStyle}" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedPO.TotalAmount, StringFormat='Rs. {0:N2}'}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrandBrush}" TextAlignment="Right" HorizontalAlignment="Right"/>
                            </Grid>

                            <TextBlock Text="Remarks:" Style="{StaticResource LabelStyle}" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding ApprovalRemarks, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="500"
                                     AcceptsReturn="True"
                                     VerticalContentAlignment="Top"
                                     Style="{StaticResource TextBoxStyle}"/>

                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Reject"
                                Command="{Binding RejectCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,10,0"/>

                        <Button Content="Approve"
                                Command="{Binding ApproveCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
