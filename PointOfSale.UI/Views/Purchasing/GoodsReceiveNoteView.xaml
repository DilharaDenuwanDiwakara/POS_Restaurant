<UserControl x:Class="PointOfSale.UI.Views.Purchasing.GoodsReceiveNoteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PointOfSale.UI.Views.Purchasing"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid>
        <TabControl Style="{StaticResource TabControlStyle}">

            <TabItem Header=" New GRN " Style="{StaticResource TabItemStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="1" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="285"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,8,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock Text="GRN Form" Style="{StaticResource SubHeaderTextStyle}"/>

                                    <TextBlock Text="PO Number:" Style="{StaticResource LabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding OpenPurchaseOrders}"
                                              SelectedItem="{Binding SelectedPO}"
                                              DisplayMemberPath="PONumber"
                                              IsEditable="True"
                                              Style="{StaticResource ComboBoxStyle}"
                                              PreviewKeyDown="MoveFocusOnEnter"/>

                                    <TextBlock Text="Supplier:" Style="{StaticResource LabelStyle}"/>
                                    <ComboBox x:Name="SupplierComboBox"
                                              ItemsSource="{Binding Suppliers}"
                                              SelectedValue="{Binding SelectedSupplierId, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                              SelectedValuePath="SupplierId"
                                              DisplayMemberPath="SupplierName"
                                              IsEnabled="{Binding IsSupplierLocked, Converter={StaticResource InverseBooleanConverter}}"
                                              Style="{StaticResource ComboBoxStyle}"
                                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                              PreviewKeyDown="MoveFocusOnEnter"/>

                                    <TextBlock Text="Received Date:" Style="{StaticResource LabelStyle}"/>
                                    <DatePicker SelectedDate="{Binding ReceivedDate, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                                IsTodayHighlighted="True"
                                                Style="{StaticResource DatePickerStyle}"
                                                PreviewKeyDown="MoveFocusOnEnter"/>

                                    <TextBlock Text="Supplier Invoice #:" Style="{StaticResource LabelStyle}"/>
                                    <TextBox x:Name="InvoiceNumberTextBox"
                                             Text="{Binding InvoiceNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                             MaxLength="100"
                                             CharacterCasing="Upper"
                                             Style="{StaticResource TextBoxStyle}" 
                                             Validation.ErrorTemplate="{StaticResource ErrorTemplate}"
                                             PreviewKeyDown="MoveFocusOnEnter"/>   

                                    <TextBlock Text="Received By:" Style="{StaticResource LabelStyle}"/>
                                    <TextBox x:Name="ReceivedByTextBox"
                                             Text="{Binding ReceivedBy, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                             MaxLength="100"
                                             CharacterCasing="Upper"
                                             Style="{StaticResource TextBoxStyle}" 
                                             Validation.ErrorTemplate="{StaticResource ErrorTemplate}"
                                             PreviewKeyDown="MoveFocusOnEnter"/>

                                    <TextBlock Text="Note:" Style="{StaticResource LabelStyle}"/>
                                    <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                             MaxLength="500"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             Height="60"
                                             VerticalContentAlignment="Top"
                                             Style="{StaticResource TextBoxStyle}"
                                             Validation.ErrorTemplate="{StaticResource ErrorTemplate}"
                                             PreviewKeyDown="MoveFocusOnEnter"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Center">
                                        <Button x:Name="SaveButton"
                                                Content="Save"
                                                Command="{Binding SaveGRNCommand, UpdateSourceTrigger=PropertyChanged}" 
                                                Style="{StaticResource PrimaryButtonStyle}" 
                                                Margin="0,0,12,0"/>

                                        <Button Content="Clear" 
                                                Command="{Binding NewGRNCommand}" 
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Focusable="False"/>
                                        
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}" Margin="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Received Items" Style="{StaticResource SubHeaderTextStyle}" Margin="0 0 0 12"/>

                                <DataGrid Grid.Row="1" 
                                          ItemsSource="{Binding GoodsReceiveNoteLines}" 
                                          Style="{StaticResource DataGridStyle}"
                                          Margin="0,4,0,0"
                                          AutoGenerateColumns="False"
                                          SelectionMode="Single"
                                          CanUserAddRows="False"
                                          IsReadOnly="False">

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Item Id" Binding="{Binding ProductId, UpdateSourceTrigger=PropertyChanged}" Visibility="Hidden" Width="Auto"/>
                                        <DataGridTextColumn Header="Item Name" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                                        
                                        <DataGridTextColumn Header="Qty Ordered" Binding="{Binding QuantityOrdered}" Width="120" IsReadOnly="True" >
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="Qty Received" Binding="{Binding QuantityReceived, UpdateSourceTrigger=PropertyChanged}" Width="120">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Background" Value="#FFFDE7"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="UOM" Binding="{Binding UnitMeasure}" Width="Auto"/>

                                        <!--
                                            EXPIRY DATE — locked when the master product has TrackExpiry = false.
                                            CellTemplate shows a formatted date or "N/A" (greyed/italic).
                                            CellEditingTemplate DatePicker is disabled by the same flag.
                                        -->
                                        <DataGridTemplateColumn Header="Expiry Date" Width="130">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Margin="4,0" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding ExpiryDate, StringFormat=dd-MMM-yyyy, TargetNullValue='—'}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding TrackExpiry}" Value="False">
                                                                        <Setter Property="Text"      Value="N/A"/>
                                                                        <Setter Property="Foreground" Value="#B0BEC5"/>
                                                                        <Setter Property="FontStyle"  Value="Italic"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <DatePicker SelectedDate="{Binding ExpiryDate, UpdateSourceTrigger=PropertyChanged}"
                                                                IsEnabled="{Binding TrackExpiry}"
                                                                IsTodayHighlighted="True"
                                                                Style="{StaticResource DatePickerStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="Ordered Price" Binding="{Binding OrderedPrice, UpdateSourceTrigger=PropertyChanged, StringFormat='Rs. {0:N2}'}" IsReadOnly="True" Width="120"  HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        
                                        <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat='Rs. {0:N2}'}" Width="120"  HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Background" Value="#FFFDE7"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!--
                                            SELLING PRICE — locked when the master product has IsSellable = false.
                                            CellTemplate shows the price (right-aligned) or is greyed/italic when locked.
                                            CellEditingTemplate TextBox is disabled by the same flag.
                                        -->
                                        <DataGridTemplateColumn Header="Selling Price" Width="120" Visibility="Collapsed" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock HorizontalAlignment="Right" Margin="4,0" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding SellingPrice, StringFormat='Rs. {0:N2}', TargetNullValue='—'}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSellable}" Value="False">
                                                                        <Setter Property="Foreground" Value="#B0BEC5"/>
                                                                        <Setter Property="FontStyle"  Value="Italic"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding SellingPrice, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                             IsEnabled="{Binding IsSellable}"
                                                             HorizontalContentAlignment="Right"
                                                             Background="#FFFDE7"
                                                             Style="{StaticResource TextBoxStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="Disc. Amt" Binding="{Binding LineDiscount, UpdateSourceTrigger=PropertyChanged, StringFormat='Rs. {0:N2}'}" Width="100" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="Background" Value="#FFFDE7"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="Tax Amount" Binding="{Binding TaxAmount, Mode=OneWay, StringFormat='Rs. {0:N2}'}" Width="110" IsReadOnly="True" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, StringFormat='Rs. {0:N2}'}" Width="120" IsReadOnly="True" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTemplateColumn Header="Action" Width="50">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource DeleteButtonStyle}"
                                                            ToolTip="Remove Item"
                                                            Width="24" Height="24"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        
                                    </DataGrid.Columns>
                                    
                                </DataGrid>

                                <Border Grid.Row="2" Background="#F8F9FA" BorderBrush="#E1E8ED" BorderThickness="1,1,1,0" 
                                        CornerRadius="6" Padding="8">
                                    <StackPanel HorizontalAlignment="Right" Width="250">
                                        
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <TextBlock Text="Sub Total:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding SubTotal, StringFormat='Rs. {0:N2}'}" FontWeight="SemiBold" TextAlignment="Right" HorizontalAlignment="Right"/>
                                        </Grid>
                                        
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <TextBlock Text="Bill Discount:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding BillDiscount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                                     Style="{StaticResource TextBoxStyle}"
                                                     Background="White"
                                                     TextAlignment="Right"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="Total Tax:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TaxAmount, StringFormat='Rs. {0:N2}'}" FontWeight="SemiBold" TextAlignment="Right" HorizontalAlignment="Right"/>
                                        </Grid>
                                        
                                        <Rectangle Height="1" Fill="#E1E8ED" Margin="0,4,0,8"/>
                                        
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <TextBlock Text="GRAND TOTAL:" Style="{StaticResource LabelStyle}" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding NetAmount, StringFormat='Rs. {0:N2}'}" FontSize="18" FontWeight="Bold" TextAlignment="Right" HorizontalAlignment="Right" Foreground="{StaticResource BrandBrush}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header=" GRN History " Style="{StaticResource TabItemStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource PanelCardStyle}" Margin="0 4 0 0">
                        <StackPanel Orientation="Horizontal">

                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="From Date" Style="{StaticResource LabelStyle}" Margin="0,0,0,2"/>
                                <DatePicker SelectedDate="{Binding SearchDateFrom}" 
                                            Style="{StaticResource DatePickerStyle}"
                                            Width="150"
                                            Margin="0"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,20,0">
                                <TextBlock Text="To Date" Style="{StaticResource LabelStyle}" Margin="0,0,0,2"/>
                                <DatePicker SelectedDate="{Binding SearchDateTo}" 
                                            Style="{StaticResource DatePickerStyle}"
                                            Width="150"
                                            Margin="0"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Supplier" Style="{StaticResource LabelStyle}" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding SearchSuppliers}" 
                                          DisplayMemberPath="SupplierName" 
                                          SelectedValuePath="SupplierId"
                                          SelectedValue="{Binding FilterSupplierId}"
                                          Style="{StaticResource ComboBoxStyle}"
                                          ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                          Width="200"
                                          IsEditable="True"
                                          SelectedIndex="0"
                                          Margin="0"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Status" Style="{StaticResource LabelStyle}" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding FilterStatuses}" 
                                          SelectedItem="{Binding FilterStatus}"
                                          Style="{StaticResource ComboBoxStyle}"
                                          Width="180"
                                          Margin="0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TargetNullValue=ALL}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <Button Command="{Binding SearchCommand}" 
                                    Margin="0,16,12,0" 
                                    Style="{StaticResource SearchButtonStyle}"
                                    Width="80" Height="30"/>

                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1" Margin="0 4" 
                              ItemsSource="{Binding HistoryList}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal"
                              Style="{StaticResource DataGridStyle}">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="GRN #" Binding="{Binding GoodsReceiveNoteNumber}" Width="120"/>
                            <DataGridTextColumn Header="Invoice #" Binding="{Binding InvoiceNumber}" Width="120"/>
                            <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="*"/>

                            <DataGridTextColumn Header="Dis. Amount" Binding="{Binding DiscountAmount, StringFormat='Rs. {0:N2}'}" Width="120" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Tax Amount" Binding="{Binding TaxAmount, StringFormat='Rs. {0:N2}'}" Width="120" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Total Amount" Binding="{Binding TotalAmount, StringFormat='Rs. {0:N2}'}" Width="120" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Note" Binding="{Binding Notes}" Width="Auto"/>

                            <DataGridTextColumn Header="Received By" Binding="{Binding ReceivedBy}" Width="120"/>
                            <DataGridTextColumn Header="Received Date" Binding="{Binding GoodsReceiveNoteDate, StringFormat=dd-MMM-yyyy}" Width="120"/>
                            <DataGridTemplateColumn Header="Status" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusPillBorderStyle}">
                                            <TextBlock Text="{Binding Status}"
                                                       Style="{StaticResource StatusPillTextStyle}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Created By" Binding="{Binding Username}" Width="120"/>
                        </DataGrid.Columns>

                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
