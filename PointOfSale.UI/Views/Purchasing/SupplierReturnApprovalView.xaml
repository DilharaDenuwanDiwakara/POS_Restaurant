<UserControl x:Class="PointOfSale.UI.Views.Purchasing.SupplierReturnApprovalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="1100">

    <Grid Margin="0,4,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="From Date" Style="{StaticResource LabelStyle}" Margin="0,0,0,2"/>
                    <DatePicker SelectedDate="{Binding SearchDateFrom}"
                                Style="{StaticResource DatePickerStyle}"
                                Width="150"
                                Margin="0"/>
                </StackPanel>

                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="To Date" Style="{StaticResource LabelStyle}" Margin="0,0,0,2"/>
                    <DatePicker SelectedDate="{Binding SearchDateTo}"
                                Style="{StaticResource DatePickerStyle}"
                                Width="150"
                                Margin="0"/>
                </StackPanel>

                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Supplier" Style="{StaticResource LabelStyle}" Margin="0,0,0,2"/>
                    <ComboBox ItemsSource="{Binding SearchSuppliers}"
                              DisplayMemberPath="SupplierName"
                              SelectedValuePath="SupplierId"
                              SelectedValue="{Binding FilterSupplierId}"
                              Style="{StaticResource ComboBoxStyle}"
                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                              Width="220"
                              IsEditable="True"
                              Margin="0"/>
                </StackPanel>

                <Button Command="{Binding SearchCommand}"
                        Margin="0,16,12,0"
                        Style="{StaticResource SearchButtonStyle}"
                        Width="80"
                        Height="30"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelCardStyle}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Pending Supplier Return Queue" Style="{StaticResource SubHeaderTextStyle}" Margin="0,0,0,6"/>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ApprovalQueue}"
                              SelectedItem="{Binding SelectedReturn}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              Style="{StaticResource DataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Return Note #" Binding="{Binding ReturnNumber}" Width="120"/>
                            <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="Auto"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding ReturnDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="120"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding NetAmount, StringFormat='Rs. {0:N2}'}" Width="120" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Return Note #" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding SelectedReturn.ReturnNumber}"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="Supplier Name" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding SelectedReturn.SupplierName}"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,10,0">
                            <TextBlock Text="Date" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding SelectedReturn.ReturnDate, StringFormat='{}{0:dd/MM/yyyy}'}"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Returned By" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding SelectedReturn.ReturnedBy}"
                                     IsReadOnly="True"
                                     Style="{StaticResource TextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Margin="0,8,0,0" Visibility="Collapsed">
                            <TextBlock Text="Storekeeper's Note" Style="{StaticResource LabelStyle}"/>
                            <Border Background="#F8F9FA"
                                    BorderBrush="#E1E8ED"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    MinHeight="44"
                                    Padding="8">
                                <TextBlock Text="{Binding SelectedReturn.Note}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource Brush.Text.Primary}"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding SelectedReturnLines}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal"
                              Style="{StaticResource DataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item Name" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, StringFormat=N3}" Width="95">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Unit Cost" Binding="{Binding UnitPrice, StringFormat='Rs. {0:N2}'}" Width="105" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Discount" Binding="{Binding LineDiscount, StringFormat='Rs. {0:N2}'}" Width="95" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Tax" Binding="{Binding TaxAmount, StringFormat='Rs. {0:N2}'}" Width="95" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Reason" Binding="{Binding ReturnReasonDescription}" Width="150"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat='Rs. {0:N2}'}" Width="110" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Background="#F8F9FA" BorderBrush="#E1E8ED" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,8,0,0">
                        <StackPanel>
                            <StackPanel HorizontalAlignment="Right" Width="300">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Sub Total:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedReturn.SubTotal, StringFormat='Rs. {0:N2}'}" FontWeight="SemiBold" TextAlignment="Right" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Total Discount:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedReturn.DiscountAmount, StringFormat='Rs. {0:N2}'}" Foreground="Green" FontWeight="SemiBold" TextAlignment="Right" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Total Tax:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedReturn.TaxAmount, StringFormat='Rs. {0:N2}'}" FontWeight="SemiBold" TextAlignment="Right" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Net Amount:" Style="{StaticResource LabelStyle}" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SelectedReturn.NetAmount, StringFormat='Rs. {0:N2}'}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource BrandBrush}"
                                               TextAlignment="Right"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>

                            <TextBlock Text="Approval/Rejection Reason:" Style="{StaticResource LabelStyle}" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding ApproverRemark, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="255"
                                     AcceptsReturn="True"
                                     VerticalContentAlignment="Top"
                                     Style="{StaticResource TextBoxStyle}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Reject"
                                Command="{Binding RejectCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,10,0"/>

                        <Button Content="Approve"
                                Command="{Binding ApproveCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
