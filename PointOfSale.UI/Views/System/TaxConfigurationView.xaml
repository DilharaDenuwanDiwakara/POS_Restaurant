<UserControl x:Class="PointOfSale.UI.Views.Settings.TaxConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="285"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,8,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Tax Form" Style="{StaticResource SubHeaderTextStyle}" Margin="0,0,0,10"/>

                        <TextBlock Text="Tax Code:" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="TaxCodeTextBox"
                                 Text="{Binding TaxCode, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 MaxLength="20"
                                 CharacterCasing="Upper"
                                 Style="{StaticResource TextBoxStyle}"
                                 PreviewKeyDown="MoveFocusOnEnter"/>

                        <TextBlock Text="Tax Name:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding TaxName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 MaxLength="100"
                                 CharacterCasing="Upper"
                                 Style="{StaticResource TextBoxStyle}"
                                 PreviewKeyDown="MoveFocusOnEnter"/>

                        <TextBlock Text="Rate (%):" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Rate, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 Style="{StaticResource TextBoxStyle}"
                                 PreviewKeyDown="MoveFocusOnEnter"
                                 GotFocus="SelectAllText_GotFocus"/>

                        <TextBlock Text="Calculation Order:" Style="{StaticResource LabelStyle}" Visibility="Collapsed"/>
                        <TextBox Text="{Binding CalculationOrder, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 Style="{StaticResource TextBoxStyle}"
                                 PreviewKeyDown="MoveFocusOnEnter"
                                 GotFocus="SelectAllText_GotFocus"
                                 Visibility="Collapsed"/>

                        <TextBlock Text="Effective Date:" Style="{StaticResource LabelStyle}"/>
                        <DatePicker SelectedDate="{Binding EffectiveDate, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource DatePickerStyle}"
                                    PreviewKeyDown="MoveFocusOnEnter"/>

                        <TextBlock Text="Tax Account (GL):" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding TaxAccounts}"
                                  DisplayMemberPath="DisplayText"
                                  SelectedValuePath="Code"
                                  SelectedValue="{Binding AccountCode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                  IsEditable="True"
                                  TextSearch.TextPath="DisplayText"
                                  Style="{StaticResource ComboBoxStyle}"
                                  ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                  PreviewKeyDown="MoveFocusOnEnter"/>

                        <CheckBox Content="Is Active"
                                  IsChecked="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource CheckBoxStyle}"
                                  Margin="0,0,0,12"
                                  Focusable="False"/>

                        <CheckBox Content="Is Inclusive Tax"
                                  IsChecked="{Binding IsInclusive, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource CheckBoxStyle}"
                                  Focusable="False" 
                                  Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="#E0E0E0" Padding="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding SaveButtonText}"
                                Command="{Binding SaveTaxConfigurationCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,12,0"/>
                        <Button Content="Edit"
                                Command="{Binding EditTaxConfigurationCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,12,0"/>
                        
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="#F1F2F6" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Tax Configuration List"
                                   Style="{StaticResource SubHeaderTextStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0"/>

                        <Button Grid.Column="1"
                                Command="{Binding LoadTaxConfigurationCommand}"
                                Style="{StaticResource RefreshButtonStyle}"
                                ToolTip="Refresh Tax Configuration List"
                                Margin="10,0,0,0"/>
                    </Grid>
                </Border>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding TaxConfigurations}"
                          SelectedItem="{Binding SelectedTaxConfiguration, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource DataGridStyle}"
                          Margin="0,4,0,0"
                          AutoGenerateColumns="False"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto" Visibility="Hidden"/>
                        <DataGridTextColumn Header="Code" Binding="{Binding TaxCode}" Width="120"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding TaxName}" Width="*"/>
                        <DataGridTextColumn Header="Rate (%)" Binding="{Binding Rate}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Order" Binding="{Binding CalculationOrder}" Width="80" Visibility="Collapsed"/>
                        <DataGridCheckBoxColumn Header="Inclusive" Binding="{Binding IsInclusive}" Width="100" Visibility="Collapsed"/>
                        <DataGridTextColumn Header="Effective Date" Binding="{Binding EffectiveDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="150"/>
                        <DataGridTextColumn Header="Tax Account (GL)" Binding="{Binding AccountCode}" Width="150"/>
                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
        
    </Grid>
</UserControl>
