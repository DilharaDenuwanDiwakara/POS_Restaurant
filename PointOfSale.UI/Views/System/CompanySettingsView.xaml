<UserControl x:Class="PointOfSale.UI.Views.Settings.CompanySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1100">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource PanelCardStyle}" Margin="0 0 8 0">
            <StackPanel>
                <TextBlock Text="Company Logo"
                           Style="{StaticResource SubHeaderTextStyle}"
                           Margin="0,0,0,8"/>

                <Border Height="200"
                        Background="#F6F8FB"
                        BorderBrush="{StaticResource Brush.Card.Border}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,12">
                    <Grid>
                        <Image Source="{Binding LogoUrl}"
                               Stretch="Uniform"
                               Margin="12"
                               Visibility="{Binding LogoUrl, Converter={StaticResource NullToVisibilityConverter}}"/>
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding LogoUrl, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}">
                            <TextBlock Text="No Logo Selected"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource Brush.Text.Muted}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Use Upload Logo to choose an image file."
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource Brush.Text.Muted}"
                                       FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Button Content="Upload Logo"
                        Command="{Binding UploadLogoCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="Auto"/>

                <TextBlock Text="Selected File"
                           Style="{StaticResource LabelStyle}"
                           Margin="0,14,0,4"/>
                
                <TextBox Text="{Binding LogoUrl}"
                         IsReadOnly="True"
                         Style="{StaticResource TextBoxStyle}"
                         ToolTip="{Binding LogoUrl}"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Company Details"
                                   Style="{StaticResource SubHeaderTextStyle}"/>

                        <TextBlock Text="Identity"
                                   Style="{StaticResource SubHeaderTextStyle}"
                                   Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Trading Name" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding TradingName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                         MaxLength="150"
                                         Style="{StaticResource TextBoxStyle}"
                                         PreviewKeyDown="MoveFocusOnEnter"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Legal Name" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding LegalName, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="150"
                                         Style="{StaticResource TextBoxStyle}"
                                         PreviewKeyDown="MoveFocusOnEnter"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Business Registration Number" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding BusinessRegistrationNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                         MaxLength="50"
                                         Style="{StaticResource TextBoxStyle}"
                                         PreviewKeyDown="MoveFocusOnEnter"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Tax Registration Number" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding TaxRegistrationNumber, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="50"
                                         Style="{StaticResource TextBoxStyle}"
                                         PreviewKeyDown="MoveFocusOnEnter"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Contact &amp; Location"
                                   Style="{StaticResource SubHeaderTextStyle}"
                                   Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Address Line 1" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding AddressLine1, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                         MaxLength="150"
                                         Style="{StaticResource TextBoxStyle}"
                                         PreviewKeyDown="MoveFocusOnEnter"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Address Line 2" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding AddressLine2, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="150"
                                         Style="{StaticResource TextBoxStyle}"
                                         PreviewKeyDown="MoveFocusOnEnter"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Contact Number" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding ContactNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                         MaxLength="100"
                                         Style="{StaticResource TextBoxStyle}"
                                         PreviewKeyDown="MoveFocusOnEnter"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Email" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                         MaxLength="100"
                                         Style="{StaticResource TextBoxStyle}"
                                         PreviewKeyDown="MoveFocusOnEnter"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                                <TextBlock Text="Website" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding Website, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="100"
                                         Style="{StaticResource TextBoxStyle}"
                                         PreviewKeyDown="MoveFocusOnEnter"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Financial &amp; Reporting"
                                   Style="{StaticResource SubHeaderTextStyle}"
                                   Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Base Currency" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding BaseCurrency, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                         MaxLength="10"
                                         CharacterCasing="Upper"
                                         Style="{StaticResource TextBoxStyle}"
                                         PreviewKeyDown="MoveFocusOnEnter"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                                <TextBlock Text="Receipt Footer Text" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding ReceiptFooterText, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="250"
                                         Style="{StaticResource TextBoxStyle}"
                                         PreviewKeyDown="MoveFocusOnEnter"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                                <TextBlock Text="Document Terms" Style="{StaticResource LabelStyle}"/>
                                <TextBox Text="{Binding DocumentTerms, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="500"
                                         Height="120"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalContentAlignment="Top"
                                         Style="{StaticResource TextBoxStyle}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Border Grid.Row="1"
                            BorderThickness="0,1,0,0"
                            BorderBrush="{StaticResource Brush.Card.Border}"
                            Padding="0,12,0,0"
                            Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{Binding SaveButtonText}"
                                Command="{Binding SaveCompanyCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,12,0"/>
                       
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
