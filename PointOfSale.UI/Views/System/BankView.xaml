<UserControl x:Class="PointOfSale.UI.Views.Settings.BankView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="900">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="285"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== Left Panel: Bank Form ===================== -->
        <Border Grid.Column="0" Style="{StaticResource PanelCardStyle}" Margin="0,0,8,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Bank Form"
                                   Style="{StaticResource SubHeaderTextStyle}"
                                   Margin="0,0,0,12"/>

                        <!-- Bank Code -->
                        <TextBlock Text="Bank Code:" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="BankCodeTextBox"
                                 Text="{Binding BankCode, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 MaxLength="20"
                                 CharacterCasing="Upper"
                                 Style="{StaticResource TextBoxStyle}"
                                 PreviewKeyDown="MoveFocusOnEnter"/>

                        <!-- Bank Name -->
                        <TextBlock Text="Bank Name:" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding BankName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 MaxLength="100"
                                 Style="{StaticResource TextBoxStyle}"
                                 CharacterCasing="Upper"
                                 PreviewKeyDown="MoveFocusOnEnter"/>

                        <!-- Is Active -->
                        <CheckBox Content="Is Active"
                                  IsChecked="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource CheckBoxStyle}"
                                  Margin="0,8,0,0"
                                  Focusable="False"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Action Buttons -->
                <Border Grid.Row="1"
                        BorderThickness="0,1,0,0"
                        BorderBrush="#E0E0E0"
                        Padding="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding SaveButtonText}"
                                Command="{Binding SaveBankCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,12,0"
                                Click="SaveButton_Click"/>
                        
                        <Button Content="Edit"
                                Command="{Binding EditBankCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===================== Right Panel: Bank List ===================== -->
        <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- List Header -->
                <Border Background="#F1F2F6" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Bank List"
                                   Style="{StaticResource SubHeaderTextStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0"/>

                        <Button Grid.Column="1"
                                Command="{Binding LoadBankCommand}"
                                Style="{StaticResource RefreshButtonStyle}"
                                ToolTip="Refresh Bank List"
                                Margin="10,0,0,0"/>
                    </Grid>
                </Border>

                <!-- Data Grid -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Banks}"
                          SelectedItem="{Binding SelectedBank, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource DataGridStyle}"
                          Margin="0,4,0,0"
                          AutoGenerateColumns="False"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding Id}"
                                            Width="Auto"
                                            Visibility="Hidden"/>
                        <DataGridTextColumn Header="Bank Code"
                                            Binding="{Binding BankCode}"
                                            Width="120"/>
                        <DataGridTextColumn Header="Bank Name"
                                            Binding="{Binding BankName}"
                                            Width="*"/>
                        <DataGridCheckBoxColumn Header="Active"
                                                Binding="{Binding IsActive}"
                                                Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
