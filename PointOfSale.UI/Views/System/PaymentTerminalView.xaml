<UserControl x:Class="PointOfSale.UI.Views.Settings.PaymentTerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="960">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="285"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== Left Panel: Form ===================== -->
        <Border Grid.Column="0" Style="{StaticResource PanelCardStyle}" Margin="0,0,8,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Terminal Form"
                                   Style="{StaticResource SubHeaderTextStyle}"
                                   Margin="0,0,0,12"/>

                        <!-- Terminal Name -->
                        <TextBlock Text="Terminal Name:" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="TerminalNameTextBox"
                                 Text="{Binding TerminalName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 MaxLength="100"
                                 Style="{StaticResource TextBoxStyle}"
                                 CharacterCasing="Upper"
                                 PreviewKeyDown="MoveFocusOnEnter"/>

                        <!-- Terminal ID (Bank TID/MID) -->
                        <TextBlock Text="Terminal ID (TID):" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="TerminalIdTextBox"
                                 Text="{Binding TerminalId, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 MaxLength="20"
                                 Style="{StaticResource TextBoxStyle}"
                                 CharacterCasing="Upper"
                                 PreviewKeyDown="MoveFocusOnEnter"/>

                        <!-- Branch -->
                        <TextBlock Text="Branch:" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding Branches}"
                                  SelectedItem="{Binding SelectedBranch, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource ComboBoxStyle}"
                                  PreviewKeyDown="MoveFocusOnEnter"/>

                        <!-- Linked Account (Bank / Current Asset only) -->
                        <TextBlock Text="Linked Account:" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding LinkedAccounts}"
                                  SelectedItem="{Binding SelectedLinkedAccount, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                  DisplayMemberPath="DisplayText"
                                  Style="{StaticResource ComboBoxStyle}"
                                  PreviewKeyDown="MoveFocusOnEnter"/>

                        <!-- Provider Bank -->
                        <TextBlock Text="Provider Bank:" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding Banks}"
                                  SelectedItem="{Binding SelectedProviderBank, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                  DisplayMemberPath="BankName"
                                  Style="{StaticResource ComboBoxStyle}"
                                  PreviewKeyDown="MoveFocusOnEnter"/>

                        <!-- Is Active -->
                        <CheckBox Content="Is Active"
                                  IsChecked="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource CheckBoxStyle}"
                                  Margin="0,8,0,0"
                                  Focusable="False"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Action Buttons -->
                <Border Grid.Row="1"
                        BorderThickness="0,1,0,0"
                        BorderBrush="#E0E0E0"
                        Padding="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding SaveButtonText}"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,8,0"/>
                        <Button Content="Edit"
                                Command="{Binding EditCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===================== Right Panel: Terminal List ===================== -->
        <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- List Header -->
                <Border Background="#F1F2F6" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Payment Terminal List"
                                   Style="{StaticResource SubHeaderTextStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0"/>

                        <Button Grid.Column="1"
                                Command="{Binding LoadCommand}"
                                Style="{StaticResource RefreshButtonStyle}"
                                ToolTip="Refresh Terminal List"
                                Margin="10,0,0,0"/>
                    </Grid>
                </Border>

                <!-- Data Grid -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Terminals}"
                          SelectedItem="{Binding SelectedTerminal, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource DataGridStyle}"
                          Margin="0,4,0,0"
                          AutoGenerateColumns="False"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding Id}"
                                            Width="Auto"
                                            Visibility="Hidden"/>
                        <DataGridTextColumn Header="Terminal Name"
                                            Binding="{Binding TerminalName}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Branch"
                                            Binding="{Binding BranchName}"
                                            Width="150"/>
                        <DataGridTextColumn Header="Linked Account"
                                            Binding="{Binding LinkedAccountDisplay}"
                                            Width="250"/>
                        <DataGridTextColumn Header="Provider Bank"
                                            Binding="{Binding ProviderBankName}"
                                            Width="200"/>
                        <DataGridCheckBoxColumn Header="Active"
                                                Binding="{Binding IsActive}"
                                                Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Delete Footer -->
                <Border Grid.Row="2"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{StaticResource Brush.Card.Border}"
                        Padding="0,10,0,0"
                        Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Delete"
                                Command="{Binding DeleteCommand}"
                                Style="{StaticResource DangerButtonStyle}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
