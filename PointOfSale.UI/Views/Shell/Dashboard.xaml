<UserControl x:Class="PointOfSale.UI.Views.Shell.Dashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1200">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- Row 0: Page Header -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Restaurant Management Dashboard"
                               Style="{StaticResource HeaderTextStyle}"
                               Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding DateRangeText}"
                               FontSize="13"
                               Foreground="{StaticResource Brush.Text.Muted}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox Width="150"
                              ItemsSource="{Binding PeriodOptions}"
                              SelectedItem="{Binding SelectedPeriod}"
                              Margin="0,0,10,0"
                              Style="{StaticResource ComboBoxStyle}"/>
                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource RefreshButtonStyle}"/>
                </StackPanel>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- Row 1: Loading indicator -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <TextBlock Grid.Row="1"
                       Text="Loading dashboard..."
                       Foreground="{StaticResource BrandBrush}"
                       FontWeight="SemiBold"
                       FontSize="13"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                       Margin="0,0,0,8"/>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- Row 2: KPI Stat Cards -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Sales -->
                <Border Grid.Column="0"
                        Background="{StaticResource Brush.Card.Surface}"
                        BorderBrush="{StaticResource Brush.Card.Border}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="Total Sales"
                                   Foreground="{StaticResource Brush.Text.Muted}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding TotalSales, StringFormat='LKR {0:N0}'}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#2E7D32"/>
                    </StackPanel>
                </Border>

                <!-- Orders -->
                <Border Grid.Column="2"
                        Background="{StaticResource Brush.Card.Surface}"
                        BorderBrush="{StaticResource Brush.Card.Border}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="Orders"
                                   Foreground="{StaticResource Brush.Text.Muted}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding OrderCount, StringFormat='{}{0:N0}'}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Text.Primary}"/>
                    </StackPanel>
                </Border>

                <!-- Avg Order Value -->
                <Border Grid.Column="4"
                        Background="{StaticResource Brush.Card.Surface}"
                        BorderBrush="{StaticResource Brush.Card.Border}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="Avg Order Value"
                                   Foreground="{StaticResource Brush.Text.Muted}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding AverageOrderValue, StringFormat='LKR {0:N0}'}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#1565C0"/>
                    </StackPanel>
                </Border>

                <!-- Avg Per Head -->
                <Border Grid.Column="6"
                        Background="{StaticResource Brush.Card.Surface}"
                        BorderBrush="{StaticResource Brush.Card.Border}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="Avg Per Head"
                                   Foreground="{StaticResource Brush.Text.Muted}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding AveragePerHead, StringFormat='LKR {0:N0}'}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#00897B"/>
                    </StackPanel>
                </Border>

                <!-- Today's Sales -->
                <Border Grid.Column="8"
                        Background="{StaticResource Brush.Card.Surface}"
                        BorderBrush="{StaticResource Brush.Card.Border}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="Today's Sales"
                                   Foreground="{StaticResource Brush.Text.Muted}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding TodaySales, StringFormat='LKR {0:N0}'}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#6A1B9A"/>
                    </StackPanel>
                </Border>

                <!-- Today's Orders -->
                <Border Grid.Column="10"
                        Background="{StaticResource Brush.Card.Surface}"
                        BorderBrush="{StaticResource Brush.Card.Border}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="Today's Orders"
                                   Foreground="{StaticResource Brush.Text.Muted}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding TodayOrderCount, StringFormat='{}{0:N0}'}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#EF6C00"/>
                    </StackPanel>
                </Border>

                <!-- Avg Table Turn -->
                <Border Grid.Column="12"
                        Background="{StaticResource Brush.Card.Surface}"
                        BorderBrush="{StaticResource Brush.Card.Border}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="Avg Table Turn"
                                   Foreground="{StaticResource Brush.Text.Muted}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding AvgTurnTime}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#00838F"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- Row 3: Inventory Alert Cards -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Grid Grid.Row="3" Margin="0,0,0,12" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Expiring in 7 Days -->
                <Border Grid.Column="0"
                        Background="#FFF3E0"
                        BorderBrush="#EF6C00"
                        BorderThickness="0,0,0,2"
                        CornerRadius="8"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Expiring in 7 Days"
                                   FontSize="11"
                                   Foreground="#EF6C00"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Expiring7DaysCount, StringFormat='{}{0:N0} items'}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#E65100"/>
                    </StackPanel>
                </Border>

                <!-- Expired Items -->
                <Border Grid.Column="2"
                        Background="#FFEBEE"
                        BorderBrush="#C62828"
                        BorderThickness="0,0,0,2"
                        CornerRadius="8"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Expired Items"
                                   FontSize="11"
                                   Foreground="#C62828"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ExpiredItemCount, StringFormat='{}{0:N0} items'}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#B71C1C"/>
                    </StackPanel>
                </Border>

                <!-- Low Stock -->
                <Border Grid.Column="4"
                        Background="#FFF8E1"
                        BorderBrush="#F57F17"
                        BorderThickness="0,0,0,2"
                        CornerRadius="8"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Low Stock"
                                   FontSize="11"
                                   Foreground="#F57F17"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding LowStockItemCount, StringFormat='{}{0:N0} items'}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#F57F17"/>
                    </StackPanel>
                </Border>

                <!-- Out of Stock -->
                <Border Grid.Column="6"
                        Background="#FFEBEE"
                        BorderBrush="#C62828"
                        BorderThickness="0,0,0,2"
                        CornerRadius="8"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Out of Stock"
                                   FontSize="11"
                                   Foreground="#C62828"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding OutOfStockItemCount, StringFormat='{}{0:N0} items'}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#C62828"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- Row 4: Charts + Lists -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Grid Grid.Row="4" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Sales Trend + Hourly Sales -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Sales Trend Chart -->
                    <Border Grid.Row="0"
                            Background="{StaticResource Brush.Card.Surface}"
                            BorderBrush="{StaticResource Brush.Card.Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,0,4">
                                <TextBlock Text="Sales Trend"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource Brush.Text.Primary}"/>
                                <TextBlock Text="Daily net sales"
                                           FontSize="12"
                                           Foreground="{StaticResource Brush.Text.Muted}"/>
                            </StackPanel>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding WeeklySales}" VerticalAlignment="Bottom" Margin="0,16,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Bottom" Margin="6,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0"
                                                    Height="{Binding Value, Converter={StaticResource ScaleConverter}, ConverterParameter=1.8}"
                                                    Background="{Binding Color}"
                                                    CornerRadius="4,4,0,0"
                                                    VerticalAlignment="Bottom">
                                                <Border.ToolTip>
                                                    <ToolTip Content="{Binding ToolTipText}"/>
                                                </Border.ToolTip>
                                            </Border>
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding Label}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,6,0,0"
                                                       Foreground="{StaticResource Brush.Text.Muted}"
                                                       FontSize="10"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- Hourly Sales Chart -->
                    <Border Grid.Row="2"
                            Background="{StaticResource Brush.Card.Surface}"
                            BorderBrush="{StaticResource Brush.Card.Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,0,4">
                                <TextBlock Text="Hourly Sales (Today)"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource Brush.Text.Primary}"/>
                                <TextBlock Text="Operational peak hours"
                                           FontSize="12"
                                           Foreground="{StaticResource Brush.Text.Muted}"/>
                            </StackPanel>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding HourlySales}" VerticalAlignment="Bottom" Margin="0,16,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Bottom" Margin="3,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0"
                                                    Height="{Binding Value, Converter={StaticResource ScaleConverter}, ConverterParameter=1.6}"
                                                    Background="{Binding Color}"
                                                    CornerRadius="3,3,0,0"
                                                    VerticalAlignment="Bottom">
                                                <Border.ToolTip>
                                                    <ToolTip Content="{Binding ToolTipText}"/>
                                                </Border.ToolTip>
                                            </Border>
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding Label}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,6,0,0"
                                                       Foreground="{StaticResource Brush.Text.Muted}"
                                                       FontSize="9"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Right: Payment Mix + Top Categories + Top Items -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Payment Mix -->
                    <Border Grid.Row="0"
                            Background="{StaticResource Brush.Card.Surface}"
                            BorderBrush="{StaticResource Brush.Card.Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Payment Mix"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Brush.Text.Primary}"
                                       Margin="0,0,0,10"/>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding PaymentBreakdown}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Method}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource Brush.Text.Primary}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Amount, StringFormat='LKR {0:N0}'}"
                                                       Foreground="{StaticResource Brush.Text.Muted}"
                                                       FontSize="11"/>
                                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2"
                                                         Value="{Binding Percentage}"
                                                         Maximum="100"
                                                         Height="5"
                                                         BorderThickness="0"
                                                         Background="{StaticResource Brush.App.Background}"
                                                         Foreground="{Binding Color}"
                                                         Margin="0,4,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- Top Categories -->
                    <Border Grid.Row="2"
                            Background="{StaticResource Brush.Card.Surface}"
                            BorderBrush="{StaticResource Brush.Card.Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Top Categories"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Brush.Text.Primary}"
                                       Margin="0,0,0,10"/>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding CategorySales}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding CategoryName}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource Brush.Text.Primary}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding SalesAmount, StringFormat='LKR {0:N0}'}"
                                                       Foreground="{StaticResource Brush.Text.Muted}"
                                                       FontSize="11"/>
                                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2"
                                                         Value="{Binding Percentage}"
                                                         Maximum="100"
                                                         Height="5"
                                                         BorderThickness="0"
                                                         Background="{StaticResource Brush.App.Background}"
                                                         Foreground="#5E35B1"
                                                         Margin="0,4,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- Top Selling Items -->
                    <Border Grid.Row="4"
                            Background="{StaticResource Brush.Card.Surface}"
                            BorderBrush="{StaticResource Brush.Card.Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Top Selling Items"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Brush.Text.Primary}"
                                       Margin="0,0,0,10"/>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding TopItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,9">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource Brush.Text.Primary}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Qty, StringFormat='Qty {0:N0}'}"
                                                       Foreground="{StaticResource Brush.Text.Muted}"
                                                       FontSize="11"/>
                                            <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar Grid.Column="0"
                                                             Value="{Binding Percentage}"
                                                             Maximum="100"
                                                             Height="5"
                                                             BorderThickness="0"
                                                             Background="{StaticResource Brush.App.Background}"
                                                             Foreground="{StaticResource SecondaryBrush}"
                                                             Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Revenue, StringFormat='LKR {0:N0}'}"
                                                           Foreground="{StaticResource Brush.Text.Muted}"
                                                           FontSize="11"/>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- Row 5: Notifications and Risk Alerts -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <Border Grid.Row="5"
                    Background="{StaticResource Brush.Card.Surface}"
                    BorderBrush="{StaticResource Brush.Card.Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section header with bottom divider -->
                    <Border Grid.Row="0"
                            BorderBrush="{StaticResource Brush.Card.Border}"
                            BorderThickness="0,0,0,1"
                            Padding="0,0,0,10"
                            Margin="0,0,0,4">
                        <TextBlock Text="Notifications and Risk Alerts"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Text.Primary}"/>
                    </Border>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Alerts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Brush.Card.Border}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding AlertType}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Text.Muted}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Severity}"
                                                   Foreground="{Binding SeverityColor}"
                                                   FontWeight="Bold"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ItemName}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Text.Primary}"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Message}"
                                                   Foreground="{StaticResource Brush.Text.Muted}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
