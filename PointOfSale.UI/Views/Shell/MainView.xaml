<Window x:Class="PointOfSale.UI.Views.Shell.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PointOfSale.UI.Views.Shell" 
        xmlns:shell="clr-namespace:PointOfSale.UI.ViewModels.Shell" 
        xmlns:converters="clr-namespace:PointOfSale.UI.Converters"
        mc:Ignorable="d"
        MinHeight="720" MinWidth="1366"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Title="Nexora">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========================================================== -->
        <!-- HEADER SECTION -->
        <!-- ========================================================== -->
        <Border Grid.ColumnSpan="2" Style="{StaticResource Style.Shell.Header}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo & Company Name -->
                <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                    <Image Source="/Resources/Images/restaurant-logo.jpg"
                           Height="32"
                           Margin="0,0,12,0"/>

                    <TextBlock Text="Nexora" 
                               Style="{StaticResource HeaderTextStyle}" 
                               Margin="0" VerticalAlignment="Center"/>
                    
                </StackPanel>

                <Grid Grid.Column="2" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">

                    <StackPanel Orientation="Horizontal">

                    <Button Content="Switch to POS"
                            Command="{Binding OpenSalesViewCommand}"
                            Visibility="{Binding CanAccessPosTerminal, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource PrimaryButtonStyle}"/>

                    <ToggleButton x:Name="UserProfileButton"
                                  Style="{StaticResource ProfileToggleButtonStyle}"
                                  IsChecked="{Binding IsUserMenuOpen, Mode=TwoWay}"
                                  Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource BrandBrush}" Margin="0,0,10,0">
                                <TextBlock Text="{Binding CurrentUser.CurrentUser.Initials}" 
                                           Foreground="{StaticResource Brush.Text.OnDark}" FontWeight="Bold" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                
                            </Border>

                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="{Binding CurrentUser.FullName}" 
                                            FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}"/>

                                <TextBlock Text="{Binding CurrentUser.RoleName}" 
                                            FontSize="11" Foreground="{StaticResource Brush.Text.Muted}"/>
                            </StackPanel>

                            <TextBlock Text="▼" FontSize="8" VerticalAlignment="Center" Foreground="{StaticResource Brush.Text.Muted}"/>
                        </StackPanel>
                    </ToggleButton>

                    <Popup IsOpen="{Binding IsUserMenuOpen, Mode=TwoWay}" 
                           StaysOpen="False" 
                           PlacementTarget="{Binding ElementName=UserProfileButton}"
                           Placement="Bottom" 
                           VerticalOffset="5" 
                           HorizontalOffset="-50"
                           AllowsTransparency="True" PopupAnimation="Slide">

                        <Border Background="{StaticResource Brush.Card.Surface}" CornerRadius="8" Padding="0" Width="220"
                                BorderBrush="{StaticResource Brush.Card.Border}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.15" Color="Black"/>
                            </Border.Effect>

                            <StackPanel>
                                <Border Background="{StaticResource Brush.App.Background}" CornerRadius="8,8,0,0" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding CurrentUser.FullName}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource Brush.Text.Primary}"/>

                                        <TextBlock Text="{Binding CurrentUser.BranchName}" FontSize="11" Foreground="{StaticResource BrandBrush}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Button Command="{Binding ViewProfileCommand}" Style="{StaticResource MenuButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="👤" Margin="0,0,10,0" Width="16" Foreground="{StaticResource Brush.Text.Primary}"/>
                                        <TextBlock Text="My Profile" Foreground="{StaticResource Brush.Text.Primary}"/>
                                    </StackPanel>
                                </Button>

                                <Separator Background="{StaticResource Brush.Card.Border}" Margin="10,5"/>

                                <Button Command="{Binding LogoutCommand}" Style="{StaticResource MenuButtonStyle}" Foreground="{StaticResource DangerBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🚪" Margin="0,0,10,0" Width="16"/>
                                        <TextBlock Text="Logout"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>

                    </StackPanel>
                </Grid>

            </Grid>
        </Border>

        <!-- ========================================================== -->
        <!-- SIDEBAR AND MAIN CONTENT -->
        <!-- ========================================================== -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ========================================================== -->
            <!-- SIDEBAR -->
            <!-- ========================================================== -->
            <Border x:Name="SidebarBorder"
                    Style="{StaticResource Style.Shell.Sidebar}" Width="280">

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Orientation="Vertical" Margin="0,16">
                        
                        <!-- Dashboard -->
                        <RadioButton Command="{Binding NavigateToDashboardCommand}"
                                     Style="{StaticResource Style.Nav.RadioButton}"
                                     ToolTip="Dashboard"
                                     Margin="10 4"
                                     Visibility="{Binding CanAccessDashboard, Converter={StaticResource BoolToVisibility}}">

                            <StackPanel Orientation="Horizontal">

                                <Path Data="{StaticResource Icon.Nav.Dashboard}" 
                                      Style="{StaticResource Style.Icon.Base}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>

                                <TextBlock Text="Dashboard" 
                                           VerticalAlignment="Center" 
                                           Margin="12,0,0,0"
                                           Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>

                        </RadioButton>

                        <!-- Restaurant Module -->
                        <Expander Header="Restaurant" 
                                  Tag="{StaticResource Icon.Nav.RestaurantDining}"
                                  Style="{StaticResource Style.Shell.Expander}"
                                  Focusable="False"
                                  Visibility="{Binding CanAccessRestaurant, Converter={StaticResource BoolToVisibility}}">

                            <StackPanel Margin="0">

                                <RadioButton Command="{Binding NavigateToMenuItemListCommand}" 
                                             Style="{StaticResource Style.Nav.RadioButton}"
                                             Visibility="{Binding CanNavMenuItemList, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Menu Items"/>
                                    </StackPanel>
                                </RadioButton>
                                
                                <RadioButton Command="{Binding NavigateToMenuItemCommand}" 
                                             Style="{StaticResource Style.Nav.RadioButton}"
                                             Visibility="{Binding CanNavMenuItem, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Menu Item Setup"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Command="{Binding NavigateToMenuCategoryCommand}" 
                                             Style="{StaticResource Style.Nav.RadioButton}"
                                             Visibility="{Binding CanNavMenuCategory, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Menu Categories"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Command="{Binding NavigateToTableCommand}"
                                             Style="{StaticResource Style.Nav.RadioButton}"
                                             Visibility="{Binding CanNavTable, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Tables"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Command="{Binding NavigateToMenuProfitabilityCommand}"
                                             Style="{StaticResource Style.Nav.RadioButton}"
                                             Visibility="{Binding CanNavMenuProfitability, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Menu Profitability"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Command="{Binding NavigateToRoomRegisterCommand}" 
                                             Style="{StaticResource Style.Nav.RadioButton}"
                                             Visibility="Collapsed">
                                             <!--Visibility="{Binding CanNavRoomRegister, Converter={StaticResource BoolToVisibility}}"-->
                                          
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Rooms"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Command="{Binding NavigateToRoomBookingCommand}" 
                                             Style="{StaticResource Style.Nav.RadioButton}"
                                             Visibility="Collapsed">
                                            <!--Visibility="{Binding CanNavRoomBooking, Converter={StaticResource BoolToVisibility}}"-->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Room Bookings"/>
                                    </StackPanel>
                                </RadioButton>
                                
                            </StackPanel>
                        </Expander>

                        <!-- Sales Module -->
                        <Expander Header="Sales" 
                                   Tag="{StaticResource Icon.Nav.Sales}"
                                   Style="{StaticResource Style.Shell.Expander}"
                                   Focusable="False"
                                   Visibility="{Binding CanAccessSales, Converter={StaticResource BoolToVisibility}}">

                            <StackPanel>
                                <RadioButton Command="{Binding NavigateToInvoicesCommand}" 
                                              Style="{StaticResource Style.Nav.RadioButton}"
                                              Visibility="{Binding CanNavInvoices, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Invoices"/>
                                    </StackPanel>
                                </RadioButton>

                                

                                <RadioButton Command="{Binding NavigateToShiftManagementCommand}"
                                              Style="{StaticResource Style.Nav.RadioButton}"
                                              Visibility="{Binding CanNavShiftManagement, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Shift Management"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Command="{Binding NavigateToDiscountCommand}"
                                              Style="{StaticResource Style.Nav.RadioButton}"
                                              Visibility="{Binding CanNavDiscount, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Discounts"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Command="{Binding NavigateToPromotionCommand}"
                                              Style="{StaticResource Style.Nav.RadioButton}"
                                              Visibility="{Binding CanNavPromotion, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Promotions"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Command="{Binding NavigateToSalesReturnCommand}"
                                              Style="{StaticResource Style.Nav.RadioButton}"
                                              Visibility="{Binding CanNavSalesReturn, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Sales Return"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Command="{Binding NavigateToCustomerCommand}"
                                              Style="{StaticResource Style.Nav.RadioButton}"
                                              Visibility="{Binding CanNavCustomer, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Customers"/>
                                    </StackPanel>
                                </RadioButton>
                                
                            </StackPanel>
                        </Expander>

                        <!-- Inventory Module -->
                        <Expander Header="Inventory" 
                                  Tag="{StaticResource Icon.Nav.Inventory}"
                                  Style="{StaticResource Style.Shell.Expander}"
                                  Focusable="False"
                                  Visibility="{Binding CanAccessInventory, Converter={StaticResource BoolToVisibility}}">

                            <StackPanel Margin="0">

                                <RadioButton Command="{Binding NavigateToProductListCommand}" 
                                             Style="{StaticResource Style.Nav.RadioButton}"
                                             Visibility="{Binding CanNavProductList, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Products"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Command="{Binding NavigateToStockTransferCommand}" 
                                             Style="{StaticResource Style.Nav.RadioButton}"
                                             Visibility="{Binding CanNavStockTransfer, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Stock Transfers"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Command="{Binding NavigateToProvisioningCommand}" 
                                             Style="{StaticResource Style.Nav.RadioButton}"
                                             Visibility="{Binding CanNavProvisioning, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Item Provisioning"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Command="{Binding NavigateToInternalIssueCommand}"
                                             Style="{StaticResource Style.Nav.RadioButton}"
                                             Visibility="{Binding CanNavInternalIssue, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Internal Stock Issue"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Command="{Binding NavigateToWastageCommand}" 
                                             Style="{StaticResource Style.Nav.RadioButton}"
                                             Visibility="{Binding CanNavWastage, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Wastage"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Command="{Binding NavigateToWastageApprovalCommand}" 
                                             Style="{StaticResource Style.Nav.RadioButton}"
                                             Visibility="{Binding CanNavWastageApproval, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Wastage Approval"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Command="{Binding NavigateToStockAdjustmentCommand}" 
                                             Style="{StaticResource Style.Nav.RadioButton}"
                                             Visibility="{Binding CanNavAdjustment, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Stock Adjustments"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Command="{Binding NavigateToBarcodePrintCommand}"
                                             Style="{StaticResource Style.Nav.RadioButton}"
                                             Visibility="Collapsed"> <!--{Binding CanNavBarcodePrint, Converter={StaticResource BoolToVisibility}}-->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Barcode Printing"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Command="{Binding NavigateToProductCommand}"
                                             Style="{StaticResource Style.Nav.RadioButton}"
                                             Visibility="{Binding CanNavProduct, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Product Setup"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Command="{Binding NavigateToCategoryCommand}"
                                             Style="{StaticResource Style.Nav.RadioButton}"
                                             Visibility="{Binding CanNavCategory, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Categories"/>
                                    </StackPanel>
                                </RadioButton>

                            </StackPanel>
                        </Expander>
                        
                        <!-- Purchasing Module -->
                        <Expander Header="Purchasing" 
                                  Tag="{StaticResource Icon.Nav.Purchasing}"
                                  Style="{StaticResource Style.Shell.Expander}"
                                  Focusable="False"
                                  Visibility="{Binding CanAccessPurchasing, Converter={StaticResource BoolToVisibility}}">

                            <StackPanel>
                                <RadioButton Command="{Binding NavigateToPOCommand}" 
                                             Style="{StaticResource Style.Nav.RadioButton}"
                                             Visibility="{Binding CanNavPO, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Purchase Orders"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Command="{Binding NavigateToPOApprovalCommand}"
                                             Style="{StaticResource Style.Nav.RadioButton}"
                                             Visibility="{Binding CanNavPOApproval, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Purchase Order Approval"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Command="{Binding NavigateToGRNCommand}" 
                                             Style="{StaticResource Style.Nav.RadioButton}"
                                             Visibility="{Binding CanNavGRN, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Goods Receipt Notes"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Command="{Binding NavigateToGRNApprovalCommand}"
                                             Style="{StaticResource Style.Nav.RadioButton}"
                                             Visibility="{Binding CanNavGRNApproval, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Goods Receipt Note Approval"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Command="{Binding NavigateToSupplierReturnCommand}" 
                                             Style="{StaticResource Style.Nav.RadioButton}"
                                             Visibility="{Binding CanNavSupplierReturn, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Return To Supplier"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Command="{Binding NavigateToSupplierReturnApprovalCommand}"
                                             Style="{StaticResource Style.Nav.RadioButton}"
                                             Visibility="{Binding CanNavSupplierReturnApproval, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Return To Supplier Approval"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Command="{Binding NavigateToSupplierCommand}" 
                                             Style="{StaticResource Style.Nav.RadioButton}"
                                             Visibility="{Binding CanNavSupplier, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Suppliers"/>
                                    </StackPanel>
                                </RadioButton>

                            </StackPanel>
                        </Expander>

                        <!-- Accounts Module -->
                        <Expander Header="Accounts" 
                                  Tag="{StaticResource Icon.Nav.Accounts}"
                                  Style="{StaticResource Style.Shell.Expander}"
                                  Focusable="False"
                                  Visibility="{Binding CanAccessAccounts, Converter={StaticResource BoolToVisibility}}">

                            <StackPanel>
                                <RadioButton Command="{Binding NavigateToAccountManagementCommand}" 
                                             Style="{StaticResource Style.Nav.RadioButton}"
                                             Visibility="{Binding CanNavAccountManagement, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Chart of Accounts"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Command="{Binding NavigateToAccountsPayableCommand}"
                                             Style="{StaticResource Style.Nav.RadioButton}"
                                             Visibility="{Binding CanNavAccountsPayable, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Accounts Payable"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Command="{Binding NavigateToAccountsReceivableCommand}"
                                             Style="{StaticResource Style.Nav.RadioButton}"
                                             Visibility="{Binding CanNavAccountsReceivable, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Accounts Receivable"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Command="{Binding NavigateToExpensesCommand}"
                                             Style="{StaticResource Style.Nav.RadioButton}"
                                             Visibility="{Binding CanNavExpenses, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Expenses"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Command="{Binding NavigateToOpeningBalanceCommand}"
                                             Style="{StaticResource Style.Nav.RadioButton}"
                                             Visibility="{Binding CanNavOpeningBalance, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Opening Balances"/>
                                    </StackPanel>
                                </RadioButton>

                            </StackPanel>
                            
                        </Expander>

                        <!-- Reports Module -->
                        <Expander Header="Reports" 
                                  Tag="{StaticResource Icon.Nav.Reports}"
                                  Style="{StaticResource Style.Shell.Expander}"
                                  Focusable="False"
                                  Visibility="{Binding CanAccessReports, Converter={StaticResource BoolToVisibility}}">

                            <StackPanel>
                                <RadioButton Command="{Binding NavigateToInventoryReportCommand}" 
                                             Style="{StaticResource Style.Nav.RadioButton}"
                                             Visibility="{Binding CanNavInvReport, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Inventory Reports"/>
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Command="{Binding NavigateToSalesReportCommand}" 
                                             Style="{StaticResource Style.Nav.RadioButton}"
                                             Visibility="{Binding CanNavSalesReport, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Sales Reports"/>
                                    </StackPanel>
                                </RadioButton>
                                
                            </StackPanel>
                        </Expander>

                        <!-- Security Module -->
                        <Expander Header="Security" 
                                  Tag="{StaticResource Icon.Nav.Security}"
                                  Style="{StaticResource Style.Shell.Expander}"
                                  Focusable="False"
                                  Visibility="{Binding CanAccessSecurity, Converter={StaticResource BoolToVisibility}}">

                            <StackPanel>
                                <RadioButton Command="{Binding NavigateToUserCommand}" 
                                             Style="{StaticResource Style.Nav.RadioButton}"
                                             Visibility="{Binding CanNavUsers, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="User Management"/>
                                    </StackPanel>
                                </RadioButton>

                            </StackPanel>
                        </Expander>

                        <!-- Settings Module -->
                        <Expander Header="Settings"
                                  Tag="{StaticResource Icon.Nav.Settings}"
                                  Style="{StaticResource Style.Shell.Expander}"
                                  Focusable="False"
                                  Visibility="{Binding CanAccessSettings, Converter={StaticResource BoolToVisibility}}">

                            <StackPanel>
                                <RadioButton Command="{Binding NavigateToSettingsCommand}"
                                             Style="{StaticResource Style.Nav.RadioButton}"
                                             Visibility="{Binding CanNavConfiguration, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="System Configuration"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Expander>
                        
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ========================================================== -->
            <!-- MAIN CONTENT -->
            <!-- ========================================================== -->
            <Border Grid.Column="1" Style="{StaticResource Style.Shell.Content}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Text="{Binding CurrentPageTitle}" 
                               FontSize="14" 
                               Foreground="{StaticResource BrandBrush}" 
                               FontWeight="SemiBold" 
                               Margin="12,4,0,0 "/>

                    <Border Grid.Row="1" Margin="0" Padding="10" Background="{StaticResource Brush.App.Background}">
                        <ContentControl Content="{Binding CurrentViewModel}"/>
                    </Border>

                    <Border Grid.RowSpan="2" 
                            Background="#90000000" Panel.ZIndex="100"
                            Visibility="{Binding CurrentViewModel.IsOverlayVisible, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                    </Border>
                </Grid>

            </Border>

        </Grid>

        <!-- ========================================================== -->
        <!-- FOOTER / STATUS BAR -->
        <!-- ========================================================== -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Style.Shell.Footer}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="2" Style="{StaticResource Style.Text.Status}" Margin="20,0,0,0">
                    <Run Text="v1.0.0 | "/>
                    <Run Text="{Binding CurrentDateTime, StringFormat='dd/MM/yyyy - HH:mm:ss'}"/>
                </TextBlock>
                
            </Grid>
        </Border>

    </Grid>
</Window>

