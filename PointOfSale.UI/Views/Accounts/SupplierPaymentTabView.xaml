<UserControl x:Class="PointOfSale.UI.Views.Accounts.SupplierPaymentTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PointOfSale.UI.Views.Accounts"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Supplier Payment Management" Style="{StaticResource HeaderTextStyle}"/>

        <!-- Tab Control -->
        <TabControl Grid.Row="1" 
                    Style="{StaticResource TabControlStyle}"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

            <!-- Tab Headers Container -->
            <TabControl.Resources>
                <Style TargetType="TabPanel">
                    <Setter Property="Background" Value="#F7F9FA"/>
                    <Setter Property="Margin" Value="8"/>
                </Style>
            </TabControl.Resources>

            <!-- Payment Tab -->
            <TabItem Header="Payment" Style="{StaticResource TabItemStyle}">
                <TabItem.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12 2L2 7v10c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-10-5zm0 18c-3.31 0-6-2.69-6-6s2.69-6 6-6 6 2.69 6 6-2.69 6-6 6zm-1-11h2v6h-2zm0 8h2v2h-2z"
                                  Fill="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}"
                                  Stretch="Uniform"
                                  Width="16"
                                  Height="16"
                                  Margin="0,0,8,0"/>
                            
                            <TextBlock Text="Payment" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </TabItem.HeaderTemplate>
                <ContentControl Content="{Binding PaymentViewModel}"/>
            </TabItem>

            <!-- Advance Payment Tab -->
            <TabItem Header="Advance Payment" Style="{StaticResource TabItemStyle}">
                <TabItem.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M11 17h2v-1h1c.55 0 1-.45 1-1v-3c0-.55-.45-1-1-1h-3v-1h4V8h-2V7h-2v1h-1c-.55 0-1 .45-1 1v3c0 .55.45 1 1 1h3v1H9v2h2v1zm9-13H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4V6h16v12z"
                                  Fill="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}"
                                  Stretch="Uniform"
                                  Width="16"
                                  Height="16"
                                  Margin="0,0,8,0"/>    

                            <TextBlock Text="Advance Payment" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </TabItem.HeaderTemplate>
                <ContentControl Content="{Binding AdvanceViewModel}"/>
            </TabItem>

            <!-- Settlement Tab -->
            <TabItem Header="Settlement" Style="{StaticResource TabItemStyle}">
                <TabItem.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zM7 10h2v7H7zm4-3h2v10h-2zm4 6h2v4h-2z"
                                  Fill="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}"
                                  Stretch="Uniform"
                                  Width="16"
                                  Height="16"
                                  Margin="0,0,8,0"/>    

                            <TextBlock Text="Settlement" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </TabItem.HeaderTemplate>
                <ContentControl Content="{Binding SettlementViewModel}"/>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
