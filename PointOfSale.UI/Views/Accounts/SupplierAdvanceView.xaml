<UserControl x:Class="PointOfSale.UI.Views.Accounts.SupplierAdvanceView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PointOfSale.UI.Views.Accounts"
        mc:Ignorable="d"
        d:DesignHeight="520" d:DesignWidth="800">
    
    <Grid Margin="0,4,0,0">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="285"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel - Form -->
        <Border Style="{StaticResource PanelCardStyle}" Margin="0 0 8 0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    
                    <TextBlock Text="Supplier Advance" Style="{StaticResource SubHeaderTextStyle}"/>

                    <!-- Supplier Selection -->
                    <TextBlock Text="Supplier *" Style="{StaticResource LabelStyle}"/>
                    <ComboBox x:Name="SupplierComboBox"
                            Style="{StaticResource ComboBoxStyle}"
                            ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                            ItemsSource="{Binding Suppliers}"
                            SelectedItem="{Binding SelectedSupplier, UpdateSourceTrigger=PropertyChanged}"
                            Tag="Select a supplier"
                            DisplayMemberPath="SupplierName"
                            SelectedValuePath="SupplierId"
                            Margin="0,0,0,8"
                            KeyDown="SupplierComboBox_KeyDown"/>

                    <!-- Payment Date -->
                    <TextBlock Text="Payment Date *" 
                                Style="{StaticResource LabelStyle}"/>
                    <DatePicker x:Name="PaymentDatePicker"
                                 SelectedDate="{Binding PaymentDate, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 Style="{StaticResource DatePickerStyle}"
                                 Margin="0,0,0,8"
                                 Validation.ErrorTemplate="{StaticResource ErrorTemplate}"/>

                    <!-- Payment Method -->
                    <TextBlock Text="Payment Method *" Style="{StaticResource LabelStyle}"/>
                    <ComboBox Name="PaymentMethodComboBox"
                            ItemsSource="{Binding PaymentMethods}"
                            SelectedItem="{Binding SelectedPaymentMethod, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, ValidatesOnNotifyDataErrors=True}"
                            Style="{StaticResource ComboBoxStyle}"
                            ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                            KeyDown="PaymentMethodComboBox_KeyDown"/>

                    <!-- Reference Number -->
                    <TextBlock Text="Reference Number" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="ReferenceNumberTextBox"
                            Text="{Binding ReferenceNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                            Style="{StaticResource TextBoxStyle}"
                            MaxLength="50"
                            KeyDown="ReferenceNumberText_KeyDown"/>

                    <!-- Payment Amount -->
                    <TextBlock Text="Payment Amount *" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="PaymentAmountTextBox"
                            Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, StringFormat=N2 }"
                            Grid.Column="1"
                            Style="{StaticResource TextBoxStyle}"
                            Margin="0"
                            Padding="12,2"
                            TextAlignment="Right"
                            KeyDown="PaymentAmountText_KeyDown"/>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,24,0,0" HorizontalAlignment="Left">
                        <Button Content="Save"
                                Command="{Binding SaveAdvanceCommand}" 
                                Style="{StaticResource PrimaryButtonStyle}" 
                                Name="SaveButton"
                                Margin="0,0,10,0"/>

                        <Button Content="Reset" 
                                Command="{Binding ClearCommand}" 
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,0,0"/>
                        
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Right Panel - Data Grid -->
        <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Border Grid.Row="0" Background="#F1F2F6" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                   Text="Advance List" 
                                   Style="{StaticResource SubHeaderTextStyle}" 
                                   VerticalAlignment="Center"
                                   Margin="0"/>

                        <Button Grid.Column="1"
                                Command="{Binding LoadAdvancesCommand}" 
                                Style="{StaticResource RefreshButtonStyle}" 
                                ToolTip="Refresh Advance List"
                                Margin="10,0,0,0"/>

                        <Button Grid.Column="3"
                                Command="{Binding CancelAdvanceCommand}" 
                                Style="{StaticResource DeleteButtonStyle}" 
                                ToolTip="Delete Supplier"/>
                    </Grid>
                </Border>

                <!-- Data Grid -->
                <DataGrid Grid.Row="1" 
                        ItemsSource="{Binding UnappliedAdvances}" 
                        SelectedItem="{Binding SelectedAdvance, UpdateSourceTrigger=PropertyChanged}" 
                        Style="{StaticResource DataGridStyle}"
                        Margin="0,4,0,0"
                        AutoGenerateColumns="False"
                        SelectionMode="Single"
                        CanUserAddRows="False"
                        IsReadOnly="True">
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding AdvanceId}" Width="60" Visibility="Hidden"/>
                        <DataGridTextColumn Header="Supplier Name" Binding="{Binding SupplierName}" Width="*" MinWidth="120" />
                        <DataGridTextColumn Header="Transaction Number" Binding="{Binding TransactionNumber}" Width="200"/>
                        <DataGridTextColumn Header="Payment Date" Binding="{Binding PaymentDate}" Width="150" />
                        <DataGridTextColumn Header="Paid Amount" Binding="{Binding PaidAmount, StringFormat='Rs. {0:N2}'}" Width="150" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}" ElementStyle="{StaticResource RightAlignedTextStyle}"/>
                        <DataGridTextColumn Header="Unapplied Amount" Binding="{Binding UnappliedAmount, StringFormat='Rs. {0:N2}'}" Width="150" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}" ElementStyle="{StaticResource RightAlignedTextStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
