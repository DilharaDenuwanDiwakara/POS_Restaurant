<Window x:Class="PointOfSale.UI.Views.Accounts.Dialogs.ExpensesCategoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PointOfSale.UI.Views.Accounts.Dialogs"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Height="450" Width="650">
    
    <Border Style="{StaticResource WindowBorderStyle}">
        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource Brush.Structure.Sidebar}"
                   CornerRadius="8,8,0,0"
                   Padding="10,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Expenses Category" 
                                  Foreground="{StaticResource Brush.Text.OnDark}" 
                                  Style="{StaticResource HeaderTextStyle}"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                           Style="{StaticResource IconOnlyButtonStyle}"
                           Background="Transparent"
                           Click="CloseButton_Click"
                           ToolTip="Close">
                        <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                           Fill="{StaticResource Brush.Text.OnDark}"
                           Width="12" Height="12" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="285"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Panel - Form -->
                <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Expenses Category Form" Style="{StaticResource SubHeaderTextStyle}" Margin="0,0,0,12"/>

                        <!-- Category Name -->
                        <TextBlock Text="Category Name:" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="CategoryNameTextBox"
                                 Text="{Binding ExpensesCategoryName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 MaxLength="100"
                                 Style="{StaticResource TextBoxStyle}"
                                 CharacterCasing="Upper"
                                 PreviewKeyDown="MoveFocusOnEnter"/>

                        <!-- Mapped GL Account -->
                        <TextBlock Text="Mapped GL Account:" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding GLExpenseAccounts}"
                                  SelectedItem="{Binding SelectedGLExpenseAccount, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="DisplayText"
                                  Style="{StaticResource ComboBoxStyle}"
                                  ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                  PreviewKeyDown="MoveFocusOnEnter"/>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Center">
                            <Button Name="SubmitButton"
                                    Content="{Binding SaveButtonText}"
                                    Command="{Binding SaveExpensesCategoryCommand}" 
                                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"                                  
                                    Style="{StaticResource PrimaryButtonStyle}" 
                                    Click="SaveButton_Click"
                                    Margin="0,0,12,0"/>

                            <Button Content="Edit" 
                                   Command="{Binding EditExpensesCategoryCommand}" 
                                   Style="{StaticResource SecondaryButtonStyle}"/>

                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Right Panel - Data Grid -->
                <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Data Grid Header - Fixed Alignment -->
                        <Border Background="#F1F2F6" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" 
                                          Text="Expenses Category List" 
                                          Style="{StaticResource SubHeaderTextStyle}" 
                                          VerticalAlignment="Center"
                                          Margin="0"/>

                                <Button Grid.Column="3"
                                       Command="{Binding DeleteExpensesCategoryCommand}" 
                                       Style="{StaticResource DeleteButtonStyle}" 
                                       ToolTip="Delete Brand">

                                </Button>
                            </Grid>
                        </Border>

                        <!-- Data Grid -->
                        <DataGrid Grid.Row="1" 
                                 ItemsSource="{Binding ExpensesCategoryList}" 
                                 SelectedItem="{Binding SelectedExpensesCategory, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,12,0,0"
                                 AutoGenerateColumns="False"
                                 SelectionMode="Single"
                                 CanUserAddRows="False"
                                 IsReadOnly="True"
                                 Style="{StaticResource DataGridStyle}">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding ExpensesCategoryId}" Width="Auto" Visibility="Hidden"/>
                                <DataGridTextColumn Header="Expenses Category Name" Binding="{Binding ExpensesCategoryName}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                    </Grid>
                </Border>

            </Grid>

        </Grid>
    </Border>
</Window>
