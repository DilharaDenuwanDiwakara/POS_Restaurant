<UserControl x:Class="PointOfSale.UI.Views.Accounts.AccountInquiryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
             UseLayoutRounding="True" SnapsToDevicePixels="True" FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
        <!-- Extend the application's component styles; keep its theme and control templates. -->
        <Style x:Key="Inquiry.Caption" TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
            <Setter Property="FontStyle" Value="Normal" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Inquiry.BalanceCard" TargetType="Border" BasedOn="{StaticResource PanelCardStyle}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style x:Key="Inquiry.Amount" TargetType="TextBlock" BasedOn="{StaticResource HeaderTextStyle}">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style x:Key="Inquiry.Header" TargetType="DataGridColumnHeader" BasedOn="{StaticResource Style.DataGrid.ColumnHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style x:Key="Inquiry.Cell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style x:Key="Inquiry.Number" TargetType="TextBlock" BasedOn="{StaticResource Inquiry.Cell}">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="Inquiry.AccountItem" TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItemStyle}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="{Binding Depth, Converter={StaticResource LevelToMarginConverter}}" />
            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsGroupHeading}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Foreground" Value="{StaticResource BrandBrush}" />
                    <Setter Property="Background" Value="{StaticResource Brush.App.Background}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="140" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Account Inquiry" Style="{StaticResource HeaderTextStyle}" Margin="0,0,0,4" />
            <TextBlock Text="Review general ledger activity and balances for a selected period."
                       Style="{StaticResource Inquiry.Caption}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource PanelCardStyle}" Padding="16,12,4,12">
            <StackPanel>
                <WrapPanel KeyboardNavigation.TabNavigation="Local">
                    <WrapPanel.Style>
                        <Style TargetType="WrapPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLoadingAccounts}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </WrapPanel.Style>
                    <StackPanel Width="384" Margin="0,0,16,8">
                        <TextBlock Text="Account" Style="{StaticResource LabelStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="AccountSelector" Style="{StaticResource ComboBoxStyle}" Height="36" Margin="0"
                                      ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayText" ItemContainerStyle="{StaticResource Inquiry.AccountItem}"
                                      IsTextSearchEnabled="True" TextSearch.TextPath="DisplayText" MaxDropDownHeight="420"
                                      AutomationProperties.Name="Account" ToolTip="{Binding SelectedAccount.ToolTip}" />
                            <TextBlock Text="Select an account…" Margin="8,0,32,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.Text.Muted}" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedAccount}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button x:Name="ReloadAccountsButton" Grid.Column="2"
                                    Command="{Binding ReloadAccountsCommand}"
                                    Style="{StaticResource RefreshButtonStyle}" Width="36" Height="36"
                                    ToolTip="Reload accounts" AutomationProperties.Name="Reload accounts" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Width="165" Margin="0,0,16,8">
                        <TextBlock Text="From date" Style="{StaticResource LabelStyle}" />
                        <DatePicker x:Name="FromDateInput" Style="{StaticResource DatePickerStyle}" Height="36" Margin="0"
                                    AutomationProperties.Name="From date" SelectedDateFormat="Short"
                                    SelectedDate="{Binding FromDate, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                    </StackPanel>
                    <StackPanel Width="165" Margin="0,0,16,8">
                        <TextBlock Text="To date" Style="{StaticResource LabelStyle}" />
                        <DatePicker x:Name="ToDateInput" Style="{StaticResource DatePickerStyle}" Height="36" Margin="0"
                                    AutomationProperties.Name="To date" SelectedDateFormat="Short"
                                    SelectedDate="{Binding ToDate, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                    </StackPanel>
                    <Button x:Name="GenerateButton" Content="_Generate report" Command="{Binding LoadReportCommand}"
                            Width="160" Height="36" VerticalAlignment="Bottom" Margin="0,0,12,8"
                            ToolTip="Generate the ledger for the selected account and dates (Alt+G)."
                            AutomationProperties.Name="Generate report">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=FromDateInput, Path=(Validation.HasError)}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ElementName=ToDateInput, Path=(Validation.HasError)}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ElementName=FromDateInput, Path=SelectedDate}" Value="{x:Null}">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ElementName=ToDateInput, Path=SelectedDate}" Value="{x:Null}">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </WrapPanel>
                <TextBlock Text="{Binding AccountsHint}" Style="{StaticResource Inquiry.Caption}" Margin="0,0,12,0" />
                <TextBlock Text="{Binding SelectedAccount.HierarchyPath}" ToolTip="{Binding SelectedAccount.HierarchyPath}"
                           Style="{StaticResource Inquiry.Caption}" Foreground="{StaticResource BrandBrush}" Margin="0,6,12,0" />
                <Border Style="{StaticResource PanelErrorStyle}" Padding="12,8" Margin="0,10,12,0"
                        Visibility="{Binding HasAccountsError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding AccountsErrorMessage}" Style="{StaticResource ErrorStyle}" Margin="0" />
                </Border>
                <TextBlock Text="Filters changed. Generate the report to update the results."
                           Style="{StaticResource Inquiry.Caption}" Foreground="{StaticResource BrandBrush}" Margin="0,8,0,0"
                           Visibility="{Binding HasFilterChanges, Converter={StaticResource BoolToVisibility}}" />
                <Border Style="{StaticResource PanelErrorStyle}" Padding="12,8" Margin="0,10,12,0"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorStyle}" Margin="0"
                               AutomationProperties.LiveSetting="Assertive" />
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" /><ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" /><ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Inquiry.BalanceCard}">
                <StackPanel>
                    <TextBlock Text="Opening balance" Style="{StaticResource Inquiry.Caption}" />
                    <TextBlock Style="{StaticResource Inquiry.Amount}"
                               Text="{Binding Summary.OpeningBalance, StringFormat={}{0:N2}, TargetNullValue=—, FallbackValue=—}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Inquiry.BalanceCard}">
                <StackPanel>
                    <TextBlock Text="Total debit" Style="{StaticResource Inquiry.Caption}" />
                    <TextBlock Style="{StaticResource Inquiry.Amount}"
                               Text="{Binding Summary.TotalDebit, StringFormat={}{0:N2}, TargetNullValue=—, FallbackValue=—}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Inquiry.BalanceCard}">
                <StackPanel>
                    <TextBlock Text="Total credit" Style="{StaticResource Inquiry.Caption}" />
                    <TextBlock Style="{StaticResource Inquiry.Amount}"
                               Text="{Binding Summary.TotalCredit, StringFormat={}{0:N2}, TargetNullValue=—, FallbackValue=—}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="6" Style="{StaticResource Inquiry.BalanceCard}" BorderBrush="{StaticResource BrandBrush}">
                <StackPanel>
                    <TextBlock Text="Closing balance" Style="{StaticResource Inquiry.Caption}" Foreground="{StaticResource BrandBrush}" />
                    <TextBlock Style="{StaticResource Inquiry.Amount}" Foreground="{StaticResource BrandBrush}"
                               Text="{Binding Summary.ClosingBalance, StringFormat={}{0:N2}, TargetNullValue=—, FallbackValue=—}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource PanelCardStyle}" Padding="16,10" Margin="0,0,0,12"
                Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}">
            <WrapPanel>
                <TextBlock Text="{Binding Summary.AccountCode}" FontWeight="SemiBold" Foreground="{StaticResource BrandBrush}" Margin="0,0,12,0" />
                <TextBlock Text="{Binding Summary.AccountName}" Foreground="{StaticResource Brush.Text.Primary}" FontWeight="SemiBold" Margin="0,0,20,0" />
                <TextBlock Text="{Binding ReportGeneralAccountCode, StringFormat='General account code: {0}'}" Style="{StaticResource Inquiry.Caption}" Margin="0,0,20,0" />
                <TextBlock Text="{Binding Summary.NormalBalanceType, StringFormat='Normal balance: {0}'}" Style="{StaticResource Inquiry.Caption}" />
            </WrapPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource PanelCardStyle}" Padding="0" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Transactions" Style="{StaticResource SubHeaderTextStyle}" Margin="0,0,0,3" />
                        <TextBlock Text="{Binding ReportPeriod}" Style="{StaticResource Inquiry.Caption}" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource Brush.App.Background}" CornerRadius="4" Padding="10,5" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{Binding TransactionLines.Count, StringFormat='Lines: {0:N0}'}" Foreground="{StaticResource Brush.Text.Muted}" />
                    </Border>
                </Grid>
                <!-- Keep the DataGrid in a bounded star row so virtualization remains effective. -->
                <Grid Grid.Row="1">
                    <DataGrid x:Name="LedgerGrid" ItemsSource="{Binding TransactionLines}" Style="{StaticResource DataGridStyle}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserSortColumns="False" CanUserReorderColumns="False" HeadersVisibility="Column"
                              ColumnHeaderStyle="{StaticResource Inquiry.Header}" BorderThickness="0,1,0,1"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True" GridLinesVisibility="Horizontal"
                              ClipboardCopyMode="IncludeHeader" AutomationProperties.Name="Account ledger transactions">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding TransactionDate, StringFormat={}{0:dd/MM/yyyy}}" Width="112" ElementStyle="{StaticResource Inquiry.Cell}" />
                            <DataGridTextColumn Header="Document no." Binding="{Binding DocumentNo}" Width="140" ElementStyle="{StaticResource Inquiry.Cell}" />
                            <DataGridTextColumn Header="Source" Binding="{Binding SourceType}" Width="110" ElementStyle="{StaticResource Inquiry.Cell}" />
                            <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="140" ElementStyle="{StaticResource Inquiry.Cell}" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="180" ElementStyle="{StaticResource Inquiry.Cell}" />
                            <DataGridTextColumn Header="Debit" Binding="{Binding Debit, StringFormat={}{0:N2}}" Width="125" ElementStyle="{StaticResource Inquiry.Number}" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}" />
                            <DataGridTextColumn Header="Credit" Binding="{Binding Credit, StringFormat={}{0:N2}}" Width="125" ElementStyle="{StaticResource Inquiry.Number}" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}" />
                            <DataGridTextColumn Header="Running balance" Binding="{Binding RunningBalance, StringFormat={}{0:N2}}" Width="160" ElementStyle="{StaticResource Inquiry.Number}" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border x:Name="EmptyState" Background="{StaticResource Brush.Card.Surface}" Margin="1,41,1,1" IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TransactionLines.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" MaxWidth="440">
                            <TextBlock TextAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubHeaderTextStyle}">
                                        <Setter Property="Text" Value="Generate an account inquiry" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasReport}" Value="True"><Setter Property="Text" Value="No transactions in this period" /></DataTrigger>
                                            <DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Text" Value="Report unavailable" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock TextAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Inquiry.Caption}">
                                        <Setter Property="Text" Value="Select an account, choose a date range, and select Generate report to view ledger activity." />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasReport}" Value="True"><Setter Property="Text" Value="There are no ledger entries for these dates. Opening and closing balances are shown above." /></DataTrigger>
                                            <DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Text" Value="Review the message above, check your filters, and generate the report again." /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border x:Name="LoadingState" Background="{StaticResource Brush.Card.Surface}" Margin="1,41,1,1"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="240">
                            <TextBlock Text="Loading ledger activity…" TextAlignment="Center" Style="{StaticResource SubHeaderTextStyle}" />
                            <ProgressBar IsIndeterminate="{Binding IsLoading}" Height="4" Foreground="{StaticResource BrandBrush}" Margin="0,8,0,0"
                                         AutomationProperties.Name="Loading account inquiry" />
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock Grid.Row="2" Text="Transactions are shown in ledger order. Select a row and press Ctrl+C to copy."
                           Style="{StaticResource Inquiry.Caption}" Margin="16,10" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
