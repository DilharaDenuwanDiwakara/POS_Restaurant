<UserControl x:Class="PointOfSale.UI.Views.Accounts.AccountRegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:PointOfSale.UI.ViewModels.Accounts"
             mc:Ignorable="d"
             d:DesignHeight="620"
             d:DesignWidth="1100">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Account Register (Chart of Accounts)" Style="{StaticResource HeaderTextStyle}"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="285"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- Left Pane: Form -->
            <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Account Form" Style="{StaticResource SubHeaderTextStyle}"/>

                    <TextBlock Text="Account Type" Style="{StaticResource LabelStyle}"/>
                    <Grid Margin="0 0 0 12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="AccountTypeComboBox"
                                  ItemsSource="{Binding AccountTypes}"
                                  SelectedItem="{Binding SelectedAccountType, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource ComboBoxStyle}"
                                  Margin="0"
                                  PreviewKeyDown="MoveFocusOnEnter"/>

                        <Button Grid.Column="1"
                                Command="{Binding OpenAccountTypesCommand}"
                                Margin="4,0,0,0"
                                ToolTip="Manage Account Types"
                                Style="{StaticResource AddButtonStyle}"
                                Focusable="False"/>
                    </Grid>

                    <TextBlock Text="Parent Account" Style="{StaticResource LabelStyle}"/>
                    <ComboBox ItemsSource="{Binding AvailableParentAccounts}"
                              SelectedItem="{Binding SelectedParentAccount, UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="DisplayName"
                              Style="{StaticResource ComboBoxStyle}"
                              PreviewKeyDown="MoveFocusOnEnter"/>

                    <TextBlock Style="{StaticResource LabelStyle}">
                        <Run Text="Account Code (4 Digits)"/>
                        <Run Text="{Binding CodePatternHint, Mode=OneWay}" Foreground="Gray"/>
                    </TextBlock>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Width="80"
                                 IsReadOnly="True"
                                 Text="{Binding LockedCodePrefixDisplay, Mode=OneWay}"
                                 Style="{StaticResource TextBoxStyle}"
                                 Focusable="False"/>

                        <TextBox Grid.Column="1"
                                 Text="{Binding EditableCodePart, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 MaxLength="{Binding EditableDigitsCount}"
                                 Style="{StaticResource TextBoxStyle}"
                                 PreviewKeyDown="MoveFocusOnEnter"
                                 LostFocus="EditableCodePartTextBox_LostFocus"
                                 GotKeyboardFocus="SelectAllText_GotFocus"/>
                    </Grid>

                    <TextBlock Text="Account Name" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding AccountName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                             Style="{StaticResource TextBoxStyle}"
                             CharacterCasing="Upper"
                             PreviewKeyDown="MoveFocusOnEnter"/>

                    <TextBlock Text="Description" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                             Style="{StaticResource TextBoxStyle}"
                             AcceptsReturn="False"
                             MaxLength="500"
                             PreviewKeyDown="MoveFocusOnEnter"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="1"
                                  Content="Is Header Account"
                                  IsChecked="{Binding IsHeader}"  
                                  PreviewKeyDown="MoveFocusOnEnter"/>

                        <CheckBox Content="Is Active"   
                                  IsChecked="{Binding IsActive}"  
                                  Focusable="False"/>
                        
                    </Grid>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,24,0,0" HorizontalAlignment="Center">
                        <Button Content="{Binding SaveButtonText}"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,10,0"
                                Click="SaveButton_Click"/>

                        <Button Content="Clear"
                                Command="{Binding ClearCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Focusable="False"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Center Pane: Account List -->
            <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="#F1F2F6" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Margin="0"
                                       Text="Account List"
                                       Style="{StaticResource SubHeaderTextStyle}"
                                       VerticalAlignment="Center"/>

                            <Button Grid.Column="1"
                                    Command="{Binding LoadCommand}"
                                    Style="{StaticResource RefreshButtonStyle}"
                                    ToolTip="Refresh Account List"
                                    HorizontalAlignment="Left"
                                    Margin="12,0,0,0"/>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1"
                              Margin="0,4,0,0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              ItemsSource="{Binding AccountsList}"
                              SelectedItem="{Binding SelectedAccount, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource DataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="GL No"    Binding="{Binding Code}"            Width="100"/>
                            <DataGridTextColumn Header="GL Name"  Binding="{Binding Name}"            Width="*"/>
                            <DataGridTextColumn Header="Type"     Binding="{Binding AccountTypeName}" Width="140"/>
                            <DataGridCheckBoxColumn Header="Header" Binding="{Binding IsHeader}"      Width="100"/>
                            <DataGridTextColumn Header="Is Active" Binding="{Binding IsActive}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Right Pane: Hierarchy Tree -->
            <Border Grid.Column="2" Style="{StaticResource PanelCardStyle}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Chart Hierarchy" Style="{StaticResource SubHeaderTextStyle}"/>

                    <TreeView Grid.Row="1" ItemsSource="{Binding ChartOfAccounts}" Margin="0,4,0,0">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="{Binding Code}"  Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text=" - "             Style="{StaticResource LabelStyle}"/>
                                    <TextBlock Text="{Binding Name}"  Style="{StaticResource LabelStyle}"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>
