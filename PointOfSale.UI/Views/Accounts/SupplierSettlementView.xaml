<UserControl x:Class="PointOfSale.UI.Views.Accounts.SupplierSettlementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PointOfSale.UI.Views.Accounts"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Margin="0 4 0 0">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Filter Panel -->
        <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ComboBox ItemsSource="{Binding Suppliers}"
                          SelectedItem="{Binding SelectedSupplier, UpdateSourceTrigger=PropertyChanged}"
                          DisplayMemberPath="SupplierName"
                          Style="{StaticResource ComboBoxStyle}"
                          ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                          Tag="Select Supplier"
                          VerticalAlignment="Center"
                          Margin="0 0 12 0"/>

                <Button Grid.Column="1"
                        Command="{Binding LoadPayablesCommand}"
                        Style="{StaticResource SearchButtonStyle}"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main Content - Split View -->
        <Grid Grid.Row="1">
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Payables -->
            <Border Grid.Column="0" BorderBrush="#E1E8ED" BorderThickness="1" 
                    Background="White" Padding="8" Margin="0 0 4 0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Payables Header -->
                    <Border Grid.Row="0" Background="#FEF3F3" Padding="12,4" >
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M19,14H5V12H19V14M19,10H5V8H19V10M19,6H5V4H19V6Z" 
                                      Fill="#DC3545" 
                                      Width="16" 
                                      Height="16" 
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"/>

                                <TextBlock Text="Unpaid &amp; Partially Paid Invoices" 
                                           Style="{StaticResource SubHeaderTextStyle}" 
                                           Foreground="#DC3545"
                                           VerticalAlignment="Center"
                                           Margin="0"/>

                                <TextBlock Text="{Binding PayableItems.Count, StringFormat='({0})'}"
                                           Style="{StaticResource LabelStyle}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Command="{Binding LoadPayablesCommand}" 
                                    Style="{StaticResource RefreshButtonStyle}" 
                                    ToolTip="Refresh Payables"/>
                        </Grid>
                    </Border>

                    <!-- Payables DataGrid -->
                    <DataGrid Grid.Row="1" 
                              ItemsSource="{Binding PayableItems}" 
                              Style="{StaticResource DataGridStyle}"
                              AutoGenerateColumns="False"
                              SelectionMode="Extended"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Select" 
                                        Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                        Width="60"/>

                            <DataGridTextColumn Header="Invoice #" 
                                        Binding="{Binding InvoiceNumber}" 
                                        Width="100" 
                                        IsReadOnly="True"/>

                            <DataGridTextColumn Header="Date" 
                                        Binding="{Binding InvoiceDate, StringFormat='{}{0:dd/MM/yyyy}'}" 
                                        Width="90" 
                                        IsReadOnly="True"/>

                            <DataGridTextColumn Header="Due Date" 
                                        Binding="{Binding DueDate, StringFormat='{}{0:dd/MM/yyyy}'}" 
                                        Width="90" 
                                        IsReadOnly="True"/>

                            <DataGridTextColumn Header="Amount Due" 
                                        Binding="{Binding AmountDue, StringFormat='Rs. {0:N2}'}" 
                                        Width="100" 
                                        ElementStyle="{StaticResource RightAlignedTextStyle}"
                                        IsReadOnly="True" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}"/>

                            <DataGridTemplateColumn Header="Payment" Width="100" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N2}'}"
                                                 IsEnabled="{Binding IsSelected}"
                                                 HorizontalContentAlignment="Right"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Right Panel - Available Credits -->
            <Border Grid.Column="2" BorderBrush="#E1E8ED" BorderThickness="1" 
                    Background="White" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Credits Header -->
                    <Border Background="#F0F8F5" Padding="12,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M12,20C7.58,20 4,16.42 4,12C4,7.58 7.58,4 12,4C16.42,4 20,7.58 20,12C20,16.42 16.42,20 12,20M16.59,7.58L10,14.17L7.41,11.59L6,13L10,17L18,9L16.59,7.58Z" 
                                      Fill="#28A745" 
                                      Width="16" 
                                      Height="16" 
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"/>

                                <TextBlock Text="Available Credits" 
                                           Style="{StaticResource SubHeaderTextStyle}" 
                                           Foreground="#28A745"
                                           VerticalAlignment="Center"
                                           Margin="0"/>

                                <TextBlock Text="{Binding CreditItems.Count, StringFormat='({0})'}"
                                           Style="{StaticResource LabelStyle}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Command="{Binding LoadCreditsCommand}" 
                                    Style="{StaticResource RefreshButtonStyle}" 
                                    ToolTip="Refresh Credits">
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Credits DataGrid -->
                    <DataGrid Grid.Row="1" 
                              ItemsSource="{Binding CreditItems}" 
                              Style="{StaticResource DataGridStyle}"
                              AutoGenerateColumns="False"
                              SelectionMode="Extended"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False">
                        
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Use" 
                                        Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                        Width="60" />

                            <DataGridTextColumn Header="Reference" 
                                        Binding="{Binding ReferenceNumber}" 
                                        Width="100" 
                                        IsReadOnly="True"/>

                            <DataGridTextColumn Header="Type" 
                                        Binding="{Binding SourceType}" 
                                        Width="90" 
                                        IsReadOnly="True"/>

                            <DataGridTextColumn Header="Date" 
                                        Binding="{Binding CreditDate, StringFormat='{}{0:dd/MM/yyyy}'}" 
                                        Width="90" 
                                        IsReadOnly="True"/>

                            <DataGridTextColumn Header="Available" 
                                        Binding="{Binding RemainingAmount, StringFormat='Rs. {0:N2}'}" 
                                        Width="100" 
                                        ElementStyle="{StaticResource RightAlignedTextStyle}"
                                        IsReadOnly="True" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}"/>

                            <DataGridTemplateColumn Header="Apply" Width="100" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding ApplyAmount, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N2}'}"
                                                 IsEnabled="{Binding IsSelected}"
                                                 HorizontalContentAlignment="Right"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Payment Details and Summary Panel -->
        <Border Grid.Row="2" BorderBrush="#E1E8ED" BorderThickness="1" 
                Background="#F8F9FA" Padding="6" Margin="0,4,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="400"/>
                </Grid.ColumnDefinitions>

                <!-- Left Side - Payment Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Payment Date:" 
                               Style="{StaticResource LabelStyle}" 
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <DatePicker SelectedDate="{Binding PaymentDate, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource DatePickerStyle}"
                                Width="150"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0"/>

                    <TextBlock Text="Payment Method:" 
                               Style="{StaticResource LabelStyle}" 
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <ComboBox ItemsSource="{Binding PaymentMethods}"
                              SelectedItem="{Binding SelectedPaymentMethod, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource ComboBoxStyle}"
                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                              Width="150"
                              Margin="0,0,12,0"
                              VerticalAlignment="Center"
                              Tag="Select Method"/>

                    <TextBlock Text="Pay From Account:" 
                               Style="{StaticResource LabelStyle}" 
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <ComboBox ItemsSource="{Binding PaymentAccounts}"
                              SelectedValue="{Binding SelectedPaymentAccountId, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Name"
                              TextSearch.TextPath="Name"
                              Style="{StaticResource ComboBoxStyle}"
                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                              Width="200"
                              Margin="0"
                              VerticalAlignment="Center"
                              Tag="Select Account"/>
                </StackPanel>

                <!-- Right Side - Summary and Actions -->
                <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right">
                    <!-- Summary Card -->
                    <Border Background="White" 
                            BorderBrush="#E1E8ED" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="16,12"
                            Margin="0,0,0,12">
                        
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <!-- Payables Summary -->
                            <TextBlock Grid.Row="0" Grid.Column="0" 
                                       Text="Selected Payables:" 
                                       Style="{StaticResource LabelStyle}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" 
                                       Text="{Binding SelectedPayableCount, StringFormat='({0})'}"
                                       Style="{StaticResource LabelStyle}"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,0,4"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" 
                                       Text="Total Payable Amount:" 
                                       FontSize="13"
                                       Foreground="{StaticResource DangerBrush}"
                                       Margin="0,0,0,8"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="1" 
                                       Text="{Binding TotalSelectedPayableAmount, StringFormat='Rs. {0:N2}'}"
                                       TextAlignment="Right"
                                       HorizontalAlignment="Right"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="{StaticResource DangerBrush}"
                                       Margin="0,0,0,8"/>

                            <!-- Credits Summary -->
                            <TextBlock Grid.Row="2" Grid.Column="0" 
                                       Text="Applied Credits:" 
                                       FontSize="13"
                                       Foreground="{StaticResource SuccessBrush}"
                                       Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" 
                                       Text="{Binding TotalSelectedCreditAmount, StringFormat='-Rs. {0:N2}'}"
                                       TextAlignment="Right"
                                       HorizontalAlignment="Right"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="{StaticResource SuccessBrush}"
                                       Margin="0,0,0,8"/>
                        </Grid>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Clear Selection"
                                Command="{Binding ClearSelectionCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,10,0"/>

                        <Button Content="Process Settlement"
                                Command="{Binding SavePaymentCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="150"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

</UserControl>
