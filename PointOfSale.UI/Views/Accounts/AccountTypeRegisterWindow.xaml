<Window x:Class="PointOfSale.UI.Views.Accounts.AccountTypeRegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:PointOfSale.UI.ViewModels.Accounts"
        mc:Ignorable="d"
        Title="Account Type Register"
        Height="440"
        Width="720"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="285"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource PanelCardStyle}" Margin="0 0 8 0">
            <StackPanel>
                <TextBlock Text="Account Type Form" Style="{StaticResource SubHeaderTextStyle}"/>

                <TextBlock Text="Type Code" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="TypeCodeTextBox"
                         Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource TextBoxStyle}"
                         MaxLength="1"
                         PreviewKeyDown="MoveFocusOnEnter"
                         Validation.ErrorTemplate="{StaticResource ErrorTemplate}"/>

                <TextBlock Text="Type Name" Style="{StaticResource LabelStyle}"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource TextBoxStyle}"
                         CharacterCasing="Upper"
                         PreviewKeyDown="MoveFocusOnEnter"
                         Validation.ErrorTemplate="{StaticResource ErrorTemplate}"/>

                <TextBlock Text="Normal Balance" Style="{StaticResource LabelStyle}"/>
                <ComboBox SelectedValue="{Binding NormalBalance, UpdateSourceTrigger=PropertyChanged}"
                          SelectedValuePath="Tag"
                          Style="{StaticResource ComboBoxStyle}"
                          PreviewKeyDown="MoveFocusOnEnter"
                          Validation.ErrorTemplate="{StaticResource ErrorTemplate}">
                    <ComboBoxItem Content="DEBIT" Tag="D"/>
                    <ComboBoxItem Content="CREDIT" Tag="C"/>
                </ComboBox>

                <CheckBox Content="Is Active" IsChecked="{Binding IsActive}" Margin="0,10,0,0"
                          PreviewKeyDown="MoveFocusOnEnter"/>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Center">
                    <Button Content="{Binding SaveButtonText}" 
                            Command="{Binding SaveCommand}" 
                            Style="{StaticResource PrimaryButtonStyle}" 
                            Click="SaveButton_Click"
                            Margin="0,0,8,0"/>
                    <Button Content="Clear" Command="{Binding ClearCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="#F1F2F6" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                   Text="Account Type List" 
                                   Style="{StaticResource SubHeaderTextStyle}" 
                                   VerticalAlignment="Center"
                                   Margin="0"/>

                        <Button Grid.Column="1"
                                Command="{Binding LoadCommand}" 
                                Style="{StaticResource RefreshButtonStyle}" 
                                ToolTip="Refresh Customer List"
                                Margin="10,0,0,0" />

                    </Grid>
                </Border>

                <DataGrid Grid.Row="1"
                          Margin="0,4,0,0"
                          ItemsSource="{Binding AccountTypes}"
                          SelectedItem="{Binding SelectedAccountType}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Style="{StaticResource DataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn     Header="Code"     Binding="{Binding Code}"          Width="80"/>
                        <DataGridTextColumn     Header="Name"     Binding="{Binding Name}"          Width="*"/>
                        <DataGridTextColumn     Header="N/B"      Binding="{Binding NormalBalance}"  Width="60"/>
                        <DataGridCheckBoxColumn Header="Active"   Binding="{Binding IsActive}"      Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>
