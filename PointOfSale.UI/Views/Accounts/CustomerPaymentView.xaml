<UserControl x:Class="PointOfSale.UI.Views.Accounts.CustomerPaymentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PointOfSale.UI.Views.Accounts"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid Margin="0,4,0,0">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main Content -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Filter Panel -->
            <Border Grid.Row="0" Style="{StaticResource PanelCardStyle}" Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox ItemsSource="{Binding Customers}"
                              SelectedItem="{Binding SelectedCustomer, UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="CustomerName"
                              Style="{StaticResource ComboBoxStyle}"
                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                              Tag="Select Customer"
                              VerticalAlignment="Center" Margin="0 0 12 0"/>

                    <!-- Load Button -->
                    <Button Grid.Column="1"
                            Content="Load Receivable"
                            Command="{Binding LoadReceivableCommand}"
                            Style="{StaticResource SearchButtonStyle}"
                            VerticalAlignment="Center"
                            Margin="0"/>

                    <Button Grid.Column="3"
                            Command="{Binding LoadReceivableCommand}" 
                            Style="{StaticResource RefreshButtonStyle}" 
                            ToolTip="Refresh Receivables List"/>
                </Grid>
            </Border>

            <!-- Data Grid Panel -->
            <Border Grid.Row="1" Style="{StaticResource PanelCardStyle}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Data Grid -->
                    <DataGrid Grid.Row="0" 
                              ItemsSource="{Binding ReceivableItems}" 
                              Style="{StaticResource DataGridStyle}"
                              AutoGenerateColumns="False"
                              SelectionMode="Extended"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <!-- Selection Column -->
                            <DataGridCheckBoxColumn Header="Select" 
                                    Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                    Width="100"/>

                            <DataGridTextColumn Header="Invoice #" 
                                    Binding="{Binding InvoiceNumber}" 
                                    Width="150" 
                                    IsReadOnly="True"/>

                            <DataGridTextColumn Header="Invoice Date" 
                                    Binding="{Binding TransactionDate, StringFormat='{}{0:dd/MM/yyyy}'}" 
                                    Width="120" 
                                    IsReadOnly="True"/>

                            <DataGridTextColumn Header="Due Date" 
                                    Binding="{Binding DueDate, StringFormat='{}{0:dd/MM/yyyy}'}" 
                                    Width="120" 
                                    IsReadOnly="True"/>

                            <DataGridTextColumn Header="Initial Amount" 
                                    Binding="{Binding InitialAmount, StringFormat='Rs. {0:N2}'}" 
                                    Width="120" 
                                    ElementStyle="{StaticResource RightAlignedTextStyle}"
                                    IsReadOnly="True" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}"/>

                            <DataGridTextColumn Header="Settled Amount" 
                                    Binding="{Binding AmountSettled, StringFormat='Rs. {0:N2}'}" 
                                    Width="120" 
                                    ElementStyle="{StaticResource RightAlignedTextStyle}"
                                    IsReadOnly="True" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}"/>

                            <DataGridTextColumn Header="Amount Due" 
                                    Binding="{Binding BalanceAmount, StringFormat='Rs. {0:N2}'}" 
                                    Width="120" 
                                    ElementStyle="{StaticResource RightAlignedTextStyle}"
                                    IsReadOnly="True" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}"/>

                            <DataGridTextColumn Header="Status" 
                                    Binding="{Binding Status}"
                                    Width="*"
                                    IsReadOnly="True"/>

                            <!-- Editable Payment Amount -->
                            <DataGridTemplateColumn Header="Payment Amount" Width="150" HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N2}'}" 
                                                 IsEnabled="{Binding IsSelected}"
                                                 HorizontalContentAlignment="Right"
                                                 PreviewTextInput="PaymentAmount_PreviewTextInput"
                                                 PreviewKeyDown="PaymentAmount_PreviewKeyDown" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Payment Details Panel -->
            <Border Grid.Row="2" Style="{StaticResource PanelCardStyle}" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <Grid >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0 0 0 12">
                            <!-- Payment Date -->
                            <TextBlock Text="Payment Date:" 
           Style="{StaticResource LabelStyle}" 
           VerticalAlignment="Center"
           Margin="0,0,12,0"/>

                            <DatePicker SelectedDate="{Binding PaymentDate, UpdateSourceTrigger=PropertyChanged}"
            Style="{StaticResource DatePickerStyle}"
            Width="150"
            VerticalAlignment="Center"
            Margin="0,0,24,0"/>

                            <!-- Payment Method -->
                            <TextBlock Text="Payment Method:" 
           Style="{StaticResource LabelStyle}" 
           VerticalAlignment="Center"
           Margin="0,0,12,0"/>

                            <ComboBox ItemsSource="{Binding AvailablePaymentMethods}"
          SelectedItem="{Binding SelectedPaymentMethod, UpdateSourceTrigger=PropertyChanged}"
          Style="{StaticResource ComboBoxStyle}"
          ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
          Width="150"
          VerticalAlignment="Center"
          Tag="Select Method"
                                      Margin="0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Bank name -->
                            <TextBlock Text="Bank:"
  Visibility="{Binding IsBankVisible}"
  VerticalAlignment="Center"
  Margin="0 0 12 0"
  Style="{StaticResource LabelStyle}"/>

                            <ComboBox ItemsSource="{Binding AvailableBanks}"
 SelectedItem="{Binding BankName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, ValidatesOnNotifyDataErrors=True}"
 Visibility="{Binding IsBankVisible}"
 IsEditable="True"
 Width="150"
 Margin="0,0,24,0"
 IsTextSearchEnabled="True"
 Style="{StaticResource ComboBoxStyle}"
 ItemContainerStyle="{StaticResource ComboBoxItemStyle}"/>

                            <!-- Account Number -->
                            <TextBlock Text="Account Number:"
  Visibility="{Binding IsAccountNumberVisible}"
  Style="{StaticResource LabelStyle}"
  Margin="0 0 12 0"
  VerticalAlignment="Center"/>

                            <TextBox Text="{Binding AccountNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
Visibility="{Binding IsAccountNumberVisible}"
MaxLength="20"
Width="200"
Margin="0,0,24,0"
Style="{StaticResource TextBoxStyle}" />

                            <!-- Account Name -->
                            <TextBlock Text="Account Name:"
  Visibility="{Binding IsAccountNameVisible}"
  Style="{StaticResource LabelStyle}"
  Margin="0 0 12 0"
  VerticalAlignment="Center"/>

                            <TextBox Text="{Binding AccountName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
Visibility="{Binding IsAccountNameVisible}"
MaxLength="50"
Width="250"
Margin="0,0,24,0"
Style="{StaticResource TextBoxStyle}"/>
                        </StackPanel>
                    </Grid>
                    <!-- Left Side - Payment Info -->



                    <!-- Right Side - Summary and Actions -->
                    <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right">
                        <!-- Total Summary -->
                        <Border Background="White" 
                                BorderBrush="#E1E8ED" 
                                BorderThickness="1" 
                                CornerRadius="6" 
                                Padding="12,8"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" 
                                           Text="Selected Items:" 
                                           Style="{StaticResource LabelStyle}"
                                           Margin="0,0,16,4"/>

                                <TextBlock Grid.Row="0" Grid.Column="1" 
                                           Text="{Binding SelectedItemCount, StringFormat='({0} selected)'}"
                                           Style="{StaticResource SubHeaderTextStyle}"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" 
                                           Text="Total Payment:" 
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="{StaticResource Brush.Text.Primary}"
                                           Margin="0,4,16,0"/>

                                <TextBlock Grid.Row="1" Grid.Column="1" 
                                           Text="{Binding TotalSelectedReceivableAmount, StringFormat='Rs. {0:N2}'}"
                                           TextAlignment="Right"
                                           HorizontalAlignment="Right"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Foreground="{StaticResource SuccessBrush}"
                                           Margin="0,4,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Clear Selection"
                                    Command="{Binding ClearSelectionCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="12,8"
                                    Margin="0,0,10,0"/>

                            <Button Content="Save Payments"
                                    Command="{Binding SavePaymentCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="12,8"/>

                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
