<UserControl x:Class="PointOfSale.UI.Views.Accounts.FundTransferView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PointOfSale.UI.Views.Accounts"
             xmlns:accounts="clr-namespace:PointOfSale.UI.ViewModels.Accounts"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Fund Transfer" Style="{StaticResource HeaderTextStyle}"/>

        <Grid Grid.Row="1" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="285"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Form -->
            <Border Style="{StaticResource PanelCardStyle}" Margin="0 0 8 0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="Fund Transfer Form" Style="{StaticResource SubHeaderTextStyle}" Margin="0,0,0,12"/>

                        <!-- Transfer Date -->
                        <TextBlock Text="Transfer Date"
                                    Style="{StaticResource LabelStyle}"/>
                        <DatePicker SelectedDate="{Binding TransferDate, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                    Style="{StaticResource DatePickerStyle}"
                                    Margin="0,0,0,8"
                                    Validation.ErrorTemplate="{StaticResource ErrorTemplate}"
                                    PreviewKeyDown="MoveFocusOnEnter"/>

                        <!-- Source Account -->
                        <TextBlock Text="Source Account (From)" Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="SourceAccountCombo"
                                  ItemsSource="{Binding TransferAccounts}"
                                  SelectedItem="{Binding SelectedSourceAccount, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                  DisplayMemberPath="DisplayText"
                                  IsTextSearchEnabled="True"
                                  TextSearch.TextPath="DisplayText"
                                  Style="{StaticResource ComboBoxStyle}"
                                  ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                  Validation.ErrorTemplate="{StaticResource ErrorTemplate}"
                                  PreviewKeyDown="MoveFocusOnEnter"
                                  Margin="0,0,0,8"/>

                        <!-- Destination Account -->
                        <TextBlock Text="Destination Account (To)" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding TransferAccounts}"
                                  SelectedItem="{Binding SelectedDestinationAccount, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                  DisplayMemberPath="DisplayText"
                                  IsTextSearchEnabled="True"
                                  TextSearch.TextPath="DisplayText"
                                  Style="{StaticResource ComboBoxStyle}"
                                  ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                  Validation.ErrorTemplate="{StaticResource ErrorTemplate}"
                                  PreviewKeyDown="MoveFocusOnEnter"
                                  Margin="0,0,0,8"/>

                        <!-- Amount -->
                        <TextBlock Text="Amount" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Amount, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True, StringFormat={}{0:N2}}"
                                 Style="{StaticResource TextBoxStyle}"
                                 TextAlignment="Right"
                                 PreviewKeyDown="MoveFocusOnEnter"
                                 PreviewTextInput="AmountTextBox_PreviewTextInput"
                                 DataObject.Pasting="AmountTextBox_Pasting"
                                 GotKeyboardFocus="SelectAllText_GotFocus"
                                 MaxLength="50"/>

                        <!-- Reference No -->
                        <TextBlock Text="Reference No (Deposit Slip)" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding ReferenceNo, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 Style="{StaticResource TextBoxStyle}"
                                 PreviewKeyDown="MoveFocusOnEnter"
                                 MaxLength="100"
                                 Margin="0,0,0,8"/>

                        <!-- Description -->
                        <TextBlock Text="Description" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 Grid.Column="1"
                                 Style="{StaticResource TextBoxStyle}"
                                 PreviewKeyDown="MoveFocusOnEnter"
                                 PreviewTextInput="DescriptionTextBox_PreviewTextInput"
                                 DataObject.Pasting="DescriptionTextBox_Pasting"
                                 Margin="0"/>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,24,0,0" HorizontalAlignment="Left">
                            <Button Content="Save"
                                    Command="{Binding SaveTransferCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Name="SaveButton"
                                    Margin="0,0,8,0"
                                    Click="SaveButton_Click"/>

                            <Button Content="Reset"
                                    Command="{Binding NewTransferCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,0,0"/>

                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right Panel - Data Grid -->
            <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F1F2F6" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Margin="0"
                                    Text="Fund Transfer List"
                                    Style="{StaticResource SubHeaderTextStyle}"
                                    VerticalAlignment="Center"/>

                            <Button Grid.Column="1"
                                    Command="{Binding LoadTransfersCommand}"
                                    Style="{StaticResource RefreshButtonStyle}"
                                    ToolTip="Refresh Fund Transfer List"
                                    Margin="10,0,0,0"/>

                            <TextBlock Grid.Column="3"
                                       Text="From Date"
                                       Style="{StaticResource LabelStyle}"
                                       VerticalAlignment="Center"
                                       Margin="16,0,6,0"/>

                            <DatePicker Grid.Column="4"
                                        SelectedDate="{Binding FromDate, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource DatePickerStyle}"
                                        Width="130"
                                        Margin="0,0,8,0"/>

                            <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="To Date"
                                           Style="{StaticResource LabelStyle}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <DatePicker SelectedDate="{Binding ToDate, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource DatePickerStyle}"
                                            Width="130"
                                            Margin="0,0,8,0"/>
                                <Button Content="Search"
                                        Command="{Binding SearchTransfersCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Data Grid -->
                    <DataGrid Grid.Row="1"
                          x:Name="FundTransferDataGrid"
                          ItemsSource="{Binding TransferList}"
                          SelectedItem="{Binding SelectedTransfer, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource DataGridStyle}"
                          Margin="0,4,0,0"
                          AutoGenerateColumns="False"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          IsReadOnly="True">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Transfer No" Binding="{Binding TransferNumber}" Width="130"/>
                            <DataGridTextColumn Header="Transfer Date" Binding="{Binding TransferDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="120" />
                            <DataGridTextColumn Header="Source Account" Binding="{Binding SourceAccountName}" Width="*" />
                            <DataGridTextColumn Header="Destination Account" Binding="{Binding DestinationAccountName}" Width="*" />
                            <DataGridTextColumn Header="Reference No" Binding="{Binding ReferenceNo}" Width="140" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />

                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='Rs. {0:N2}'}" Width="150"  HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Action" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.PrintTransferCommand, ElementName=FundTransferDataGrid}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DataGridPrintButtonStyle}"
                                                ToolTip="Print fund transfer voucher"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
