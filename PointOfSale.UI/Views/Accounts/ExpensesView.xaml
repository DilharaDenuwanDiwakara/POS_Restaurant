<UserControl x:Class="PointOfSale.UI.Views.Accounts.ExpensesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PointOfSale.UI.Views.Accounts" 
             xmlns:accounts="clr-namespace:PointOfSale.UI.ViewModels.Accounts" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Expenses" Style="{StaticResource HeaderTextStyle}"/>

        <Grid Grid.Row="1" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="285"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Form -->
            <Border Style="{StaticResource PanelCardStyle}" Margin="0 0 8 0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="Expenses Form" Style="{StaticResource SubHeaderTextStyle}" Margin="0,0,0,12"/>

                        <!-- Expenses Date -->
                        <TextBlock Text="Expenses Date" 
                                    Style="{StaticResource LabelStyle}"/>
                        <DatePicker SelectedDate="{Binding ExpensesDate, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                    Style="{StaticResource DatePickerStyle}"
                                    Margin="0,0,0,8"
                                    Validation.ErrorTemplate="{StaticResource ErrorTemplate}"
                                    PreviewKeyDown="MoveFocusOnEnter"/>

                        <!-- Expenses Selection -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="35"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Expenses Type" Style="{StaticResource LabelStyle}"/>
                            <ComboBox Grid.Row="1"
                                      x:Name="ExpensesType"
                                      ItemsSource="{Binding ExpensesCategories}"
                                      SelectedItem="{Binding SelectedExeCategory, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                      DisplayMemberPath="ExpensesCategoryName"
                                      IsTextSearchEnabled="True"
                                      TextSearch.TextPath="ExpensesCategoryName"
                                      Style="{StaticResource ComboBoxStyle}"
                                      ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                      PreviewKeyDown="MoveFocusOnEnter"
                                      Margin="0,0,0,8"/>

                            <Button Grid.Column="1" Grid.Row="1"
                                    Command="{Binding OpenAddExpensesCategoryCommand}"
                                    ToolTip="Add New Category"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Top"
                                    Focusable="False"
                                    Style="{StaticResource AddButtonStyle}"/>

                        </Grid>

                        <!-- Paid From -->
                        <TextBlock Text="Paid From" Style="{StaticResource LabelStyle}"/>
                        <ComboBox ItemsSource="{Binding PaymentAccounts}"
                                  SelectedItem="{Binding SelectedPaymentAccount, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="DisplayText"
                                  Style="{StaticResource ComboBoxStyle}"
                                  ItemContainerStyle="{StaticResource ComboBoxItemStyle}"
                                  PreviewKeyDown="MoveFocusOnEnter"
                                  Margin="0,0,0,8"/>

                        <!-- Amount -->
                        <TextBlock Text="Amount" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Amount, UpdateSourceTrigger=LostFocus, ValidatesOnNotifyDataErrors=True, StringFormat={}{0:N2}}"
                                 Style="{StaticResource TextBoxStyle}"
                                 TextAlignment="Right"
                                 PreviewKeyDown="MoveFocusOnEnter"
                                 PreviewTextInput="AmountTextBox_PreviewTextInput"
                                 DataObject.Pasting="AmountTextBox_Pasting"
                                 GotKeyboardFocus="SelectAllText_GotFocus"
                                 MaxLength="50"/>

                        <!-- Description -->
                        <TextBlock Text="Description" Style="{StaticResource LabelStyle}"/>
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 Grid.Column="1"
                                 Style="{StaticResource TextBoxStyle}"
                                 PreviewKeyDown="MoveFocusOnEnter"
                                 PreviewTextInput="DescriptionTextBox_PreviewTextInput"
                                 DataObject.Pasting="DescriptionTextBox_Pasting"
                                 Margin="0"/>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,24,0,0" HorizontalAlignment="Left">
                            <Button Content="Save"
                                    Command="{Binding SaveExpenseCommand}" 
                                    Style="{StaticResource PrimaryButtonStyle}" 
                                    Name="SaveButton"
                                    Margin="0,0,8,0"
                                    Click="SaveButton_Click"/>

                            <Button Content="Reset" 
                                    Command="{Binding NewExpenseCommand}" 
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,0,0"/>

                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right Panel - Data Grid -->
            <Border Grid.Column="1" Style="{StaticResource PanelCardStyle}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F1F2F6" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Margin="0"
                                    Text="Expenses List" 
                                    Style="{StaticResource SubHeaderTextStyle}" 
                                    VerticalAlignment="Center"/>

                            <Button Grid.Column="1"
                                    Command="{Binding LoadExpensesCommand}" 
                                    Style="{StaticResource RefreshButtonStyle}" 
                                    ToolTip="Refresh Expenses List"
                                    Margin="10,0,0,0"/>

                            <TextBlock Grid.Column="3"
                                       Text="From Date"
                                       Style="{StaticResource LabelStyle}"
                                       VerticalAlignment="Center"
                                       Margin="16,0,6,0"/>

                            <DatePicker Grid.Column="4"
                                        SelectedDate="{Binding FromDate, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource DatePickerStyle}"
                                        Width="130"
                                        Margin="0,0,8,0"/>

                            <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="To Date"
                                           Style="{StaticResource LabelStyle}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <DatePicker SelectedDate="{Binding ToDate, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource DatePickerStyle}"
                                            Width="130"
                                            Margin="0,0,8,0"/>
                                <Button Content="Search"
                                        Command="{Binding SearchExpensesCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"/>
                            </StackPanel>

                            <Button Grid.Column="6" Visibility="Hidden"
                                    Command="{Binding CancelAdvanceCommand}" 
                                    Style="{StaticResource DeleteButtonStyle}" 
                                    ToolTip="Delete Supplier"/>

                        </Grid>
                    </Border>

                    <!-- Data Grid -->
                    <DataGrid Grid.Row="1"
                          x:Name="ExpensesDataGrid"
                          ItemsSource="{Binding ExpensesList}"
                          SelectedItem="{Binding SelectedExpense, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource DataGridStyle}"
                          Margin="0,4,0,0"
                          AutoGenerateColumns="False"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          IsReadOnly="True">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Voucher No" Binding="{Binding VoucherNumber}" Width="130"/>
                            <DataGridTextColumn Header="ID" Binding="{Binding ExpensesId}" Width="60" Visibility="Hidden"/>
                            <DataGridTextColumn Header="Expenses Date" Binding="{Binding ExpensesDate, StringFormat='{}{0:dd/MM/yyyy}'}" Width="150" />
                            <DataGridTextColumn Header="Expenses CategoryId" Binding="{Binding ExpensesCategoryId}" Width="*" Visibility="Hidden" />
                            <DataGridTextColumn Header="Expenses Type" Binding="{Binding ExpensesCategoryName, Mode=TwoWay}" Width="220" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                            
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='Rs. {0:N2}'}" Width="150"  HeaderStyle="{StaticResource RightAlignedDataGridColumnHeaderStyle}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Action" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.PrintExpenseCommand, ElementName=ExpensesDataGrid}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DataGridPrintButtonStyle}"
                                                ToolTip="Print expense voucher"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
